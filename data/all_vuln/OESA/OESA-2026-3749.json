{"schema_version":"1.9.0","id":"OESA-2026-3749","published":"2026-09-14T16:33:58Z","modified":"2026-09-13T16:45:31.328702338Z","upstream":["CVE-2026-73282","CVE-2026-73283"],"summary":"openssh security update","details":"An open source implementation of SSH protocol version 2\r\n\r\nSecurity Fix(es):\n\nIn ssh in OpenSSH before 10.5, a use-after-free for realloc data can occur if a certain pair of remote-forwarding operations are concurrent.(CVE-2026-73282)\n\nIn sshd in OpenSSH before 10.5, the restrict keyword (in authorized_keys) was supposed to be applicable to tunnel forwarding but was not.(CVE-2026-73283)","affected":[{"package":{"name":"openssh","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/openssh&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"8.8p1-51.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["openssh-8.8p1-51.oe2203sp4.aarch64.rpm","openssh-askpass-8.8p1-51.oe2203sp4.aarch64.rpm","openssh-clients-8.8p1-51.oe2203sp4.aarch64.rpm","openssh-debuginfo-8.8p1-51.oe2203sp4.aarch64.rpm","openssh-debugsource-8.8p1-51.oe2203sp4.aarch64.rpm","openssh-keycat-8.8p1-51.oe2203sp4.aarch64.rpm","openssh-server-8.8p1-51.oe2203sp4.aarch64.rpm","pam_ssh_agent_auth-0.10.4-4.51.oe2203sp4.aarch64.rpm"],"noarch":["openssh-help-8.8p1-51.oe2203sp4.noarch.rpm"],"src":["openssh-8.8p1-51.oe2203sp4.src.rpm"],"x86_64":["openssh-8.8p1-51.oe2203sp4.x86_64.rpm","openssh-askpass-8.8p1-51.oe2203sp4.x86_64.rpm","openssh-clients-8.8p1-51.oe2203sp4.x86_64.rpm","openssh-debuginfo-8.8p1-51.oe2203sp4.x86_64.rpm","openssh-debugsource-8.8p1-51.oe2203sp4.x86_64.rpm","openssh-keycat-8.8p1-51.oe2203sp4.x86_64.rpm","openssh-server-8.8p1-51.oe2203sp4.x86_64.rpm","pam_ssh_agent_auth-0.10.4-4.51.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3749.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEu