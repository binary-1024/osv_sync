{"schema_version":"1.9.0","id":"OESA-2026-3959","published":"2026-09-20T13:23:35Z","modified":"2026-09-20T13:30:30.302485913Z","upstream":["CVE-2026-72522"],"summary":"xmlrpc-c security update","details":"XML-RPC is a quick-and-easy way to make procedure calls  over the Internet. It converts the procedure call into  an XML document, sends it to a remote server using HTTP,  and gets back the response as XML.\r\n\r\nSecurity Fix(es):\n\nlibexpat before 2.8.3 has an out-of-bounds read and resultant infinite loop because low surrogates are treated the same as high surrogates during Unicode processing in the *_toUtf16 functions.(CVE-2026-72522)","affected":[{"package":{"name":"xmlrpc-c","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/xmlrpc-c&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.51.08-5.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["xmlrpc-c-1.51.08-5.oe2203sp4.aarch64.rpm","xmlrpc-c-debuginfo-1.51.08-5.oe2203sp4.aarch64.rpm","xmlrpc-c-debugsource-1.51.08-5.oe2203sp4.aarch64.rpm","xmlrpc-c-devel-1.51.08-5.oe2203sp4.aarch64.rpm"],"noarch":["xmlrpc-c-help-1.51.08-5.oe2203sp4.noarch.rpm"],"src":["xmlrpc-c-1.51.08-5.oe2203sp4.src.rpm"],"x86_64":["xmlrpc-c-1.51.08-5.oe2203sp4.x86_64.rpm","xmlrpc-c-debuginfo-1.51.08-5.oe2203sp4.x86_64.rpm","xmlrpc-c-debugsource-1.51.08-5.oe2203sp4.x86_64.rpm","xmlrpc-c-devel-1.51.08-5.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3959.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3959"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-72522"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"}]}