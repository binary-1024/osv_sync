{"schema_version":"1.9.2","id":"OESA-2026-4896","published":"2026-11-19T01:42:48Z","modified":"2026-11-19T02:00:05.431464373Z","upstream":["CVE-2026-48841"],"summary":"uriparser security update","details":"The package is a strictly RFC 3986 compliant URI parsing library written in C89(&amp;quot;ANSI C&amp;quot;). uriparser is cross-platform, fast, supports Unicode and is licensed under the New BSD license. There are a number of applications, libraries and hardware using uriparser, as well as bindings and 3rd-party wrappers. uriparser is packaged in major distributions.\r\n\r\nSecurity Fix(es):\n\nThe iVEC-IEI Virtualization Edge Computer allows authenticated remote attackers to delete arbitrary system files or directories. This can lead to data destruction or service disruption.(CVE-2026-48841)","affected":[{"package":{"name":"uriparser","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/uriparser&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.0.1-3.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["uriparser-1.0.1-3.oe2403sp1.aarch64.rpm","uriparser-debuginfo-1.0.1-3.oe2403sp1.aarch64.rpm","uriparser-debugsource-1.0.1-3.oe2403sp1.aarch64.rpm","uriparser-devel-1.0.1-3.oe2403sp1.aarch64.rpm"],"noarch":["uriparser-help-1.0.1-3.oe2403sp1.noarch.rpm"],"src":["uriparser-1.0.1-3.oe2403sp1.src.rpm"],"x86_64":["uriparser-1.0.1-3.oe2403sp1.x86_64.rpm","uriparser-debuginfo-1.0.1-3.oe2403sp1.x86_64.rpm","uriparser-debugsource-1.0.1-3.oe2403sp1.x86_64.rpm","uriparser-devel-1.0.1-3.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4896.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4896"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-48841"}],"database_specific":{"severity":"Critical"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR