{"schema_version":"1.9.2","id":"OESA-2026-4949","published":"2026-11-19T01:43:23Z","modified":"2026-11-19T02:00:18.752276904Z","upstream":["CVE-2026-104786"],"summary":"squid security update","details":"Squid is a high-performance proxy caching server. It handles all requests in a single, non-blocking, I/O-driven process and keeps meta data and implements negative caching of failed requests.\r\n\r\nSecurity Fix(es):\n\nDue to an Improper Input Validation (CWE-20) bug, Squid is vulnerable to a Stack-based Buffer Overflow (CWE-121) attack against HTTP Authentication.(CVE-2026-104786)","affected":[{"package":{"name":"squid","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/squid&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"6.6-11.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["squid-6.6-11.oe2403sp3.aarch64.rpm","squid-debuginfo-6.6-11.oe2403sp3.aarch64.rpm","squid-debugsource-6.6-11.oe2403sp3.aarch64.rpm"],"src":["squid-6.6-11.oe2403sp3.src.rpm"],"x86_64":["squid-6.6-11.oe2403sp3.x86_64.rpm","squid-debuginfo-6.6-11.oe2403sp3.x86_64.rpm","squid-debugsource-6.6-11.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4949.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4949"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-104786"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:L"}]}