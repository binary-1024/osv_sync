{"schema_version":"1.9.0","id":"OESA-2021-1242","published":"2021-06-26T11:04:29Z","modified":"2026-08-18T01:15:44.532445647Z","upstream":["CVE-2021-3549"],"summary":"binutils security update","details":"The GNU Binutils are a collection of binary tools.\r\n\r\nSecurity Fix(es):\r\n\r\nAn out of bounds flaw was found in GNU binutils objdump utility version 2.36. An attacker could use this flaw and pass a large section to avr_elf32_load_records_from_section() probably resulting in a crash or in some cases memory corruption. The highest threat from this vulnerability is to integrity as well as system availability.(CVE-2021-3549)","affected":[{"package":{"name":"binutils","ecosystem":"openEuler:20.03-LTS-SP1","purl":"pkg:rpm/openEuler/binutils&distro=openEuler-20.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.34-11.oe1"}]}],"ecosystem_specific":{"aarch64":["binutils-2.34-11.oe1.aarch64.rpm","binutils-debugsource-2.34-11.oe1.aarch64.rpm","binutils-help-2.34-11.oe1.aarch64.rpm","binutils-devel-2.34-11.oe1.aarch64.rpm","binutils-debuginfo-2.34-11.oe1.aarch64.rpm"],"src":["binutils-2.34-11.oe1.src.rpm"],"x86_64":["binutils-help-2.34-11.oe1.x86_64.rpm","binutils-2.34-11.oe1.x86_64.rpm","binutils-debuginfo-2.34-11.oe1.x86_64.rpm","binutils-debugsource-2.34-11.oe1.x86_64.rpm","binutils-devel-2.34-11.oe1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2021-1242.json"}}],"references":[{"type":"ADVISORY","url":"https://openeuler.org/en/security/safety-bulletin/detail.html?id=openEuler-SA-2021-1242"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2021-3549"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:H/A:H"}]}