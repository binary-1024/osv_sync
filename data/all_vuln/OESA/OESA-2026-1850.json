{"schema_version":"1.9.0","id":"OESA-2026-1850","published":"2026-04-11T11:10:52Z","modified":"2026-08-18T01:19:46.876710702Z","upstream":["CVE-2026-27142"],"summary":"golang security update","details":".\r\n\r\nSecurity Fix(es):\n\nActions which insert URLs into the content attribute of HTML meta tags are not escaped. This can allow XSS if the meta tag also has an http-equiv attribute with the value &quot;refresh&quot;. A new GODEBUG setting has been added, htmlmetacontenturlescape, which can be used to disable escaping URLs in actions in the meta content attribute which follow &quot;url=&quot; by setting htmlmetacontenturlescape=0.(CVE-2026-27142)","affected":[{"package":{"name":"golang","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/golang&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.21.4-44.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["golang-1.21.4-44.oe2403sp1.aarch64.rpm"],"noarch":["golang-devel-1.21.4-44.oe2403sp1.noarch.rpm","golang-help-1.21.4-44.oe2403sp1.noarch.rpm"],"src":["golang-1.21.4-44.oe2403sp1.src.rpm"],"x86_64":["golang-1.21.4-44.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1850.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1850"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-27142"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N"}]}