{"schema_version":"1.9.2","id":"OESA-2026-4846","published":"2026-11-11T12:26:47Z","modified":"2026-11-11T12:45:09.209140823Z","upstream":["CVE-2026-113351"],"summary":"expat security update","details":"expat is a stream-oriented XML parser library written in C. expat excels with files too large to fit RAM, and where performance and flexibility are crucial.\r\n\r\nSecurity Fix(es):\n\nlibexpat 2.7.2 through 2.9.0 contains a denial of service vulnerability because XML_ParserReset zeroes the direct byte count but never offsets tracked heap allocations. Attackers can submit a large XML document so later documents on the same reset parser fail with XML_ERROR_NO_MEMORY until it is recreated.(CVE-2026-113351)","affected":[{"package":{"name":"expat","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/expat&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.8.1-11.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["expat-2.8.1-11.oe2403sp4.aarch64.rpm","expat-debuginfo-2.8.1-11.oe2403sp4.aarch64.rpm","expat-debugsource-2.8.1-11.oe2403sp4.aarch64.rpm","expat-devel-2.8.1-11.oe2403sp4.aarch64.rpm"],"noarch":["expat-help-2.8.1-11.oe2403sp4.noarch.rpm"],"src":["expat-2.8.1-11.oe2403sp4.src.rpm"],"x86_64":["expat-2.8.1-11.oe2403sp4.x86_64.rpm","expat-debuginfo-2.8.1-11.oe2403sp4.x86_64.rpm","expat-debugsource-2.8.1-11.oe2403sp4.x86_64.rpm","expat-devel-2.8.1-11.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4846.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4846"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-113351"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N"}]}