{"schema_version":"1.9.2","id":"OESA-2026-4614","published":"2026-10-29T09:03:36Z","modified":"2026-10-29T09:15:40.776478495Z","upstream":["CVE-2026-95114","CVE-2026-95115"],"summary":"libwebsockets security update","details":"Libwebsockets (LWS) is a flexible, lightweight pure C library for implementing modern network protocols easily with a tiny footprint, using a nonblocking event loop.\r\n\r\nSecurity Fix(es):\n\nlibwebsockets contains an out-of-bounds read vulnerability in the LEJP incremental parser in lib/misc/lejp.c. This allows a remote attacker to cause a denial of service(CVE-2026-95114)\n\nBuffer Overflow vulnerability in libwebsockets main 106d542c allows a remote attacker to cause a denial of service via the LEJP JSON parser(CVE-2026-95115)","affected":[{"package":{"name":"libwebsockets","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/libwebsockets&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.3.3-9.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["libwebsockets-4.3.3-9.oe2403sp4.aarch64.rpm","libwebsockets-debuginfo-4.3.3-9.oe2403sp4.aarch64.rpm","libwebsockets-debugsource-4.3.3-9.oe2403sp4.aarch64.rpm","libwebsockets-devel-4.3.3-9.oe2403sp4.aarch64.rpm"],"noarch":["libwebsockets-help-4.3.3-9.oe2403sp4.noarch.rpm"],"src":["libwebsockets-4.3.3-9.oe2403sp4.src.rpm"],"x86_64":["libwebsockets-4.3.3-9.oe2403sp4.x86_64.rpm","libwebsockets-debuginfo-4.3.3-9.oe2403sp4.x86_64.rpm","libwebsockets-debugsource-4.3.3-9.oe2403sp4.x86_64.rpm","libwebsockets-devel-4.3.3-9.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4614.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4614"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-95114"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-95115"}],"database_specific":{