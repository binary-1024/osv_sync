{"schema_version":"1.9.0","id":"OESA-2021-1188","published":"2021-05-15T11:04:25Z","modified":"2026-08-18T01:15:31.087869733Z","upstream":["CVE-2021-28650"],"summary":"gnome-autoar security update","details":"Automatic archives creating and extracting library.\r\n\r\nSecurity Fix(es):\r\n\r\nautoar-extractor.c in GNOME gnome-autoar before 0.3.1, as used by GNOME Shell, Nautilus, and other software, allows Directory Traversal during extraction because it lacks a check of whether a file&apos;s parent is a symlink in certain complex situations. NOTE: this issue exists because of an incomplete fix for CVE-2020-36241.(CVE-2021-28650)","affected":[{"package":{"name":"gnome-autoar","ecosystem":"openEuler:20.03-LTS-SP1","purl":"pkg:rpm/openEuler/gnome-autoar&distro=openEuler-20.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.2.3-6.oe1"}]}],"ecosystem_specific":{"aarch64":["gnome-autoar-0.2.3-6.oe1.aarch64.rpm","gnome-autoar-debuginfo-0.2.3-6.oe1.aarch64.rpm","gnome-autoar-debugsource-0.2.3-6.oe1.aarch64.rpm","gnome-autoar-devel-0.2.3-6.oe1.aarch64.rpm"],"src":["gnome-autoar-0.2.3-6.oe1.src.rpm"],"x86_64":["gnome-autoar-debuginfo-0.2.3-6.oe1.x86_64.rpm","gnome-autoar-0.2.3-6.oe1.x86_64.rpm","gnome-autoar-devel-0.2.3-6.oe1.x86_64.rpm","gnome-autoar-debugsource-0.2.3-6.oe1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2021-1188.json"}}],"references":[{"type":"ADVISORY","url":"https://openeuler.org/en/security/safety-bulletin/detail.html?id=openEuler-SA-2021-1188"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2021-28650"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N"}]}