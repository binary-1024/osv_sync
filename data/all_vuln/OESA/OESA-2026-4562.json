{"schema_version":"1.9.2","id":"OESA-2026-4562","published":"2026-10-29T09:02:58Z","modified":"2026-10-29T09:15:31.099451876Z","upstream":["CVE-2026-88386"],"summary":"libsndfile security update","details":"Libsndfile is a C library for reading and writing files containing sampled sound such as MS Windows WAV and the Apple/SGI AIFF format through one standard library interface.\r\n\r\nSecurity Fix(es):\n\nlibsndfile 1.2.2 contains a misaligned memory access issue in psf_binheader_readf() while parsing WAV fmt chunks. A specially crafted WAV file can cause the function to cast an unaligned destination address to unsigned int * and perform a 4-byte store. This results in undefined behavior leading to denial of service.(CVE-2026-88386)","affected":[{"package":{"name":"libsndfile","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/libsndfile&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.2.2-7.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["libsndfile-1.2.2-7.oe2403sp3.aarch64.rpm","libsndfile-debuginfo-1.2.2-7.oe2403sp3.aarch64.rpm","libsndfile-debugsource-1.2.2-7.oe2403sp3.aarch64.rpm","libsndfile-devel-1.2.2-7.oe2403sp3.aarch64.rpm","libsndfile-utils-1.2.2-7.oe2403sp3.aarch64.rpm"],"noarch":["libsndfile-utils-help-1.2.2-7.oe2403sp3.noarch.rpm"],"src":["libsndfile-1.2.2-7.oe2403sp3.src.rpm"],"x86_64":["libsndfile-1.2.2-7.oe2403sp3.x86_64.rpm","libsndfile-debuginfo-1.2.2-7.oe2403sp3.x86_64.rpm","libsndfile-debugsource-1.2.2-7.oe2403sp3.x86_64.rpm","libsndfile-devel-1.2.2-7.oe2403sp3.x86_64.rpm","libsndfile-utils-1.2.2-7.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4562.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4562"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-88386"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H"}]}