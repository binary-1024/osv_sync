{"schema_version":"1.9.0","id":"OESA-2026-2899","published":"2026-07-09T11:11:48Z","modified":"2026-08-18T01:21:15.145180645Z","upstream":["CVE-2026-50593"],"summary":"graphite2 security update","details":"Graphite is a system that can be used to create “smart fonts” capable of displaying writing systems with various complex behaviors. A smart font contains not only letter shapes but also additional instructions indicating how to combine and position the letters in complex ways.\r\n\r\nSecurity Fix(es):\n\nGraphite before 1.3.15 has an integer underflow and resultant out-of-bounds write via Graphite actions, because slotat does not ensure that an offset is within the allowed slot-map range.(CVE-2026-50593)","affected":[{"package":{"name":"graphite2","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/graphite2&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.3.14-4.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["graphite2-1.3.14-4.oe2003sp4.aarch64.rpm","graphite2-debuginfo-1.3.14-4.oe2003sp4.aarch64.rpm","graphite2-debugsource-1.3.14-4.oe2003sp4.aarch64.rpm","graphite2-devel-1.3.14-4.oe2003sp4.aarch64.rpm"],"src":["graphite2-1.3.14-4.oe2003sp4.src.rpm"],"x86_64":["graphite2-1.3.14-4.oe2003sp4.x86_64.rpm","graphite2-debuginfo-1.3.14-4.oe2003sp4.x86_64.rpm","graphite2-debugsource-1.3.14-4.oe2003sp4.x86_64.rpm","graphite2-devel-1.3.14-4.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2899.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2899"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-50593"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:L/I:H/A:H"}]}