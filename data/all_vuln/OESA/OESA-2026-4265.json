{"schema_version":"1.9.0","id":"OESA-2026-4265","published":"2026-10-16T11:58:44Z","modified":"2026-10-16T12:15:17.565748133Z","upstream":["CVE-2026-96889"],"summary":"librsvg2 security update","details":"An SVG library based on cairo.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in librsvg. When processing an SVG document containing nested XML inclusions (Xincludes) with duplicate entity declarations, a use-after-free error can occur. This vulnerability arises because the library incorrectly frees an XML entity that is still in use by the parser. An attacker could potentially exploit this to cause a denial of service or execute arbitrary code.(CVE-2026-96889)","affected":[{"package":{"name":"librsvg2","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/librsvg2&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.57.1-7.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["librsvg2-2.57.1-7.oe2403sp4.aarch64.rpm","librsvg2-debuginfo-2.57.1-7.oe2403sp4.aarch64.rpm","librsvg2-debugsource-2.57.1-7.oe2403sp4.aarch64.rpm","librsvg2-devel-2.57.1-7.oe2403sp4.aarch64.rpm","librsvg2-tools-2.57.1-7.oe2403sp4.aarch64.rpm"],"noarch":["librsvg2-help-2.57.1-7.oe2403sp4.noarch.rpm"],"src":["librsvg2-2.57.1-7.oe2403sp4.src.rpm"],"x86_64":["librsvg2-2.57.1-7.oe2403sp4.x86_64.rpm","librsvg2-debuginfo-2.57.1-7.oe2403sp4.x86_64.rpm","librsvg2-debugsource-2.57.1-7.oe2403sp4.x86_64.rpm","librsvg2-devel-2.57.1-7.oe2403sp4.x86_64.rpm","librsvg2-tools-2.57.1-7.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4265.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4265"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-96889"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H"}]}