{"schema_version":"1.9.2","id":"OESA-2026-4891","published":"2026-11-19T01:42:45Z","modified":"2026-11-19T02:00:07.040246064Z","upstream":["CVE-2026-116724"],"summary":"fltk security update","details":"FLTK (pronounced &amp;quot;fulltick&amp;quot;) is a cross-platform C++ GUI toolkit.It provides modern GUI functionality without the bloat, and supports 3D graphics via OpenGL and its built-in GLUT emulation.\r\n\r\nSecurity Fix(es):\n\nFLTK through 1.4.5 contains an integer overflow vulnerability in Fl_BMP_Image::load_bmp_() that causes undersized pixel buffer allocation from file-supplied width and height. Attackers can supply a crafted BMP or ICO file with large dimensions so row decoding writes file-derived data past the heap buffer, corrupting the application heap.(CVE-2026-116724)","affected":[{"package":{"name":"fltk","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/fltk&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.3.9-3.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["fltk-1.3.9-3.oe2403sp1.aarch64.rpm","fltk-debuginfo-1.3.9-3.oe2403sp1.aarch64.rpm","fltk-debugsource-1.3.9-3.oe2403sp1.aarch64.rpm","fltk-devel-1.3.9-3.oe2403sp1.aarch64.rpm","fltk-fluid-1.3.9-3.oe2403sp1.aarch64.rpm","fltk-static-1.3.9-3.oe2403sp1.aarch64.rpm"],"noarch":["fltk-help-1.3.9-3.oe2403sp1.noarch.rpm"],"src":["fltk-1.3.9-3.oe2403sp1.src.rpm"],"x86_64":["fltk-1.3.9-3.oe2403sp1.x86_64.rpm","fltk-debuginfo-1.3.9-3.oe2403sp1.x86_64.rpm","fltk-debugsource-1.3.9-3.oe2403sp1.x86_64.rpm","fltk-devel-1.3.9-3.oe2403sp1.x86_64.rpm","fltk-fluid-1.3.9-3.oe2403sp1.x86_64.rpm","fltk-static-1.3.9-3.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4891.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4891"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-116724"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N"}]}