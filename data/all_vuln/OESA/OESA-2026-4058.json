{"schema_version":"1.9.0","id":"OESA-2026-4058","published":"2026-09-25T01:27:48Z","modified":"2026-09-25T01:45:08.302419Z","upstream":["CVE-2026-77643"],"summary":"xapian-core security update","details":"Xapian is an Open Source Search Engine Library, released under the GPL v2+. It is a highly adaptable toolkit which allows developers to easily add advanced indexing and search facilities to their own applications. It has built-in support for several families of weighting models and also supports a rich set of boolean query operators.\r\n\r\nSecurity Fix(es):\n\nA cross-site scripting vulnerability in queryparser/termgenerator_internal.cc in Xapian xapian-core before 2.1.0 and before 1.4.32 exists due to incomplete HTML escaping by Xapian::MSet::snippet(). NOTE: this issue exists because of a missed corner case of CVE-2018-0499.(CVE-2026-77643)","affected":[{"package":{"name":"xapian-core","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/xapian-core&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.4.23-2.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["xapian-core-1.4.23-2.oe2403sp1.aarch64.rpm","xapian-core-debuginfo-1.4.23-2.oe2403sp1.aarch64.rpm","xapian-core-debugsource-1.4.23-2.oe2403sp1.aarch64.rpm","xapian-core-devel-1.4.23-2.oe2403sp1.aarch64.rpm","xapian-core-help-1.4.23-2.oe2403sp1.aarch64.rpm"],"src":["xapian-core-1.4.23-2.oe2403sp1.src.rpm"],"x86_64":["xapian-core-1.4.23-2.oe2403sp1.x86_64.rpm","xapian-core-debuginfo-1.4.23-2.oe2403sp1.x86_64.rpm","xapian-core-debugsource-1.4.23-2.oe2403sp1.x86_64.rpm","xapian-core-devel-1.4.23-2.oe2403sp1.x86_64.rpm","xapian-core-help-1.4.23-2.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4058.json"}},{"package":{"name":"xapian-core","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/xapian-core&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introd