{"schema_version":"1.9.2","id":"OESA-2026-4952","published":"2026-11-19T01:43:24Z","modified":"2026-11-19T02:00:17.945762788Z","upstream":["CVE-2026-119601"],"summary":"afflib security update","details":"AFF® is an open and extensible file format designed to store disk images and associated metadata.\r\n\r\nSecurity Fix(es):\n\nAFFLIB through 3.7.22 contains a heap out-of-bounds write vulnerability in af_get_page() that allows attackers to corrupt heap memory by supplying crafted AFF images with mismatched page and sector sizes. Attackers can set a page size larger than and not a multiple of the sector size, causing the sector zero-fill loop to write past the buffer and crash forensic tools.(CVE-2026-119601)","affected":[{"package":{"name":"afflib","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/afflib&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.7.20-3.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["afflib-3.7.20-3.oe2403sp4.aarch64.rpm","afflib-debuginfo-3.7.20-3.oe2403sp4.aarch64.rpm","afflib-debugsource-3.7.20-3.oe2403sp4.aarch64.rpm","afflib-devel-3.7.20-3.oe2403sp4.aarch64.rpm","afftools-3.7.20-3.oe2403sp4.aarch64.rpm","python3-pyaff-3.7.20-3.oe2403sp4.aarch64.rpm"],"src":["afflib-3.7.20-3.oe2403sp4.src.rpm"],"x86_64":["afflib-3.7.20-3.oe2403sp4.x86_64.rpm","afflib-debuginfo-3.7.20-3.oe2403sp4.x86_64.rpm","afflib-debugsource-3.7.20-3.oe2403sp4.x86_64.rpm","afflib-devel-3.7.20-3.oe2403sp4.x86_64.rpm","afftools-3.7.20-3.oe2403sp4.x86_64.rpm","python3-pyaff-3.7.20-3.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4952.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4952"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-119601"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:L/