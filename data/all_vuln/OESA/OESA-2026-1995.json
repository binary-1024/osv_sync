{"schema_version":"1.9.0","id":"OESA-2026-1995","published":"2026-04-25T11:10:59Z","modified":"2026-08-18T01:19:44.460213625Z","upstream":["CVE-2026-31958"],"summary":"python-tornado security update","details":"Tornado is an open source version of the scalable, non-blocking web server and tools.\r\n\r\nSecurity Fix(es):\n\nTornado is a Python web framework and asynchronous networking library. In versions of Tornado prior to 6.5.5, the only limit on the number of parts in multipart/form-data is the max_body_size setting (default 100MB). Since parsing occurs synchronously on the main thread, this creates the possibility of denial-of-service due to the cost of parsing very large multipart bodies with many parts. This vulnerability is fixed in 6.5.5.(CVE-2026-31958)","affected":[{"package":{"name":"python-tornado","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/python-tornado&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.0.2-13.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["python-tornado-debuginfo-5.0.2-13.oe2003sp4.aarch64.rpm","python-tornado-debugsource-5.0.2-13.oe2003sp4.aarch64.rpm","python2-tornado-5.0.2-13.oe2003sp4.aarch64.rpm","python3-tornado-5.0.2-13.oe2003sp4.aarch64.rpm"],"src":["python-tornado-5.0.2-13.oe2003sp4.src.rpm"],"x86_64":["python-tornado-debuginfo-5.0.2-13.oe2003sp4.x86_64.rpm","python-tornado-debugsource-5.0.2-13.oe2003sp4.x86_64.rpm","python2-tornado-5.0.2-13.oe2003sp4.x86_64.rpm","python3-tornado-5.0.2-13.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1995.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1995"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-31958"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X"}]}