{"schema_version":"1.9.0","id":"OESA-2026-3926","published":"2026-09-20T13:23:17Z","modified":"2026-09-20T13:30:26.120753560Z","upstream":["CVE-2026-73282","CVE-2026-73283"],"summary":"openssh security update","details":"An open source implementation of SSH protocol version 2\r\n\r\nSecurity Fix(es):\n\nIn ssh in OpenSSH before 10.5, a use-after-free for realloc data can occur if a certain pair of remote-forwarding operations are concurrent.(CVE-2026-73282)\n\nIn sshd in OpenSSH before 10.5, the restrict keyword (in authorized_keys) was supposed to be applicable to tunnel forwarding but was not.(CVE-2026-73283)","affected":[{"package":{"name":"openssh","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/openssh&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"9.6p1-23.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["openssh-9.6p1-23.oe2403sp3.aarch64.rpm","openssh-askpass-9.6p1-23.oe2403sp3.aarch64.rpm","openssh-clients-9.6p1-23.oe2403sp3.aarch64.rpm","openssh-debuginfo-9.6p1-23.oe2403sp3.aarch64.rpm","openssh-debugsource-9.6p1-23.oe2403sp3.aarch64.rpm","openssh-keycat-9.6p1-23.oe2403sp3.aarch64.rpm","openssh-server-9.6p1-23.oe2403sp3.aarch64.rpm","pam_ssh_agent_auth-0.10.4-5.23.oe2403sp3.aarch64.rpm"],"noarch":["openssh-help-9.6p1-23.oe2403sp3.noarch.rpm"],"src":["openssh-9.6p1-23.oe2403sp3.src.rpm"],"x86_64":["openssh-9.6p1-23.oe2403sp3.x86_64.rpm","openssh-askpass-9.6p1-23.oe2403sp3.x86_64.rpm","openssh-clients-9.6p1-23.oe2403sp3.x86_64.rpm","openssh-debuginfo-9.6p1-23.oe2403sp3.x86_64.rpm","openssh-debugsource-9.6p1-23.oe2403sp3.x86_64.rpm","openssh-keycat-9.6p1-23.oe2403sp3.x86_64.rpm","openssh-server-9.6p1-23.oe2403sp3.x86_64.rpm","pam_ssh_agent_auth-0.10.4-5.23.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3926.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEu