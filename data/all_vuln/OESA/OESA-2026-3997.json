{"schema_version":"1.9.0","id":"OESA-2026-3997","published":"2026-09-20T13:23:58Z","modified":"2026-09-20T13:30:33.806571382Z","upstream":["CVE-2026-12318"],"summary":"nss security update","details":"Network Security Services (NSS) is a set of libraries designed to support cross-platform development of security-enabled client and server applications. Applications built with NSS can support SSL v2 and v3, TLS, PKCS #5, PKCS #7, PKCS #11, PKCS #12, S/MIME, X.509 v3 certificates, and other security standards.\r\n\r\nSecurity Fix(es):\n\nIncorrect boundary conditions in the Libraries component in NSS. This vulnerability was fixed in Firefox 152 and Thunderbird 152.\n(CVE-2026-12318)","affected":[{"package":{"name":"nss","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/nss&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.94.0-11.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["nss-3.94.0-11.oe2403sp1.aarch64.rpm","nss-debuginfo-3.94.0-11.oe2403sp1.aarch64.rpm","nss-debugsource-3.94.0-11.oe2403sp1.aarch64.rpm","nss-devel-3.94.0-11.oe2403sp1.aarch64.rpm","nss-help-3.94.0-11.oe2403sp1.aarch64.rpm","nss-softokn-3.94.0-11.oe2403sp1.aarch64.rpm","nss-softokn-devel-3.94.0-11.oe2403sp1.aarch64.rpm","nss-util-3.94.0-11.oe2403sp1.aarch64.rpm","nss-util-devel-3.94.0-11.oe2403sp1.aarch64.rpm"],"src":["nss-3.94.0-11.oe2403sp1.src.rpm"],"x86_64":["nss-3.94.0-11.oe2403sp1.x86_64.rpm","nss-debuginfo-3.94.0-11.oe2403sp1.x86_64.rpm","nss-debugsource-3.94.0-11.oe2403sp1.x86_64.rpm","nss-devel-3.94.0-11.oe2403sp1.x86_64.rpm","nss-help-3.94.0-11.oe2403sp1.x86_64.rpm","nss-softokn-3.94.0-11.oe2403sp1.x86_64.rpm","nss-softokn-devel-3.94.0-11.oe2403sp1.x86_64.rpm","nss-util-3.94.0-11.oe2403sp1.x86_64.rpm","nss-util-devel-3.94.0-11.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3997.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/secur