{"schema_version":"1.9.2","id":"OESA-2026-4570","published":"2026-10-29T09:03:04Z","modified":"2026-10-29T09:15:30.230952903Z","upstream":["CVE-2026-96807"],"summary":"flatpak security update","details":"flatpak is a system for building, distributing and running sandboxed desktop applications on Linux. See https://wiki.gnome.org/Projects/SandboxedApps for more information.\r\n\r\nSecurity Fix(es):\n\nIn Flatpak before 1.18.1, a malicious sandboxed app can replace ~/.var/app/$appid/.ld.so with a symlink, causing regenerate_ld_cache to write files at an arbitrary location. The filenames and content are not attacker controlled, making this hard to exploit.(CVE-2026-96807)","affected":[{"package":{"name":"flatpak","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/flatpak&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.10.2-16.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["flatpak-1.10.2-16.oe2403sp1.aarch64.rpm","flatpak-debuginfo-1.10.2-16.oe2403sp1.aarch64.rpm","flatpak-debugsource-1.10.2-16.oe2403sp1.aarch64.rpm","flatpak-devel-1.10.2-16.oe2403sp1.aarch64.rpm"],"noarch":["flatpak-help-1.10.2-16.oe2403sp1.noarch.rpm"],"src":["flatpak-1.10.2-16.oe2403sp1.src.rpm"],"x86_64":["flatpak-1.10.2-16.oe2403sp1.x86_64.rpm","flatpak-debuginfo-1.10.2-16.oe2403sp1.x86_64.rpm","flatpak-debugsource-1.10.2-16.oe2403sp1.x86_64.rpm","flatpak-devel-1.10.2-16.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4570.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4570"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-96807"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:N/I:L/A:L"}]}