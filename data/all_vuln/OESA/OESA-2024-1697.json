{"schema_version":"1.9.0","id":"OESA-2024-1697","published":"2024-06-07T11:07:09Z","modified":"2026-08-18T01:17:23.238801031Z","upstream":["CVE-2024-4741"],"summary":"openssl security update","details":"The OpenSSL Project is a collaborative effort to develop a robust, commercial-grade, fully featured, and Open Source toolkit implementing the Secure Sockets Layer (SSL v2/v3) and Transport Layer Security (TLS v1) protocols as well as a full-strength general purpose cryptography library. The project is managed by a worldwide community of volunteers that use the Internet to communicate, plan, and develop the OpenSSL tookit and its related documentation.\r\n\r\nSecurity Fix(es):\r\n\r\nA use-after-free vulnerability was found in OpenSSL. Calling the OpenSSL API SSL_free_buffers function may cause memory to be accessed that was previously freed in some situations.(CVE-2024-4741)","affected":[{"package":{"name":"openssl","ecosystem":"openEuler:22.03-LTS-SP3","purl":"pkg:rpm/openEuler/openssl&distro=openEuler-22.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.1.1wa-7.oe2203sp3"}]}],"ecosystem_specific":{"aarch64":["openssl-devel-1.1.1wa-7.oe2203sp3.aarch64.rpm","openssl-libs-1.1.1wa-7.oe2203sp3.aarch64.rpm","openssl-debuginfo-1.1.1wa-7.oe2203sp3.aarch64.rpm","openssl-debugsource-1.1.1wa-7.oe2203sp3.aarch64.rpm","openssl-1.1.1wa-7.oe2203sp3.aarch64.rpm","openssl-perl-1.1.1wa-7.oe2203sp3.aarch64.rpm"],"noarch":["openssl-help-1.1.1wa-7.oe2203sp3.noarch.rpm"],"src":["openssl-1.1.1wa-7.oe2203sp3.src.rpm"],"x86_64":["openssl-perl-1.1.1wa-7.oe2203sp3.x86_64.rpm","openssl-1.1.1wa-7.oe2203sp3.x86_64.rpm","openssl-debuginfo-1.1.1wa-7.oe2203sp3.x86_64.rpm","openssl-debugsource-1.1.1wa-7.oe2203sp3.x86_64.rpm","openssl-devel-1.1.1wa-7.oe2203sp3.x86_64.rpm","openssl-libs-1.1.1wa-7.oe2203sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2024-1697.json"}}],"references":[{"type":"ADVISORY","url":"https://w