{"schema_version":"1.9.0","id":"OESA-2026-3502","published":"2026-08-30T04:14:16Z","modified":"2026-08-30T04:31:43.387454768Z","upstream":["CVE-2026-16389"],"summary":"nss security update","details":"Network Security Services (NSS) is a set of libraries designed to support cross-platform development of security-enabled client and server applications. Applications built with NSS can support SSL v2 and v3, TLS, PKCS #5, PKCS #7, PKCS #11, PKCS #12, S/MIME, X.509 v3 certificates, and other security standards.\r\n\r\nSecurity Fix(es):\n\nIncorrect boundary conditions, integer overflow in the Libraries component in NSS. This vulnerability was fixed in Firefox 153 and Thunderbird 153.(CVE-2026-16389)","affected":[{"package":{"name":"nss","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/nss&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.94.0-10.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["nss-3.94.0-10.oe2403sp1.aarch64.rpm","nss-debuginfo-3.94.0-10.oe2403sp1.aarch64.rpm","nss-debugsource-3.94.0-10.oe2403sp1.aarch64.rpm","nss-devel-3.94.0-10.oe2403sp1.aarch64.rpm","nss-help-3.94.0-10.oe2403sp1.aarch64.rpm","nss-softokn-3.94.0-10.oe2403sp1.aarch64.rpm","nss-softokn-devel-3.94.0-10.oe2403sp1.aarch64.rpm","nss-util-3.94.0-10.oe2403sp1.aarch64.rpm","nss-util-devel-3.94.0-10.oe2403sp1.aarch64.rpm"],"src":["nss-3.94.0-10.oe2403sp1.src.rpm"],"x86_64":["nss-3.94.0-10.oe2403sp1.x86_64.rpm","nss-debuginfo-3.94.0-10.oe2403sp1.x86_64.rpm","nss-debugsource-3.94.0-10.oe2403sp1.x86_64.rpm","nss-devel-3.94.0-10.oe2403sp1.x86_64.rpm","nss-help-3.94.0-10.oe2403sp1.x86_64.rpm","nss-softokn-3.94.0-10.oe2403sp1.x86_64.rpm","nss-softokn-devel-3.94.0-10.oe2403sp1.x86_64.rpm","nss-util-3.94.0-10.oe2403sp1.x86_64.rpm","nss-util-devel-3.94.0-10.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3502.json"}},{"package":{"name":"nss","ecosystem":"openEuler:24.03-LTS-S