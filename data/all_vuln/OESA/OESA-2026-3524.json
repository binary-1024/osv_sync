{"schema_version":"1.9.0","id":"OESA-2026-3524","published":"2026-08-30T04:14:49Z","modified":"2026-08-30T04:31:36.926866389Z","upstream":["CVE-2026-76217"],"summary":"python-GitPython security update","details":"GitPython is a python library used to interact with git repositories, high-level like git-porcelain, or low-level like git-plumbing.\r\n\r\nSecurity Fix(es):\n\nGitPython versions before 3.1.58 fail to validate options passed to git rm and git checkout commands in IndexFile.remove() and Head.checkout(). Attackers can supply --pathspec-from-file and --pathspec-file-nul parameters to read arbitrary files accessible to the process, with full file contents returned in GitCommandError.stderr.(CVE-2026-76217)","affected":[{"package":{"name":"python-GitPython","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/python-GitPython&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.1.32-4.oe2203sp4"}]}],"ecosystem_specific":{"noarch":["python-GitPython-help-3.1.32-4.oe2203sp4.noarch.rpm","python3-GitPython-3.1.32-4.oe2203sp4.noarch.rpm"],"src":["python-GitPython-3.1.32-4.oe2203sp4.src.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3524.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3524"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-76217"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X"}]}