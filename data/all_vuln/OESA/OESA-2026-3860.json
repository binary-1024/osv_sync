{"schema_version":"1.9.0","id":"OESA-2026-3860","published":"2026-09-14T16:35:05Z","modified":"2026-09-13T16:45:51.152348672Z","upstream":["CVE-2026-78367"],"summary":"rpm security update","details":"The RPM Package Manager (RPM) is a powerful package management system capability as below\r\n\r\nSecurity Fix(es):\n\nA flaw was found in rpmbuild. When rpmbuild processes a crafted tarball in tarball mode, a specially designed tar member name can lead to macro injection. This vulnerability allows a remote attacker to execute arbitrary code on the system by convincing a user to build a malicious tarball.(CVE-2026-78367)","affected":[{"package":{"name":"rpm","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/rpm&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.15.1-66.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["python2-rpm-4.15.1-66.oe2003sp4.aarch64.rpm","python3-rpm-4.15.1-66.oe2003sp4.aarch64.rpm","rpm-4.15.1-66.oe2003sp4.aarch64.rpm","rpm-build-4.15.1-66.oe2003sp4.aarch64.rpm","rpm-debuginfo-4.15.1-66.oe2003sp4.aarch64.rpm","rpm-debugsource-4.15.1-66.oe2003sp4.aarch64.rpm","rpm-devel-4.15.1-66.oe2003sp4.aarch64.rpm","rpm-libs-4.15.1-66.oe2003sp4.aarch64.rpm","rpm-plugin-systemd-inhibit-4.15.1-66.oe2003sp4.aarch64.rpm"],"noarch":["rpm-help-4.15.1-66.oe2003sp4.noarch.rpm"],"src":["rpm-4.15.1-66.oe2003sp4.src.rpm"],"x86_64":["python2-rpm-4.15.1-66.oe2003sp4.x86_64.rpm","python3-rpm-4.15.1-66.oe2003sp4.x86_64.rpm","rpm-4.15.1-66.oe2003sp4.x86_64.rpm","rpm-build-4.15.1-66.oe2003sp4.x86_64.rpm","rpm-debuginfo-4.15.1-66.oe2003sp4.x86_64.rpm","rpm-debugsource-4.15.1-66.oe2003sp4.x86_64.rpm","rpm-devel-4.15.1-66.oe2003sp4.x86_64.rpm","rpm-libs-4.15.1-66.oe2003sp4.x86_64.rpm","rpm-plugin-systemd-inhibit-4.15.1-66.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3860.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/se