{"schema_version":"1.9.0","id":"OESA-2026-4119","published":"2026-09-25T01:28:41Z","modified":"2026-09-25T01:45:09.208325131Z","upstream":["CVE-2026-90781"],"summary":"alsa-lib security update","details":"The alsa-lib is a library to interface with ALSA in the Linux kernel and virtual devices using a plugin system. More detail: https://alsa.opensrc.org/Alsa-lib\r\n\r\nSecurity Fix(es):\n\nalsa-lib through 1.2.16.1 contains a stack buffer overflow in the __snd_ctl_ascii_elem_id_parse() function that writes one byte past a 64-byte buffer when parsing a name= field with 64 or more characters. Attackers can supply a long control-element identifier string through saved state files or command-line arguments to overwrite adjacent stack memory and crash the calling process.(CVE-2026-90781)","affected":[{"package":{"name":"alsa-lib","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/alsa-lib&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.2.10-6.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["alsa-lib-1.2.10-6.oe2403sp4.aarch64.rpm","alsa-lib-debuginfo-1.2.10-6.oe2403sp4.aarch64.rpm","alsa-lib-debugsource-1.2.10-6.oe2403sp4.aarch64.rpm","alsa-lib-devel-1.2.10-6.oe2403sp4.aarch64.rpm"],"noarch":["alsa-topology-1.2.10-6.oe2403sp4.noarch.rpm","alsa-ucm-1.2.10-6.oe2403sp4.noarch.rpm"],"src":["alsa-lib-1.2.10-6.oe2403sp4.src.rpm"],"x86_64":["alsa-lib-1.2.10-6.oe2403sp4.x86_64.rpm","alsa-lib-debuginfo-1.2.10-6.oe2403sp4.x86_64.rpm","alsa-lib-debugsource-1.2.10-6.oe2403sp4.x86_64.rpm","alsa-lib-devel-1.2.10-6.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4119.json"}},{"package":{"name":"alsa-lib","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/alsa-lib&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.2.3-4.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["alsa-lib-1.2.3-4.oe2003sp4