{"schema_version":"1.9.0","id":"OESA-2026-2012","published":"2026-04-25T11:11:01Z","modified":"2026-08-18T01:19:48.390589638Z","upstream":["CVE-2026-41066"],"summary":"python-lxml security update","details":"\\\r\n\r\nSecurity Fix(es):\n\nlxml is a library for processing XML and HTML in the Python language. Prior to 6.1.0, using either of the two parsers in the default configuration (with resolve_entities=True) allows untrusted XML input to read local files. Setting the resolve_entities option explicitly to resolve_entities=&apos;internal&apos; or resolve_entities=False disables the local file access. This vulnerability is fixed in 6.1.0.(CVE-2026-41066)","affected":[{"package":{"name":"python-lxml","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/python-lxml&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.7.1-9.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["python-lxml-debuginfo-4.7.1-9.oe2203sp4.aarch64.rpm","python-lxml-debugsource-4.7.1-9.oe2203sp4.aarch64.rpm","python3-lxml-4.7.1-9.oe2203sp4.aarch64.rpm"],"noarch":["python-lxml-help-4.7.1-9.oe2203sp4.noarch.rpm"],"src":["python-lxml-4.7.1-9.oe2203sp4.src.rpm"],"x86_64":["python-lxml-debuginfo-4.7.1-9.oe2203sp4.x86_64.rpm","python-lxml-debugsource-4.7.1-9.oe2203sp4.x86_64.rpm","python3-lxml-4.7.1-9.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2012.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2012"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-41066"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N"}]}