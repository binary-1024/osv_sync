{"schema_version":"1.9.2","id":"OESA-2026-4981","published":"2026-11-19T01:43:46Z","modified":"2026-11-19T02:00:54.641339921Z","upstream":["CVE-2026-123876"],"summary":"podman security update","details":"Podman manages the entire container ecosystem which includes pods, containers, container images, and container volumes using the libpod library.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in the default seccomp profile used by Podman via containers-common. Deny rules for AF_VSOCK and NETLINK_AUDIT compared socket arguments with unmasked 64-bit equality. Because the kernel truncates those int arguments to 32 bits, setting upper bits can bypass the deny rules.(CVE-2026-123876)","affected":[{"package":{"name":"podman","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/podman&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.4.4-19.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["podman-3.4.4-19.oe2203sp4.aarch64.rpm","podman-debuginfo-3.4.4-19.oe2203sp4.aarch64.rpm","podman-debugsource-3.4.4-19.oe2203sp4.aarch64.rpm","podman-gvproxy-3.4.4-19.oe2203sp4.aarch64.rpm","podman-plugins-3.4.4-19.oe2203sp4.aarch64.rpm","podman-remote-3.4.4-19.oe2203sp4.aarch64.rpm"],"noarch":["podman-docker-3.4.4-19.oe2203sp4.noarch.rpm","podman-help-3.4.4-19.oe2203sp4.noarch.rpm"],"src":["podman-3.4.4-19.oe2203sp4.src.rpm"],"x86_64":["podman-3.4.4-19.oe2203sp4.x86_64.rpm","podman-debuginfo-3.4.4-19.oe2203sp4.x86_64.rpm","podman-debugsource-3.4.4-19.oe2203sp4.x86_64.rpm","podman-gvproxy-3.4.4-19.oe2203sp4.x86_64.rpm","podman-plugins-3.4.4-19.oe2203sp4.x86_64.rpm","podman-remote-3.4.4-19.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4981.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4981"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-123876"}],"database_