{"schema_version":"1.9.2","id":"OESA-2026-4785","published":"2026-11-11T12:26:08Z","modified":"2026-11-11T12:45:05.483135944Z","upstream":["CVE-2026-107590"],"summary":"qt6-qt5compat security update","details":".\r\n\r\nSecurity Fix(es):\n\nAn out-of-bounds write vulnerability in the Qt QTextCodec iconv-based encoding of the Qt 5 Compatibility APIs module (Qt Core in Qt 5 and earlier) impacts Qt. Under certain conditions, encoding text with QTextCodec may write outside an internal buffer. This can cause the application to crash and may affect data integrity.(CVE-2026-107590)","affected":[{"package":{"name":"qt6-qt5compat","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/qt6-qt5compat&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"6.5.2-4.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["qt6-qt5compat-6.5.2-4.oe2403sp3.aarch64.rpm","qt6-qt5compat-debuginfo-6.5.2-4.oe2403sp3.aarch64.rpm","qt6-qt5compat-debugsource-6.5.2-4.oe2403sp3.aarch64.rpm","qt6-qt5compat-devel-6.5.2-4.oe2403sp3.aarch64.rpm"],"src":["qt6-qt5compat-6.5.2-4.oe2403sp3.src.rpm"],"x86_64":["qt6-qt5compat-6.5.2-4.oe2403sp3.x86_64.rpm","qt6-qt5compat-debuginfo-6.5.2-4.oe2403sp3.x86_64.rpm","qt6-qt5compat-debugsource-6.5.2-4.oe2403sp3.x86_64.rpm","qt6-qt5compat-devel-6.5.2-4.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4785.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4785"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-107590"}],"database_specific":{"severity":"Low"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:L/AC:L/AT:P/PR:N/UI:P/VC:N/VI:L/VA:H/SC:N/SI:N/SA:N/E:U/R:U/RE:L/U:Green"}]}