{"schema_version":"1.9.0","id":"OESA-2026-2363","published":"2026-05-22T11:11:19Z","modified":"2026-08-18T01:19:57.842008219Z","upstream":["CVE-2026-3219"],"summary":"python-pip security update","details":"%changelog * Thu Apr 9 2026 yixiangzhike &amp;lt;yixiangzhike007@163.com&amp;gt; - 23.3.1-10 - Fix CVE-2026-25645\r\n\r\nSecurity Fix(es):\n\npip handles concatenated tar and ZIP files as ZIP files regardless of filename or whether a file is both a tar and ZIP file. This behavior could result in confusing installation behavior, such as installing &quot;incorrect&quot; files according to the filename of the archive. New behavior only proceeds with installation if the file identifies uniquely as a ZIP or tar archive, not as both.(CVE-2026-3219)","affected":[{"package":{"name":"python-pip","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/python-pip&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"21.3.1-16.oe2203sp4"}]}],"ecosystem_specific":{"noarch":["python-pip-help-21.3.1-16.oe2203sp4.noarch.rpm","python-pip-wheel-21.3.1-16.oe2203sp4.noarch.rpm","python3-pip-21.3.1-16.oe2203sp4.noarch.rpm"],"src":["python-pip-21.3.1-16.oe2203sp4.src.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2363.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2363"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-3219"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:A/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X"}]}