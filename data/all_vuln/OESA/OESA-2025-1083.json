{"schema_version":"1.9.0","id":"OESA-2025-1083","published":"2025-01-24T11:08:10Z","modified":"2026-08-18T01:18:44.688563386Z","upstream":["CVE-2024-35365"],"summary":"ffmpeg security update","details":"FFmpeg is a complete and free Internet live audio and video broadcasting solution for Linux/Unix. It also includes a digital VCR. It can encode in real time in many formats including MPEG1 audio and video, MPEG4, h263, ac3, asf, avi, real, mjpeg, and flash.\r\n\r\nSecurity Fix(es):\n\nFFmpeg version n6.1.1 has a double-free vulnerability in the fftools/ffmpeg_mux_init.c component of FFmpeg, specifically within the new_stream_audio function.(CVE-2024-35365)","affected":[{"package":{"name":"ffmpeg","ecosystem":"openEuler:24.03-LTS","purl":"pkg:rpm/openEuler/ffmpeg&distro=openEuler-24.03-LTS"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"6.1.1-20.oe2403"}]}],"ecosystem_specific":{"aarch64":["ffmpeg-6.1.1-20.oe2403.aarch64.rpm","ffmpeg-debuginfo-6.1.1-20.oe2403.aarch64.rpm","ffmpeg-debugsource-6.1.1-20.oe2403.aarch64.rpm","ffmpeg-devel-6.1.1-20.oe2403.aarch64.rpm","ffmpeg-libs-6.1.1-20.oe2403.aarch64.rpm","libavdevice-6.1.1-20.oe2403.aarch64.rpm"],"src":["ffmpeg-6.1.1-20.oe2403.src.rpm"],"x86_64":["ffmpeg-6.1.1-20.oe2403.x86_64.rpm","ffmpeg-debuginfo-6.1.1-20.oe2403.x86_64.rpm","ffmpeg-debugsource-6.1.1-20.oe2403.x86_64.rpm","ffmpeg-devel-6.1.1-20.oe2403.x86_64.rpm","ffmpeg-libs-6.1.1-20.oe2403.x86_64.rpm","libavdevice-6.1.1-20.oe2403.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2025-1083.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2025-1083"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2024-35365"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:L/UI:R/S:U/C:L/I:L/A:L"}]}