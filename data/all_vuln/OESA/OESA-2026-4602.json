{"schema_version":"1.9.2","id":"OESA-2026-4602","published":"2026-10-29T09:03:27Z","modified":"2026-10-29T09:15:38.580121553Z","upstream":["CVE-2026-111497"],"summary":"python-brotlicffi security update","details":"Python CFFI bindings to the Brotli library.\r\n\r\nSecurity Fix(es):\n\nA buffer overflow vulnerability in the Brotli decoder (c/dec/decode.c) in Google Brotli versions 1.0.3 through 1.2.0 on all platforms allows a remote unauthenticated attacker to corrupt adjacent decoder state memory, disclose sensitive memory contents, cause a denial of service, or potentially execute arbitrary code using a crafted Brotli-compressed stream.\n\n\n\n\n\nUsers need to update any Brotli libraries or binaries between 1.0.3 through 1.2.0 to the latest available version: 1.0.10 or 1.1.1 or 1.2.1.(CVE-2026-111497)","affected":[{"package":{"name":"python-brotlicffi","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/python-brotlicffi&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.1.0.0-2.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["python-brotlicffi-debuginfo-1.1.0.0-2.oe2403sp3.aarch64.rpm","python-brotlicffi-debugsource-1.1.0.0-2.oe2403sp3.aarch64.rpm","python-brotlicffi-help-1.1.0.0-2.oe2403sp3.aarch64.rpm","python3-brotlicffi-1.1.0.0-2.oe2403sp3.aarch64.rpm"],"src":["python-brotlicffi-1.1.0.0-2.oe2403sp3.src.rpm"],"x86_64":["python-brotlicffi-debuginfo-1.1.0.0-2.oe2403sp3.x86_64.rpm","python-brotlicffi-debugsource-1.1.0.0-2.oe2403sp3.x86_64.rpm","python-brotlicffi-help-1.1.0.0-2.oe2403sp3.x86_64.rpm","python3-brotlicffi-1.1.0.0-2.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4602.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4602"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-111497"}],"database_specific":{"severity":"Critical"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N"}]}