{"schema_version":"1.9.0","id":"OESA-2026-3963","published":"2026-09-20T13:23:38Z","modified":"2026-09-20T13:30:31.207790789Z","upstream":["CVE-2023-52389"],"summary":"poco security update","details":"This is ROS melodic ros_comm&amp;apos;s 3rdparty poco.\r\n\r\nSecurity Fix(es):\n\nUTF32Encoding.cpp in POCO has a Poco::UTF32Encoding integer overflow and resultant stack buffer overflow because Poco::UTF32Encoding::convert() and Poco::UTF32::queryConvert() may return a negative integer if a UTF-32 byte sequence evaluates to a value of 0x80000000 or higher. This is fixed in 1.11.8p2, 1.12.5p2, and 1.13.0.(CVE-2023-52389)","affected":[{"package":{"name":"poco","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/poco&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.12.5p2-2.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["poco-activerecord-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-crypto-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-data-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-debug-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-debuginfo-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-debugsource-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-devel-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-doc-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-encodings-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-foundation-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-json-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-jwt-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-mongodb-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-mysql-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-net-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-netssl-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-odbc-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-pagecompiler-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-prometheus-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-sqlite-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-util-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-xml-1.12.5p2-2.oe2403sp1.aarch64.rpm","poco-zip-1.12.5p2-2.oe2403sp1.aarch64.rpm"],"src":["poco-1.1