{"schema_version":"1.9.0","id":"OESA-2026-1987","published":"2026-04-17T11:10:59Z","modified":"2026-08-18T01:19:39.319217926Z","upstream":["CVE-2026-40385","CVE-2026-40386"],"summary":"libexif security update","details":"Most digital cameras produce EXIF files, which are JPEG files with extra tags that contain information about the image. The EXIF library allows you to parse an EXIF file and read the data from those tags.\r\n\r\nSecurity Fix(es):\n\nIn libexif through 0.6.25, an unsigned 32bit integer overflow in Nikon MakerNote handling could be used by local attackers to cause crashes or information leaks. This only affects 32bit systems.(CVE-2026-40385)\n\nIn libexif through 0.6.25, an integer underflow in size checking for Fuji and Olympus MakerNote decoding could be used by attackers to crash or leak information out of libexif-using programs.(CVE-2026-40386)","affected":[{"package":{"name":"libexif","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/libexif&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.6.21-28.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["libexif-0.6.21-28.oe2003sp4.aarch64.rpm","libexif-debuginfo-0.6.21-28.oe2003sp4.aarch64.rpm","libexif-debugsource-0.6.21-28.oe2003sp4.aarch64.rpm","libexif-devel-0.6.21-28.oe2003sp4.aarch64.rpm"],"noarch":["libexif-help-0.6.21-28.oe2003sp4.noarch.rpm"],"src":["libexif-0.6.21-28.oe2003sp4.src.rpm"],"x86_64":["libexif-0.6.21-28.oe2003sp4.x86_64.rpm","libexif-debuginfo-0.6.21-28.oe2003sp4.x86_64.rpm","libexif-debugsource-0.6.21-28.oe2003sp4.x86_64.rpm","libexif-devel-0.6.21-28.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1987.json"}},{"package":{"name":"libexif","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/libexif&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.6.22-7.oe2203sp4"}]}],"ecosystem_specific"