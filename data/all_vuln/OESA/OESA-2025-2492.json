{"schema_version":"1.9.0","id":"OESA-2025-2492","published":"2025-10-24T11:09:35Z","modified":"2026-08-18T01:19:15.210602296Z","upstream":["CVE-2025-5683"],"summary":"qt5-qtimageformats security update","details":"The core Qt Gui library by default supports reading and writing image files of the most common file formats: PNG, JPEG, BMP, GIF and a few more, ref. Reading and Writing Image Files. The Qt Image Formats add-on module provides optional support for other image file formats.\r\n\r\nSecurity Fix(es):\n\nWhen loading a specifically crafted ICNS format image file in QImage then it will trigger a crash. This issue affects Qt from versions 6.3.0 through 6.5.9, from 6.6.0 through 6.8.4, 6.9.0. This is fixed in 6.5.10, 6.8.5 and 6.9.1.(CVE-2025-5683)","affected":[{"package":{"name":"qt5-qtimageformats","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/qt5-qtimageformats&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.15.10-2.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["qt5-qtimageformats-5.15.10-2.oe2403sp1.aarch64.rpm","qt5-qtimageformats-debuginfo-5.15.10-2.oe2403sp1.aarch64.rpm","qt5-qtimageformats-debugsource-5.15.10-2.oe2403sp1.aarch64.rpm"],"src":["qt5-qtimageformats-5.15.10-2.oe2403sp1.src.rpm"],"x86_64":["qt5-qtimageformats-5.15.10-2.oe2403sp1.x86_64.rpm","qt5-qtimageformats-debuginfo-5.15.10-2.oe2403sp1.x86_64.rpm","qt5-qtimageformats-debugsource-5.15.10-2.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2025-2492.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2025-2492"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2025-5683"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H"}]}