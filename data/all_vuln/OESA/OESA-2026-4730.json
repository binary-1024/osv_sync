{"schema_version":"1.9.2","id":"OESA-2026-4730","published":"2026-11-04T13:55:00Z","modified":"2026-11-04T14:00:07.480640704Z","upstream":["CVE-2026-108985"],"summary":"libnfs security update","details":"Package contains a library of functions for accessing NFSv2 and NFSv3 servers from user space. It provides a low-level,asynchronous RPC library for accessing NFS protocols, an asynchronous library with POSIX-like VFS functions,and a synchronous library with POSIX-like VFS functions.\r\n\r\nSecurity Fix(es):\n\nZDR decoding in libnfs through 6.0.2 before 7613236 has an out-of-bounds write related to lib/libnfs-zdr.c with libnfs_zdr_bytes(), libnfs_zdr_string(), and libnfs_zdr_array(). The caller-supplied maxsize value is not honored.(CVE-2026-108985)","affected":[{"package":{"name":"libnfs","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/libnfs&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.0.2-4.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["libnfs-5.0.2-4.oe2403sp3.aarch64.rpm","libnfs-debuginfo-5.0.2-4.oe2403sp3.aarch64.rpm","libnfs-debugsource-5.0.2-4.oe2403sp3.aarch64.rpm","libnfs-devel-5.0.2-4.oe2403sp3.aarch64.rpm","libnfs-help-5.0.2-4.oe2403sp3.aarch64.rpm","libnfs-utils-5.0.2-4.oe2403sp3.aarch64.rpm"],"src":["libnfs-5.0.2-4.oe2403sp3.src.rpm"],"x86_64":["libnfs-5.0.2-4.oe2403sp3.x86_64.rpm","libnfs-debuginfo-5.0.2-4.oe2403sp3.x86_64.rpm","libnfs-debugsource-5.0.2-4.oe2403sp3.x86_64.rpm","libnfs-devel-5.0.2-4.oe2403sp3.x86_64.rpm","libnfs-help-5.0.2-4.oe2403sp3.x86_64.rpm","libnfs-utils-5.0.2-4.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4730.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4730"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-108985"}],"database_specific":{"severity":"High"},"severity":[{"type":"CV