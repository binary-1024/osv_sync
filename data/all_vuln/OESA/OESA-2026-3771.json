{"schema_version":"1.9.0","id":"OESA-2026-3771","published":"2026-09-14T16:34:10Z","modified":"2026-09-13T16:45:37.420786267Z","upstream":["CVE-2026-83596"],"summary":"webkitgtk security update","details":"WebKitGTK is the port of the WebKit web rendering engine to the GTK platform. This package contains WebKitGTK for GTK 3 and libsoup 3.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in WebKitGTK. Processing malicious web content can cause memory corruption due to improper memory handling. The vulnerability exists in the findFeature function of OpenTypeVerticalData, which fails to properly validate the full featurelist array.(CVE-2026-83596)","affected":[{"package":{"name":"webkitgtk","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/webkitgtk&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"webkit2gtk3-2.22.2-15.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["webkit2gtk3-2.22.2-15.oe2003sp4.aarch64.rpm","webkit2gtk3-debuginfo-2.22.2-15.oe2003sp4.aarch64.rpm","webkit2gtk3-debugsource-2.22.2-15.oe2003sp4.aarch64.rpm","webkit2gtk3-devel-2.22.2-15.oe2003sp4.aarch64.rpm","webkit2gtk3-jsc-2.22.2-15.oe2003sp4.aarch64.rpm","webkit2gtk3-jsc-devel-2.22.2-15.oe2003sp4.aarch64.rpm"],"noarch":["webkit2gtk3-help-2.22.2-15.oe2003sp4.noarch.rpm"],"src":["webkit2gtk3-2.22.2-15.oe2003sp4.src.rpm"],"x86_64":["webkit2gtk3-2.22.2-15.oe2003sp4.x86_64.rpm","webkit2gtk3-debuginfo-2.22.2-15.oe2003sp4.x86_64.rpm","webkit2gtk3-debugsource-2.22.2-15.oe2003sp4.x86_64.rpm","webkit2gtk3-devel-2.22.2-15.oe2003sp4.x86_64.rpm","webkit2gtk3-jsc-2.22.2-15.oe2003sp4.x86_64.rpm","webkit2gtk3-jsc-devel-2.22.2-15.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3771.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3771"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-83596"