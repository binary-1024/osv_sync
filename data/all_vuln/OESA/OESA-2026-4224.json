{"schema_version":"1.9.0","id":"OESA-2026-4224","published":"2026-09-30T13:47:45Z","modified":"2026-10-01T02:00:10.121720041Z","upstream":["CVE-2026-86320"],"summary":"flatpak-builder security update","details":"Flatpak-builder is a tool for building flatpaks from sources.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in flatpak-builder where Git hooks are not disabled when applying patch sources with use-git-am: true. An attacker who can provide a malicious source containing a Git post-applypatch hook can cause the hook to execute on the host during the build process, resulting in arbitrary code execution with the privileges of the user running flatpak-builder.(CVE-2026-86320)","affected":[{"package":{"name":"flatpak-builder","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/flatpak-builder&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.3.5-3.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["flatpak-builder-1.3.5-3.oe2403sp4.aarch64.rpm","flatpak-builder-debuginfo-1.3.5-3.oe2403sp4.aarch64.rpm","flatpak-builder-debugsource-1.3.5-3.oe2403sp4.aarch64.rpm"],"src":["flatpak-builder-1.3.5-3.oe2403sp4.src.rpm"],"x86_64":["flatpak-builder-1.3.5-3.oe2403sp4.x86_64.rpm","flatpak-builder-debuginfo-1.3.5-3.oe2403sp4.x86_64.rpm","flatpak-builder-debugsource-1.3.5-3.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4224.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4224"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-86320"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H"}]}