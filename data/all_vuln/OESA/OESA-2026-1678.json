{"schema_version":"1.9.0","id":"OESA-2026-1678","published":"2026-03-20T11:10:42Z","modified":"2026-08-18T01:19:41.055708092Z","upstream":["CVE-2026-32775"],"summary":"libexif security update","details":"Most digital cameras produce EXIF files, which are JPEG files with extra tags that contain information about the image. The EXIF library allows you to parse an EXIF file and read the data from those tags.\r\n\r\nSecurity Fix(es):\n\nlibexif through 0.6.25 has a flaw in decoding MakerNotes. If the exif_mnote_data_get_value function gets passed in a 0 size, the passed in-buffer would be overwritten due to an integer underflow.(CVE-2026-32775)","affected":[{"package":{"name":"libexif","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/libexif&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.6.21-27.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["libexif-0.6.21-27.oe2003sp4.aarch64.rpm","libexif-debuginfo-0.6.21-27.oe2003sp4.aarch64.rpm","libexif-debugsource-0.6.21-27.oe2003sp4.aarch64.rpm","libexif-devel-0.6.21-27.oe2003sp4.aarch64.rpm"],"noarch":["libexif-help-0.6.21-27.oe2003sp4.noarch.rpm"],"src":["libexif-0.6.21-27.oe2003sp4.src.rpm"],"x86_64":["libexif-0.6.21-27.oe2003sp4.x86_64.rpm","libexif-debuginfo-0.6.21-27.oe2003sp4.x86_64.rpm","libexif-debugsource-0.6.21-27.oe2003sp4.x86_64.rpm","libexif-devel-0.6.21-27.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1678.json"}},{"package":{"name":"libexif","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/libexif&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.6.22-6.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["libexif-0.6.22-6.oe2203sp4.aarch64.rpm","libexif-debuginfo-0.6.22-6.oe2203sp4.aarch64.rpm","libexif-debugsource-0.6.22-6.oe2203sp4.aarch64.rpm","libexif-devel-0.6.22-6.oe2203sp4.aarch64.rpm"],"noarch":["libexif-he