{"schema_version":"1.9.0","id":"OESA-2026-3965","published":"2026-09-20T13:23:39Z","modified":"2026-09-20T13:30:31.103387208Z","upstream":["CVE-2023-52389"],"summary":"poco security update","details":"This is ROS melodic ros_comm&amp;apos;s 3rdparty poco.\r\n\r\nSecurity Fix(es):\n\nUTF32Encoding.cpp in POCO has a Poco::UTF32Encoding integer overflow and resultant stack buffer overflow because Poco::UTF32Encoding::convert() and Poco::UTF32::queryConvert() may return a negative integer if a UTF-32 byte sequence evaluates to a value of 0x80000000 or higher. This is fixed in 1.11.8p2, 1.12.5p2, and 1.13.0.(CVE-2023-52389)","affected":[{"package":{"name":"poco","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/poco&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.10.1-3.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["poco-1.10.1-3.oe2203sp4.aarch64.rpm"],"src":["poco-1.10.1-3.oe2203sp4.src.rpm"],"x86_64":["poco-1.10.1-3.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3965.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3965"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2023-52389"}],"database_specific":{"severity":"Critical"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"}]}