{"schema_version":"1.9.0","id":"OESA-2026-1282","published":"2026-02-06T11:10:18Z","modified":"2026-08-18T01:19:31.524212938Z","upstream":["CVE-2024-50614","CVE-2024-50615"],"summary":"tinyxml2 security update","details":"TinyXML-2 is a simple, small, efficient, C++ XML parser that can be easily integrated into other programs.  TinyXML-2 parses an XML document, and builds  from that a Document Object Model (DOM) that can be read, modified, and saved.\r\n\r\nSecurity Fix(es):\n\nTinyXML2 through 10.0.0 has a reachable assertion for UINT_MAX/16, that may lead to application exit, in tinyxml2.cpp XMLUtil::GetCharacterRef.(CVE-2024-50614)\n\nTinyXML2 through 10.0.0 has a reachable assertion for UINT_MAX/digit, that may lead to application exit, in tinyxml2.cpp XMLUtil::GetCharacterRef.(CVE-2024-50615)","affected":[{"package":{"name":"tinyxml2","ecosystem":"openEuler:24.03-LTS","purl":"pkg:rpm/openEuler/tinyxml2&distro=openEuler-24.03-LTS"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"9.0.0-2.oe2403"}]}],"ecosystem_specific":{"aarch64":["tinyxml2-9.0.0-2.oe2403.aarch64.rpm","tinyxml2-debuginfo-9.0.0-2.oe2403.aarch64.rpm","tinyxml2-debugsource-9.0.0-2.oe2403.aarch64.rpm","tinyxml2-devel-9.0.0-2.oe2403.aarch64.rpm"],"src":["tinyxml2-9.0.0-2.oe2403.src.rpm"],"x86_64":["tinyxml2-9.0.0-2.oe2403.x86_64.rpm","tinyxml2-debuginfo-9.0.0-2.oe2403.x86_64.rpm","tinyxml2-debugsource-9.0.0-2.oe2403.x86_64.rpm","tinyxml2-devel-9.0.0-2.oe2403.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1282.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1282"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2024-50614"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2024-50615"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H"}]}