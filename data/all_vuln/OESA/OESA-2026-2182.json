{"schema_version":"1.9.0","id":"OESA-2026-2182","published":"2026-05-03T11:11:10Z","modified":"2026-08-18T01:19:56.645003152Z","upstream":["CVE-2026-40354"],"summary":"xdg-desktop-portal security update","details":"xdg-desktop-portal works by exposing a series of D-Bus interfaces known as portals under a well-known name (org.freedesktop.portal.Desktop) and object path (/org/freedesktop/portal/desktop). The portal interfaces include APIs for file access, opening URIs, printing and others.\r\n\r\nSecurity Fix(es):\n\nFlatpak xdg-desktop-portal before 1.20.4 and 1.21.x before 1.21.1 allows any Flatpak app to trash any file in the host context via a symlink attack on g_file_trash.(CVE-2026-40354)","affected":[{"package":{"name":"xdg-desktop-portal","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/xdg-desktop-portal&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.20.4-1.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["xdg-desktop-portal-1.20.4-1.oe2403sp1.aarch64.rpm","xdg-desktop-portal-debuginfo-1.20.4-1.oe2403sp1.aarch64.rpm","xdg-desktop-portal-debugsource-1.20.4-1.oe2403sp1.aarch64.rpm","xdg-desktop-portal-devel-1.20.4-1.oe2403sp1.aarch64.rpm"],"src":["xdg-desktop-portal-1.20.4-1.oe2403sp1.src.rpm"],"x86_64":["xdg-desktop-portal-1.20.4-1.oe2403sp1.x86_64.rpm","xdg-desktop-portal-debuginfo-1.20.4-1.oe2403sp1.x86_64.rpm","xdg-desktop-portal-debugsource-1.20.4-1.oe2403sp1.x86_64.rpm","xdg-desktop-portal-devel-1.20.4-1.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2182.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2182"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-40354"}],"database_specific":{"severity":"Low"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:L"}]}