{"schema_version":"1.9.0","id":"OESA-2026-2680","published":"2026-06-12T11:11:36Z","modified":"2026-08-18T01:20:05.644466200Z","upstream":["CVE-2026-50219"],"summary":"expat security update","details":"expat is a stream-oriented XML parser library written in C. expat excels with files too large to fit RAM, and where performance and flexibility are crucial.\r\n\r\nSecurity Fix(es):\n\nlibexpat before 2.8.2 lacks handler call depth tracking for calls to XML_GetBuffer, XML_Parse, XML_ParseBuffer, XML_ParserFree, or XML_ParserReset from within handlers in cases of a policy violation. Thus, a use-after-free can occur,(CVE-2026-50219)","affected":[{"package":{"name":"expat","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/expat&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.2.9-26.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["expat-2.2.9-26.oe2003sp4.aarch64.rpm","expat-debuginfo-2.2.9-26.oe2003sp4.aarch64.rpm","expat-debugsource-2.2.9-26.oe2003sp4.aarch64.rpm","expat-devel-2.2.9-26.oe2003sp4.aarch64.rpm"],"noarch":["expat-help-2.2.9-26.oe2003sp4.noarch.rpm"],"src":["expat-2.2.9-26.oe2003sp4.src.rpm"],"x86_64":["expat-2.2.9-26.oe2003sp4.x86_64.rpm","expat-debuginfo-2.2.9-26.oe2003sp4.x86_64.rpm","expat-debugsource-2.2.9-26.oe2003sp4.x86_64.rpm","expat-devel-2.2.9-26.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2680.json"}},{"package":{"name":"expat","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/expat&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.4.1-25.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["expat-2.4.1-25.oe2203sp4.aarch64.rpm","expat-debuginfo-2.4.1-25.oe2203sp4.aarch64.rpm","expat-debugsource-2.4.1-25.oe2203sp4.aarch64.rpm","expat-devel-2.4.1-25.oe2203sp4.aarch64.rpm"],"noarch":["expat-help-2.4.1-25.oe2203sp4.noarch.rpm"],"src":["expat-2.4.1-25.oe2