{"schema_version":"1.9.0","id":"OESA-2026-1574","published":"2026-03-15T11:10:34Z","modified":"2026-08-18T01:19:37.158163807Z","upstream":["CVE-2026-23865"],"summary":"freetype security update","details":"FreeType is written in C, designed to be small,efficient, highly customizable, and portable while capable of producing high-quality output (glyph images) of most vector and bitmap font formats\r\n\r\nSecurity Fix(es):\n\nAn integer overflow in the tt_var_load_item_variation_store function of the Freetype library in versions 2.13.2 and 2.13.3 may allow for an out of bounds read operation when parsing HVAR/VVAR/MVAR tables in OpenType variable fonts. This issue is fixed in version 2.14.2.(CVE-2026-23865)","affected":[{"package":{"name":"freetype","ecosystem":"openEuler:24.03-LTS","purl":"pkg:rpm/openEuler/freetype&distro=openEuler-24.03-LTS"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.13.2-5.oe2403"}]}],"ecosystem_specific":{"aarch64":["freetype-2.13.2-5.oe2403.aarch64.rpm","freetype-debuginfo-2.13.2-5.oe2403.aarch64.rpm","freetype-debugsource-2.13.2-5.oe2403.aarch64.rpm","freetype-demos-2.13.2-5.oe2403.aarch64.rpm","freetype-devel-2.13.2-5.oe2403.aarch64.rpm"],"noarch":["freetype-help-2.13.2-5.oe2403.noarch.rpm"],"src":["freetype-2.13.2-5.oe2403.src.rpm"],"x86_64":["freetype-2.13.2-5.oe2403.x86_64.rpm","freetype-debuginfo-2.13.2-5.oe2403.x86_64.rpm","freetype-debugsource-2.13.2-5.oe2403.x86_64.rpm","freetype-demos-2.13.2-5.oe2403.x86_64.rpm","freetype-devel-2.13.2-5.oe2403.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1574.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1574"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-23865"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:L/I:L/A:L"}]}