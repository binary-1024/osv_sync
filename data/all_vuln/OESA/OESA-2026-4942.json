{"schema_version":"1.9.2","id":"OESA-2026-4942","published":"2026-11-19T01:43:18Z","modified":"2026-11-19T02:00:18.745832002Z","upstream":["CVE-2026-3099"],"summary":"libsoup security update","details":"libsoup is an HTTP client/server library for GNOME. It uses GObjects and the glib main loop, to integrate well with GNOME applications, and also has a synchronous API, for use in threaded applications.\r\n\r\nSecurity Fix(es):\n\nlibsoup library has a replay attack vulnerability in HTTP digest authentication handling, allowing attackers to bypass authentication mechanisms. This vulnerability involves CWE-323 type security issues.(CVE-2026-3099)","affected":[{"package":{"name":"libsoup","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/libsoup&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.74.3-32.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["libsoup-2.74.3-32.oe2403sp4.aarch64.rpm","libsoup-debuginfo-2.74.3-32.oe2403sp4.aarch64.rpm","libsoup-debugsource-2.74.3-32.oe2403sp4.aarch64.rpm","libsoup-devel-2.74.3-32.oe2403sp4.aarch64.rpm"],"noarch":["libsoup-help-2.74.3-32.oe2403sp4.noarch.rpm"],"src":["libsoup-2.74.3-32.oe2403sp4.src.rpm"],"x86_64":["libsoup-2.74.3-32.oe2403sp4.x86_64.rpm","libsoup-debuginfo-2.74.3-32.oe2403sp4.x86_64.rpm","libsoup-debugsource-2.74.3-32.oe2403sp4.x86_64.rpm","libsoup-devel-2.74.3-32.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4942.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4942"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-3099"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:L/I:L/A:L"}]}