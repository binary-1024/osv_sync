{"schema_version":"1.9.2","id":"OESA-2026-4756","published":"2026-11-11T12:25:51Z","modified":"2026-11-11T12:45:06.205801515Z","upstream":["CVE-2025-71436"],"summary":"raptor2 security update","details":"Raptor is Redland&amp;apos;s RDF parser toolkit, which provides a set of independent RDF parsers to generate triples from RDF / XML or N-Triples.\r\n\r\nSecurity Fix(es):\n\nRaptor RDF Syntax Library from 2.0.15 through 2.0.16 contains a heap-based buffer overflow vulnerability in raptor_new_term_from_counted_literal() caused by truncating language tag length to an unsigned char. Attackers can supply Turtle, TriG, N-Triples or N-Quads documents with language tags of 256 bytes or longer to corrupt heap memory, crash applications, and possibly execute code.(CVE-2025-71436)","affected":[{"package":{"name":"raptor2","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/raptor2&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.0.15-22.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["raptor2-2.0.15-22.oe2403sp1.aarch64.rpm","raptor2-debuginfo-2.0.15-22.oe2403sp1.aarch64.rpm","raptor2-debugsource-2.0.15-22.oe2403sp1.aarch64.rpm","raptor2-devel-2.0.15-22.oe2403sp1.aarch64.rpm","raptor2-help-2.0.15-22.oe2403sp1.aarch64.rpm"],"src":["raptor2-2.0.15-22.oe2403sp1.src.rpm"],"x86_64":["raptor2-2.0.15-22.oe2403sp1.x86_64.rpm","raptor2-debuginfo-2.0.15-22.oe2403sp1.x86_64.rpm","raptor2-debugsource-2.0.15-22.oe2403sp1.x86_64.rpm","raptor2-devel-2.0.15-22.oe2403sp1.x86_64.rpm","raptor2-help-2.0.15-22.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4756.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4756"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2025-71436"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/A