{"schema_version":"1.9.0","id":"OESA-2026-2537","published":"2026-05-29T11:11:29Z","modified":"2026-08-18T01:20:01.770110177Z","upstream":["CVE-2026-5119"],"summary":"libsoup3 security update","details":"Libsoup is an HTTP library implementation in C. It was originally part of a SOAP (Simple Object Access Protocol) implementation called Soup, but the SOAP and non-SOAP parts have now been split into separate packages.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in libsoup. When establishing HTTPS tunnels through a configured HTTP proxy, sensitive session cookies are transmitted in cleartext within the initial HTTP CONNECT request. A network-positioned attacker or a malicious HTTP proxy can intercept these cookies, leading to potential session hijacking or user impersonation.(CVE-2026-5119)","affected":[{"package":{"name":"libsoup3","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/libsoup3&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.4.5-14.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["libsoup3-3.4.5-14.oe2403sp1.aarch64.rpm","libsoup3-debuginfo-3.4.5-14.oe2403sp1.aarch64.rpm","libsoup3-debugsource-3.4.5-14.oe2403sp1.aarch64.rpm","libsoup3-devel-3.4.5-14.oe2403sp1.aarch64.rpm"],"noarch":["libsoup3-help-3.4.5-14.oe2403sp1.noarch.rpm"],"src":["libsoup3-3.4.5-14.oe2403sp1.src.rpm"],"x86_64":["libsoup3-3.4.5-14.oe2403sp1.x86_64.rpm","libsoup3-debuginfo-3.4.5-14.oe2403sp1.x86_64.rpm","libsoup3-debugsource-3.4.5-14.oe2403sp1.x86_64.rpm","libsoup3-devel-3.4.5-14.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2537.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2537"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-5119"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:L/A:N"}]}