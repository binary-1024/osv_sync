{"schema_version":"1.9.0","id":"OESA-2026-2678","published":"2026-06-12T11:11:36Z","modified":"2026-08-18T01:20:05.335514925Z","upstream":["CVE-2026-42496"],"summary":"perl-Archive-Tar security update","details":"archive::Tar provides an object oriented mechanism for handling tar files. It provides class methods for quick and easy files handling while also allowing for the creation of tar file objects for custom manipulation. If you have the IO::Zlib module installed, Archive::Tar will also support compressed or gzipped tar files.\r\n\r\nSecurity Fix(es):\n\nArchive::Tar versions before 3.08 for Perl extract symlinks with attacker controlled targets outside the extraction directory.\n\n_make_special_file() passes the tar header&apos;s linkname to symlink() without validating it against absolute paths or .. segments. The secure-extract mode check that guards regular file extraction does not cover the symlink target.\n\nA subsequent open through the extracted name reads or writes the attacker chosen path.(CVE-2026-42496)","affected":[{"package":{"name":"perl-Archive-Tar","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/perl-Archive-Tar&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.02-3.oe2403sp1"}]}],"ecosystem_specific":{"noarch":["perl-Archive-Tar-3.02-3.oe2403sp1.noarch.rpm","perl-Archive-Tar-help-3.02-3.oe2403sp1.noarch.rpm"],"src":["perl-Archive-Tar-3.02-3.oe2403sp1.src.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2678.json"}},{"package":{"name":"perl-Archive-Tar","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/perl-Archive-Tar&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.02-3.oe2403sp3"}]}],"ecosystem_specific":{"noarch":["perl-Archive-Tar-3.02-3.oe2403sp3.noarch.rpm","perl-Archive-Tar-help-3.02-3.oe2403sp3.noarch.rpm"],"src":["perl-Archive-Tar-3.02-3.oe2403sp3.src.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2678.json"}},{"package":{"name":"perl-Archive-Tar","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/perl-Archive-Tar&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.38-2.oe2003sp4"}]}],"ecosystem_specific":{"noarch":["perl-Archive-Tar-2.38-2.oe2003sp4.noarch.rpm","perl-Archive-Tar-help-2.38-2.oe2003sp4.noarch.rpm"],"src":["perl-Archive-Tar-2.38-2.oe2003sp4.src.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2678.json"}},{"package":{"name":"perl-Archive-Tar","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/perl-Archive-Tar&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.40-4.oe2203sp4"}]}],"ecosystem_specific":{"noarch":["perl-Archive-Tar-2.40-4.oe2203sp4.noarch.rpm","perl-Archive-Tar-help-2.40-4.oe2203sp4.noarch.rpm"],"src":["perl-Archive-Tar-2.40-4.oe2203sp4.src.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2678.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2678"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-42496"}],"database_specific":{"severity":"Critical"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N"}]}