{"schema_version":"1.9.0","id":"OESA-2026-4178","published":"2026-09-30T13:47:20Z","modified":"2026-10-01T02:00:06.074521663Z","upstream":["CVE-2026-93990"],"summary":"expat security update","details":"expat is a stream-oriented XML parser library written in C. expat excels with files too large to fit RAM, and where performance and flexibility are crucial.\r\n\r\nSecurity Fix(es):\n\nExpat through 2.8.4 fails to validate low surrogates following high surrogates in UTF-16 input, allowing malformed UTF-16 sequences to be accepted. Attackers can craft UTF-16 encoded XML with lone high surrogates that consume following code units, hiding markup characters from the parser and enabling XML injection attacks.(CVE-2026-93990)","affected":[{"package":{"name":"expat","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/expat&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.8.1-9.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["expat-2.8.1-9.oe2403sp4.aarch64.rpm","expat-debuginfo-2.8.1-9.oe2403sp4.aarch64.rpm","expat-debugsource-2.8.1-9.oe2403sp4.aarch64.rpm","expat-devel-2.8.1-9.oe2403sp4.aarch64.rpm"],"noarch":["expat-help-2.8.1-9.oe2403sp4.noarch.rpm"],"src":["expat-2.8.1-9.oe2403sp4.src.rpm"],"x86_64":["expat-2.8.1-9.oe2403sp4.x86_64.rpm","expat-debuginfo-2.8.1-9.oe2403sp4.x86_64.rpm","expat-debugsource-2.8.1-9.oe2403sp4.x86_64.rpm","expat-devel-2.8.1-9.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4178.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4178"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-93990"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S: