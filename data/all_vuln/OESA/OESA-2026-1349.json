{"schema_version":"1.9.0","id":"OESA-2026-1349","published":"2026-02-13T11:10:22Z","modified":"2026-08-18T01:19:33.003208693Z","upstream":["CVE-2024-50614","CVE-2024-50615"],"summary":"tinyxml2 security update","details":"TinyXML-2 is a simple, small, efficient, C++ XML parser that can be easily integrated into other programs.  TinyXML-2 parses an XML document, and builds  from that a Document Object Model (DOM) that can be read, modified, and saved.\r\n\r\nSecurity Fix(es):\n\nTinyXML2 through 10.0.0 has a reachable assertion for UINT_MAX/16, that may lead to application exit, in tinyxml2.cpp XMLUtil::GetCharacterRef.(CVE-2024-50614)\n\nTinyXML2 through 10.0.0 has a reachable assertion for UINT_MAX/digit, that may lead to application exit, in tinyxml2.cpp XMLUtil::GetCharacterRef.(CVE-2024-50615)","affected":[{"package":{"name":"tinyxml2","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/tinyxml2&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"6.0.0-6.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["tinyxml2-6.0.0-6.oe2203sp4.aarch64.rpm","tinyxml2-debuginfo-6.0.0-6.oe2203sp4.aarch64.rpm","tinyxml2-debugsource-6.0.0-6.oe2203sp4.aarch64.rpm","tinyxml2-devel-6.0.0-6.oe2203sp4.aarch64.rpm"],"src":["tinyxml2-6.0.0-6.oe2203sp4.src.rpm"],"x86_64":["tinyxml2-6.0.0-6.oe2203sp4.x86_64.rpm","tinyxml2-debuginfo-6.0.0-6.oe2203sp4.x86_64.rpm","tinyxml2-debugsource-6.0.0-6.oe2203sp4.x86_64.rpm","tinyxml2-devel-6.0.0-6.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1349.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1349"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2024-50614"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2024-50615"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV: