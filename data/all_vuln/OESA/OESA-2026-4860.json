{"schema_version":"1.9.2","id":"OESA-2026-4860","published":"2026-11-11T12:26:57Z","modified":"2026-11-11T12:45:09.653723488Z","upstream":["CVE-2026-109828"],"summary":"libsndfile security update","details":"Libsndfile is a C library for reading and writing files containing sampled sound such as MS Windows WAV and the Apple/SGI AIFF format through one standard library interface.\r\n\r\nSecurity Fix(es):\n\nA vulnerability was found in libsndfile up to 1.2.2. This issue affects the function wavlike_subchunk_parse of the file src/wavlike.c of the component WAV Parsing. Performing a manipulation results in use of uninitialized variable. Remote exploitation of the attack is possible. The exploit has been made public and could be used. The project was informed of the problem early through an issue report but has not responded yet.(CVE-2026-109828)","affected":[{"package":{"name":"libsndfile","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/libsndfile&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.2.2-8.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["libsndfile-1.2.2-8.oe2403sp1.aarch64.rpm","libsndfile-debuginfo-1.2.2-8.oe2403sp1.aarch64.rpm","libsndfile-debugsource-1.2.2-8.oe2403sp1.aarch64.rpm","libsndfile-devel-1.2.2-8.oe2403sp1.aarch64.rpm","libsndfile-utils-1.2.2-8.oe2403sp1.aarch64.rpm"],"noarch":["libsndfile-utils-help-1.2.2-8.oe2403sp1.noarch.rpm"],"src":["libsndfile-1.2.2-8.oe2403sp1.src.rpm"],"x86_64":["libsndfile-1.2.2-8.oe2403sp1.x86_64.rpm","libsndfile-debuginfo-1.2.2-8.oe2403sp1.x86_64.rpm","libsndfile-debugsource-1.2.2-8.oe2403sp1.x86_64.rpm","libsndfile-devel-1.2.2-8.oe2403sp1.x86_64.rpm","libsndfile-utils-1.2.2-8.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4860.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4860"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-109828"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:L/I:N/A:N"}]}