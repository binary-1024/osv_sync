{"schema_version":"1.9.2","id":"OESA-2026-4797","published":"2026-11-11T12:26:15Z","modified":"2026-11-11T12:45:07.198939132Z","upstream":["CVE-2026-11573"],"summary":"qt security update","details":"Qt (pronounced as &amp;quot;cute&amp;quot;, not &amp;quot;cu-tee&amp;quot;) is a cross-platform framework that is usually used as a graphical toolkit, although it is also very helpful in creating CLI applications. It runs on the three major desktop OSes, as well as on mobile OSes, such as Symbian, Nokia Belle, Meego Harmattan, MeeGo or BB10, and on embedded devices. Ports for Android (Necessitas) and iOS are also in development\r\n\r\nSecurity Fix(es):\n\nUncontrolled recursion in Qt&apos;s QDomDocument serialization (QtXml) lets deeply nested untrusted XML crash the app via stack exhaustion (DoS only).(CVE-2026-11573)","affected":[{"package":{"name":"qt","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/qt&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.8.7-60.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["qt-4.8.7-60.oe2203sp4.aarch64.rpm","qt-debuginfo-4.8.7-60.oe2203sp4.aarch64.rpm","qt-debugsource-4.8.7-60.oe2203sp4.aarch64.rpm","qt-devel-4.8.7-60.oe2203sp4.aarch64.rpm"],"src":["qt-4.8.7-60.oe2203sp4.src.rpm"],"x86_64":["qt-4.8.7-60.oe2203sp4.x86_64.rpm","qt-debuginfo-4.8.7-60.oe2203sp4.x86_64.rpm","qt-debugsource-4.8.7-60.oe2203sp4.x86_64.rpm","qt-devel-4.8.7-60.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4797.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4797"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-11573"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA: