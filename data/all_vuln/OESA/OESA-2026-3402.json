{"schema_version":"1.9.0","id":"OESA-2026-3402","published":"2026-08-13T14:02:58Z","modified":"2026-08-16T01:45:20.615801445Z","upstream":["CVE-2025-6032"],"summary":"podman security update","details":"Podman manages the entire container ecosystem which includes pods, containers, container images, and container volumes using the libpod library.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in Podman. The podman machine init command fails to verify the TLS certificate when downloading the VM images from an OCI registry. This issue results in a Man In The Middle attack.(CVE-2025-6032)","affected":[{"package":{"name":"podman","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/podman&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.9.4-19.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["podman-4.9.4-19.oe2403sp1.aarch64.rpm","podman-debuginfo-4.9.4-19.oe2403sp1.aarch64.rpm","podman-debugsource-4.9.4-19.oe2403sp1.aarch64.rpm","podman-gvproxy-4.9.4-19.oe2403sp1.aarch64.rpm","podman-plugins-4.9.4-19.oe2403sp1.aarch64.rpm","podman-remote-4.9.4-19.oe2403sp1.aarch64.rpm","podman-tests-4.9.4-19.oe2403sp1.aarch64.rpm","podmansh-4.9.4-19.oe2403sp1.aarch64.rpm"],"noarch":["podman-docker-4.9.4-19.oe2403sp1.noarch.rpm","podman-help-4.9.4-19.oe2403sp1.noarch.rpm"],"src":["podman-4.9.4-19.oe2403sp1.src.rpm"],"x86_64":["podman-4.9.4-19.oe2403sp1.x86_64.rpm","podman-debuginfo-4.9.4-19.oe2403sp1.x86_64.rpm","podman-debugsource-4.9.4-19.oe2403sp1.x86_64.rpm","podman-gvproxy-4.9.4-19.oe2403sp1.x86_64.rpm","podman-plugins-4.9.4-19.oe2403sp1.x86_64.rpm","podman-remote-4.9.4-19.oe2403sp1.x86_64.rpm","podman-tests-4.9.4-19.oe2403sp1.x86_64.rpm","podmansh-4.9.4-19.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3402.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3402"},{"type":"AD