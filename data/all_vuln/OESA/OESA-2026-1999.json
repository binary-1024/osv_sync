{"schema_version":"1.9.0","id":"OESA-2026-1999","published":"2026-04-25T11:11:00Z","modified":"2026-08-18T01:19:44.456934586Z","upstream":["CVE-2026-35535"],"summary":"sudo security update","details":"Sudo is a program designed to allow a sysadmin to give limited root privileges to users and log root activity.  The basic philosophy is to give as few privileges as possible but still allow people to get their work done.\r\n\r\nSecurity Fix(es):\n\nIn Sudo through 1.9.17p2 before 3e474c2, a failure of a setuid, setgid, or setgroups call, during a privilege drop before running the mailer, is not a fatal error and can lead to privilege escalation.(CVE-2026-35535)","affected":[{"package":{"name":"sudo","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/sudo&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.9.2-19.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["sudo-1.9.2-19.oe2003sp4.aarch64.rpm","sudo-debuginfo-1.9.2-19.oe2003sp4.aarch64.rpm","sudo-debugsource-1.9.2-19.oe2003sp4.aarch64.rpm","sudo-devel-1.9.2-19.oe2003sp4.aarch64.rpm"],"noarch":["sudo-help-1.9.2-19.oe2003sp4.noarch.rpm"],"src":["sudo-1.9.2-19.oe2003sp4.src.rpm"],"x86_64":["sudo-1.9.2-19.oe2003sp4.x86_64.rpm","sudo-debuginfo-1.9.2-19.oe2003sp4.x86_64.rpm","sudo-debugsource-1.9.2-19.oe2003sp4.x86_64.rpm","sudo-devel-1.9.2-19.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1999.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1999"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-35535"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H"}]}