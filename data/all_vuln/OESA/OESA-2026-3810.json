{"schema_version":"1.9.0","id":"OESA-2026-3810","published":"2026-09-14T16:34:35Z","modified":"2026-09-13T16:45:40.731653855Z","upstream":["CVE-2026-6390"],"summary":"nano security update","details":"Nano is a tiny GNU editor\r\n\r\nSecurity Fix(es):\n\nA flaw was found in GNU nano&apos;s multi-buffer error message handling. When a user opens multiple files at startup and one triggers an ALERT-level error, a specially crafted filename containing printf format specifiers can be reinterpreted. This format string vulnerability may allow an attacker to achieve stack information disclosure, cause a denial of service (crash), or potentially perform arbitrary memory writes.(CVE-2026-6390)","affected":[{"package":{"name":"nano","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/nano&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"8.0-2.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["nano-8.0-2.oe2003sp4.aarch64.rpm","nano-debuginfo-8.0-2.oe2003sp4.aarch64.rpm","nano-debugsource-8.0-2.oe2003sp4.aarch64.rpm"],"noarch":["nano-help-8.0-2.oe2003sp4.noarch.rpm"],"src":["nano-8.0-2.oe2003sp4.src.rpm"],"x86_64":["nano-8.0-2.oe2003sp4.x86_64.rpm","nano-debuginfo-8.0-2.oe2003sp4.x86_64.rpm","nano-debugsource-8.0-2.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3810.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3810"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-6390"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:U/C:L/I:H/A:H"}]}