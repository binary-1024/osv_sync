{"schema_version":"1.9.0","id":"OESA-2026-4388","published":"2026-10-16T12:00:04Z","modified":"2026-10-16T12:15:14.602936385Z","upstream":["CVE-2026-12547"],"summary":"libsoup security update","details":"libsoup is an HTTP client/server library for GNOME. It uses GObjects and the glib main loop, to integrate well with GNOME applications, and also has a synchronous API, for use in threaded applications.\r\n\r\nSecurity Fix(es):\n\nSoupAuthManager caches proxy authentication credentials without scoping them to the proxy authority (host:port). When the proxy configuration changes (e.g., via system settings or WPAD), cached Proxy-Authorization headers from the previous proxy are sent to the new proxy, leaking credentials.(CVE-2026-12547)","affected":[{"package":{"name":"libsoup","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/libsoup&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.74.2-25.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["libsoup-2.74.2-25.oe2203sp4.aarch64.rpm","libsoup-debuginfo-2.74.2-25.oe2203sp4.aarch64.rpm","libsoup-debugsource-2.74.2-25.oe2203sp4.aarch64.rpm","libsoup-devel-2.74.2-25.oe2203sp4.aarch64.rpm"],"noarch":["libsoup-help-2.74.2-25.oe2203sp4.noarch.rpm"],"src":["libsoup-2.74.2-25.oe2203sp4.src.rpm"],"x86_64":["libsoup-2.74.2-25.oe2203sp4.x86_64.rpm","libsoup-debuginfo-2.74.2-25.oe2203sp4.x86_64.rpm","libsoup-debugsource-2.74.2-25.oe2203sp4.x86_64.rpm","libsoup-devel-2.74.2-25.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4388.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4388"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-12547"}],"database_specific":{"severity":"Low"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:H/UI:R/S:C/C:L/I:N/A:N"}]}