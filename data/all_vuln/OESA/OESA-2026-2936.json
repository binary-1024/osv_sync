{"schema_version":"1.9.0","id":"OESA-2026-2936","published":"2026-07-09T11:11:50Z","modified":"2026-08-18T01:21:16.980275322Z","upstream":["CVE-2026-57962","CVE-2026-57963"],"summary":"thunderbird security update","details":"Mozilla Thunderbird is a standalone mail and newsgroup client.\r\n\r\nSecurity Fix(es):\n\nA malicious LDAP server, which a Thunderbird user is configured to query for address-book autocomplete, can stash arbitrarily large amounts of attacker-supplied data into the Thunderbird LDAP client until it crashes due to memory exhaustion. This vulnerability was fixed in Thunderbird 152.0.1 and Thunderbird 140.12.1.(CVE-2026-57962)\n\nAn attacker who can send HTML chat messages (via Matrix or XMPP) can inject arbitrary styled content, phishing links, and CSS that manipulates the chat UI. This vulnerability was fixed in Thunderbird 152.0.1 and Thunderbird 140.12.1.(CVE-2026-57963)","affected":[{"package":{"name":"thunderbird","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/thunderbird&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"140.12.1-1.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["thunderbird-140.12.1-1.oe2403sp3.aarch64.rpm","thunderbird-debuginfo-140.12.1-1.oe2403sp3.aarch64.rpm","thunderbird-debugsource-140.12.1-1.oe2403sp3.aarch64.rpm","thunderbird-librnp-rnp-140.12.1-1.oe2403sp3.aarch64.rpm","thunderbird-wayland-140.12.1-1.oe2403sp3.aarch64.rpm"],"src":["thunderbird-140.12.1-1.oe2403sp3.src.rpm"],"x86_64":["thunderbird-140.12.1-1.oe2403sp3.x86_64.rpm","thunderbird-debuginfo-140.12.1-1.oe2403sp3.x86_64.rpm","thunderbird-debugsource-140.12.1-1.oe2403sp3.x86_64.rpm","thunderbird-librnp-rnp-140.12.1-1.oe2403sp3.x86_64.rpm","thunderbird-wayland-140.12.1-1.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2936.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2936"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-57962"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-57963"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:N"}]}