{"schema_version":"1.9.0","id":"OESA-2026-4375","published":"2026-10-16T11:59:55Z","modified":"2026-10-16T12:15:13.593538426Z","upstream":["CVE-2026-82522"],"summary":"jpegxl security update","details":"This package contains a reference implementation of JPEG XL (encoder and decoder).\r\n\r\nSecurity Fix(es):\n\nlibjxl before 0.12 contains an integer underflow vulnerability in the container box parser that allows remote attackers to inject arbitrary metadata by exploiting 64-bit box size truncation to size_t on 32-bit platforms. Attackers can supply a crafted JPEG XL file causing the decoder to parse attacker-controlled codestream bytes as phantom box headers, enabling injection of arbitrary metadata (Exif, XMP, IPTC, JUMBF) and potential out-of-bounds reads.(CVE-2026-82522)","affected":[{"package":{"name":"jpegxl","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/jpegxl&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.11.2-5.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["jpegxl-debuginfo-0.11.2-5.oe2403sp4.aarch64.rpm","jpegxl-debugsource-0.11.2-5.oe2403sp4.aarch64.rpm","jxl-pixbuf-loader-0.11.2-5.oe2403sp4.aarch64.rpm","libjxl-0.11.2-5.oe2403sp4.aarch64.rpm","libjxl-devel-0.11.2-5.oe2403sp4.aarch64.rpm","libjxl-devtools-0.11.2-5.oe2403sp4.aarch64.rpm","libjxl-utils-0.11.2-5.oe2403sp4.aarch64.rpm"],"noarch":["jpegxl-doc-0.11.2-5.oe2403sp4.noarch.rpm"],"src":["jpegxl-0.11.2-5.oe2403sp4.src.rpm"],"x86_64":["jpegxl-debuginfo-0.11.2-5.oe2403sp4.x86_64.rpm","jpegxl-debugsource-0.11.2-5.oe2403sp4.x86_64.rpm","jxl-pixbuf-loader-0.11.2-5.oe2403sp4.x86_64.rpm","libjxl-0.11.2-5.oe2403sp4.x86_64.rpm","libjxl-devel-0.11.2-5.oe2403sp4.x86_64.rpm","libjxl-devtools-0.11.2-5.oe2403sp4.x86_64.rpm","libjxl-utils-0.11.2-5.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4375.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4375"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-82522"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:L/I:L/A:N"}]}