{"schema_version":"1.9.0","id":"OESA-2026-2716","published":"2026-06-24T11:11:38Z","modified":"2026-08-18T01:20:06.312274362Z","upstream":["CVE-2025-32049"],"summary":"libsoup security update","details":"libsoup is an HTTP client/server library for GNOME. It uses GObjects and the glib main loop, to integrate well with GNOME applications, and also has a synchronous API, for use in threaded applications.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in libsoup. The SoupWebsocketConnection may accept a large WebSocket message, which may cause libsoup to allocate memory and lead to a denial of service (DoS).(CVE-2025-32049)","affected":[{"package":{"name":"libsoup","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/libsoup&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.71.0-18.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["libsoup-2.71.0-18.oe2003sp4.aarch64.rpm","libsoup-debuginfo-2.71.0-18.oe2003sp4.aarch64.rpm","libsoup-debugsource-2.71.0-18.oe2003sp4.aarch64.rpm","libsoup-devel-2.71.0-18.oe2003sp4.aarch64.rpm"],"noarch":["libsoup-help-2.71.0-18.oe2003sp4.noarch.rpm"],"src":["libsoup-2.71.0-18.oe2003sp4.src.rpm"],"x86_64":["libsoup-2.71.0-18.oe2003sp4.x86_64.rpm","libsoup-debuginfo-2.71.0-18.oe2003sp4.x86_64.rpm","libsoup-debugsource-2.71.0-18.oe2003sp4.x86_64.rpm","libsoup-devel-2.71.0-18.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2716.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2716"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2025-32049"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"}]}