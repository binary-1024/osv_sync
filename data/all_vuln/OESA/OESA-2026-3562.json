{"schema_version":"1.9.0","id":"OESA-2026-3562","published":"2026-08-30T04:17:38Z","modified":"2026-08-30T04:32:26.867835185Z","upstream":["CVE-2026-33814"],"summary":"buildah security update","details":"The  package provides a command line tool which can be used to * create a working container from scratch or * create a working container from an image as a starting point * mount/umount a working container&amp;apos;s root file system for manipulation * save container&amp;apos;s root file system layer to create a new image * delete a working container or an image\r\n\r\nSecurity Fix(es):\n\nWhen processing HTTP/2 SETTINGS frames, transport will enter an infinite loop of writing CONTINUATION frames if it receives a SETTINGS_MAX_FRAME_SIZE with a value of 0.(CVE-2026-33814)","affected":[{"package":{"name":"buildah","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/buildah&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.34.1-16.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["buildah-1.34.1-16.oe2403sp3.aarch64.rpm","buildah-debuginfo-1.34.1-16.oe2403sp3.aarch64.rpm","buildah-debugsource-1.34.1-16.oe2403sp3.aarch64.rpm","buildah-tests-1.34.1-16.oe2403sp3.aarch64.rpm"],"src":["buildah-1.34.1-16.oe2403sp3.src.rpm"],"x86_64":["buildah-1.34.1-16.oe2403sp3.x86_64.rpm","buildah-debuginfo-1.34.1-16.oe2403sp3.x86_64.rpm","buildah-debugsource-1.34.1-16.oe2403sp3.x86_64.rpm","buildah-tests-1.34.1-16.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3562.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3562"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-33814"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"}]}