{"schema_version":"1.9.2","id":"OESA-2026-4608","published":"2026-10-29T09:03:32Z","modified":"2026-10-29T09:15:39.434923645Z","upstream":["CVE-2026-77119"],"summary":"bind security update","details":"BIND (Berkeley Internet Name Domain) is an implementation of the DNS (Domain Name System) protocols. BIND includes a DNS server (named), which resolves host names to IP addresses; a resolver library (routines for applications to use when interfacing with DNS); and tools for verifying that the DNS server is operating properly.\r\n\r\nSecurity Fix(es):\n\nA validly signed NSEC3 from an unrelated sibling zone may be accepted as an insecurity proof, downgrading a secure delegation and letting a forged unsigned answer through.\nThis issue affects BIND 9 versions 9.11.0 through 9.18.50, 9.20.0 through 9.20.27, 9.21.0 through 9.21.25, 9.11.3-S1 through 9.18.50-S1, and 9.20.9-S1 through 9.20.27-S1.(CVE-2026-77119)","affected":[{"package":{"name":"bind","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/bind&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"9.18.21-15.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["bind-9.18.21-15.oe2403sp1.aarch64.rpm","bind-chroot-9.18.21-15.oe2403sp1.aarch64.rpm","bind-debuginfo-9.18.21-15.oe2403sp1.aarch64.rpm","bind-debugsource-9.18.21-15.oe2403sp1.aarch64.rpm","bind-devel-9.18.21-15.oe2403sp1.aarch64.rpm","bind-dnssec-utils-9.18.21-15.oe2403sp1.aarch64.rpm","bind-libs-9.18.21-15.oe2403sp1.aarch64.rpm","bind-utils-9.18.21-15.oe2403sp1.aarch64.rpm"],"noarch":["bind-dnssec-doc-9.18.21-15.oe2403sp1.noarch.rpm","bind-license-9.18.21-15.oe2403sp1.noarch.rpm"],"src":["bind-9.18.21-15.oe2403sp1.src.rpm"],"x86_64":["bind-9.18.21-15.oe2403sp1.x86_64.rpm","bind-chroot-9.18.21-15.oe2403sp1.x86_64.rpm","bind-debuginfo-9.18.21-15.oe2403sp1.x86_64.rpm","bind-debugsource-9.18.21-15.oe2403sp1.x86_64.rpm","bind-devel-9.18.21-15.oe2403sp1.x86_64.rpm","bind-dnssec-utils-9.18.21-15.oe2403sp1.x86_64.rpm","bind-libs-9.18.21-15.oe2403sp1.x86_64.rpm","bind-utils-9.18.21-15.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-4608.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-4608"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-77119"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:H/A:N"}]}