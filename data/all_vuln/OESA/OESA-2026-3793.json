{"schema_version":"1.9.0","id":"OESA-2026-3793","published":"2026-09-14T16:34:25Z","modified":"2026-09-13T16:45:41.588671944Z","upstream":["CVE-2026-18374"],"summary":"glibc security update","details":"The GNU C Library project provides the core libraries for the GNU system and GNU/Linux systems, as well as many other systems that use Linux as the kernel. These libraries provide critical APIs including ISO C11, POSIX.1-2008, BSD, OS-specific APIs and more. These APIs include such foundational facilities as open, read, write, malloc, printf, getaddrinfo, dlopen, pthread_create, crypt,  login, exit and more.\r\n\r\nSecurity Fix(es):\n\nPassing an effectively empty string to the `,ccs=` syntax extension of the mode argument in the `fopen` function in the GNU C Library version 2.45 or earlier may result in a heap buffer overflow when the mode string input to the function is attacker controlled. This usage pattern is not seen in applications in common GNU/Linux distributions and applications that process user-supplied values for `ccs` should not pass them through without validation.(CVE-2026-18374)","affected":[{"package":{"name":"glibc","ecosystem":"openEuler:20.03-LTS-SP4","purl":"pkg:rpm/openEuler/glibc&distro=openEuler-20.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.28-132.oe2003sp4"}]}],"ecosystem_specific":{"aarch64":["glibc-2.28-132.oe2003sp4.aarch64.rpm","glibc-all-langpacks-2.28-132.oe2003sp4.aarch64.rpm","glibc-benchtests-2.28-132.oe2003sp4.aarch64.rpm","glibc-common-2.28-132.oe2003sp4.aarch64.rpm","glibc-compat-2.17-2.28-132.oe2003sp4.aarch64.rpm","glibc-debuginfo-2.28-132.oe2003sp4.aarch64.rpm","glibc-debugsource-2.28-132.oe2003sp4.aarch64.rpm","glibc-debugutils-2.28-132.oe2003sp4.aarch64.rpm","glibc-devel-2.28-132.oe2003sp4.aarch64.rpm","glibc-locale-source-2.28-132.oe2003sp4.aarch64.rpm","glibc-nss-devel-2.28-132.oe2003sp4.aarch64.rpm","libnsl-2.28-132.oe2003sp4.aarch64.rpm","nscd-2.28-132.oe2003sp4.aarch64.rpm","nss_modules-2.28-132.oe2003sp4.aarch64.rpm"],"noarch":["glibc-help-2.28-132.oe2003sp4.noarch.rpm"],"src":["glibc-2.28-132.oe2003sp4.src.rpm"],"x86_64":["glibc-2.28-132.oe2003sp4.x86_64.rpm","glibc-all-langpacks-2.28-132.oe2003sp4.x86_64.rpm","glibc-benchtests-2.28-132.oe2003sp4.x86_64.rpm","glibc-common-2.28-132.oe2003sp4.x86_64.rpm","glibc-compat-2.17-2.28-132.oe2003sp4.x86_64.rpm","glibc-debuginfo-2.28-132.oe2003sp4.x86_64.rpm","glibc-debugsource-2.28-132.oe2003sp4.x86_64.rpm","glibc-debugutils-2.28-132.oe2003sp4.x86_64.rpm","glibc-devel-2.28-132.oe2003sp4.x86_64.rpm","glibc-locale-source-2.28-132.oe2003sp4.x86_64.rpm","glibc-nss-devel-2.28-132.oe2003sp4.x86_64.rpm","libnsl-2.28-132.oe2003sp4.x86_64.rpm","nscd-2.28-132.oe2003sp4.x86_64.rpm","nss_modules-2.28-132.oe2003sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3793.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3793"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-18374"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:L/I:L/A:L"}]}