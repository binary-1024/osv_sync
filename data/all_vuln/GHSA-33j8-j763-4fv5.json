{"schema_version":"1.9.0","id":"GHSA-33j8-j763-4fv5","published":"2026-06-12T12:31:34Z","modified":"2026-08-20T18:45:16.513885545Z","aliases":["CVE-2026-50634"],"summary":"Apache CXF: WS JSON request filter trusts metadata from an unvalidated first signature entry","details":"A vulnerability in Apache CXF's JwsJsonContainerRequestFilter can be exploited to cause CXF to process metadata that was not authenticated by the accepted signature. This can bypass the application's assumption\n\nthat accepted `Content-Type` or protected HTTP-header metadata came from a verified signature entry, and may steer downstream JAX-RS entity parsing or signed-header consistency checks. Users are recommended to upgrade to versions 4.2.2 or 4.1.7, which fix this issue.","affected":[{"package":{"name":"org.apache.cxf:cxf-rt-rs-security-jose-jaxrs","ecosystem":"Maven","purl":"pkg:maven/org.apache.cxf/cxf-rt-rs-security-jose-jaxrs"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"4.2.0"},{"fixed":"4.2.2"}]}],"versions":["4.2.0","4.2.1"],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/06/GHSA-33j8-j763-4fv5/GHSA-33j8-j763-4fv5.json"}},{"package":{"name":"org.apache.cxf:cxf-rt-rs-security-jose-jaxrs","ecosystem":"Maven","purl":"pkg:maven/org.apache.cxf/cxf-rt-rs-security-jose-jaxrs"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.1.7"}]}],"versions":["3.0.10","3.0.11","3.0.12","3.0.13","3.0.14","3.0.15","3.0.16","3.0.7","3.0.8","3.0.9","3.1.10","3.1.11","3.1.12","3.1.13","3.1.14","3.1.15","3.1.16","3.1.17","3.1.18","3.1.4","3.1.5","3.1.6","3.1.7","3.1.8","3.1.9","3.2.0","3.2.1","3.2.10","3.2.11","3.2.12","3.2.13","3.2.14","3.2.2","3.2.3","3.2.4","3.2.5","3.2.6","3.2.7","3.2.8","3.2.9","3.3.0","3.3.1","3.3.10","3.3.11","3.3.12","3.3.13","3.3.2","3.3.3","3.3.4","3.3.5","3.3.6","3.3.7","3.3.8","3.3.9","3.4.0","3.4.1","3.4.10","3.4.2","3.4.3","3.4.4","3.4.5","3.4.6","3.4.7","3.4.8","3.4.9","3.5.0"