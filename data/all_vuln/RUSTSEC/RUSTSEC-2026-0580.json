{"schema_version":"1.9.2","id":"RUSTSEC-2026-0580","published":"2026-11-18T12:00:00Z","modified":"2026-11-19T09:00:04.526645559Z","summary":"The treiber stack implementation in heapless had a race condition","details":"In the affected versions, it was possible for two threads or execution contexts running concurrently to race, causing one to read out of a pointer that had been invalidated by another execution context.\n\nReported by [Jacob Finkelman](https://github.com/Eh2406).","affected":[{"package":{"name":"heapless","ecosystem":"crates.io","purl":"pkg:cargo/heapless"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0.0.0-0"},{"fixed":"0.9.4"}]}],"ecosystem_specific":{"affected_functions":null,"affects":{"arch":[],"functions":["heapless::arc_pool","heapless::box_pool","heapless::object_pool","heapless::pool"],"os":[]}},"database_specific":{"categories":["memory-corruption","thread-safety"],"cvss":null,"informational":"unsound","source":"https://github.com/rustsec/advisory-db/blob/osv/crates/RUSTSEC-2026-0580.json"}}],"references":[{"type":"PACKAGE","url":"https://crates.io/crates/heapless"},{"type":"ADVISORY","url":"https://rustsec.org/advisories/RUSTSEC-2026-0580.html"},{"type":"WEB","url":"https://github.com/rust-embedded/heapless/pull/704"}],"database_specific":{"license":"CC0-1.0"}}