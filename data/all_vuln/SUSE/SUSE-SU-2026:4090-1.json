bing (bsc#1276841).\n- pygrub is only supported in de-privileged mode (bsc#1271947).\n\nNon security issue fixed:\n\n- Xen: Missing upstream bug fixes (bsc#1027519).\n","affected":[{"package":{"name":"xen","ecosystem":"SUSE:Linux Enterprise Module for Basesystem 15 SP7","purl":"pkg:rpm/suse/xen&distro=SUSE%20Linux%20Enterprise%20Module%20for%20Basesystem%2015%20SP7"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.20.4_04-150700.3.46.1"}]}],"ecosystem_specific":{"binaries":[{"xen-libs":"4.20.4_04-150700.3.46.1","xen-tools-domU":"4.20.4_04-150700.3.46.1"}]},"database_specific":{"source":"https://ftp.suse.com/pub/projects/security/osv/SUSE-SU-2026:4090-1.json"}},{"package":{"name":"xen","ecosystem":"SUSE:Linux Enterprise Module for Server Applications 15 SP7","purl":"pkg:rpm/suse/xen&distro=SUSE%20Linux%20Enterprise%20Module%20for%20Server%20Applications%2015%20SP7"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.20.4_04-150700.3.46.1"}]}],"ecosystem_specific":{"binaries":[{"xen":"4.20.4_04-150700.3.46.1","xen-devel":"4.20.4_04-150700.3.46.1","xen-tools":"4.20.4_04-150700.3.46.1","xen-tools-xendomains-wait-disk":"4.20.4_04-150700.3.46.1"}]},"database_specific":{"source":"https://ftp.suse.com/pub/projects/security/osv/SUSE-SU-2026:4090-1.json"}}],"references":[{"type":"ADVISORY","url":"https://www.suse.com/support/update/announcement/2026/suse-su-20264090-1/"},{"type":"REPORT","url":"https://bugzilla.suse.com/1027519"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271528"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271530"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271531"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271532"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271533"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271534"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271535"},{"type":"REPORT","url":"https://bugzilla.suse.com/1271536"},{"type":"REPORT","url":"https://b