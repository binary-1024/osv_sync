{"schema_version":"1.7.5","id":"SUSE-SU-2025:20393-1","published":"2025-06-05T08:36:35Z","modified":"2026-03-23T04:50:48.369934Z","related":["CVE-2025-22868","CVE-2025-22869"],"upstream":["CVE-2025-22868","CVE-2025-22869"],"summary":"Security update for docker","details":"This update for docker fixes the following issues:\n\nAlways clear SUSEConnect suse_* secrets when starting containers regardless\nof whether the daemon was built with SUSEConnect support. Not doing this\ncauses containers from SUSEConnect-enabled daemons to fail to start when\nrunning with SUSEConnect-disabled (i.e. upstream) daemons.\n","affected":[{"package":{"name":"docker","ecosystem":"SUSE:Linux Micro 6.1","purl":"pkg:rpm/suse/docker&distro=SUSE%20Linux%20Micro%206.1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"27.5.1_ce-slfo.1.1_3.1"}]}],"ecosystem_specific":{"binaries":[{"docker":"27.5.1_ce-slfo.1.1_3.1","docker-buildx":"0.22.0-slfo.1.1_3.1"}]},"database_specific":{"source":"https://ftp.suse.com/pub/projects/security/osv/SUSE-SU-2025:20393-1.json"}}],"references":[{"type":"ADVISORY","url":"https://www.suse.com/support/update/announcement/2025/suse-su-202520393-1/"},{"type":"REPORT","url":"https://bugzilla.suse.com/1244035"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2025-22868"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2025-22869"}]}