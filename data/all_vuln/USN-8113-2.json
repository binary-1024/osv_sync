{"schema_version":"1.9.0","id":"USN-8113-2","published":"2026-08-19T07:39:43Z","modified":"2026-08-19T19:30:09.455576338Z","related":["UBUNTU-CVE-2025-61143","UBUNTU-CVE-2025-61144"],"upstream":["CVE-2025-61143","CVE-2025-61144","UBUNTU-CVE-2025-61143","UBUNTU-CVE-2025-61144"],"summary":"tiff vulnerabilities","details":"USN 8113-1 fixed vulnerabilities in tiff. This update\nprovides the corresponding fixes for Ubuntu 26.04 LTS.\n\nOriginal advisory details:\n\n It was discovered that LibTIFF did not properly handle memory when\n processing certain images. An attacker could possibly use this issue to\n cause LibTIFF to crash, resulting in a denial of service. (CVE-2025-61143)\n\n It was discovered that LibTIFF did not properly handle memory when\n processing malformed TIFF directories. An attacker could possibly use this\n issue to cause LibTIFF to crash, resulting in a denial of service.\n (CVE-2025-61144)","affected":[{"package":{"name":"tiff","ecosystem":"Ubuntu:26.04:LTS","purl":"pkg:deb/ubuntu/tiff?arch=source&distro=resolute"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.7.0-3ubuntu5"}]}],"versions":["4.7.0-3ubuntu3","4.7.0-3ubuntu4"],"ecosystem_specific":{"availability":"No subscription required","binaries":[{"binary_name":"libtiff-opengl","binary_version":"4.7.0-3ubuntu5"},{"binary_name":"libtiff-tools","binary_version":"4.7.0-3ubuntu5"},{"binary_name":"libtiff6","binary_version":"4.7.0-3ubuntu5"},{"binary_name":"libtiffxx6","binary_version":"4.7.0-3ubuntu5"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2025-61143","severity":[{"score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H","type":"CVSS_V3"},{"score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H","type":"CVSS_V3"},{"score":"low","type":"Ubuntu"}]},{"id":"CVE-2025-61144","severity":[{"score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"low","type":"Ubuntu"}]}],"ecos