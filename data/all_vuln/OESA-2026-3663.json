{"schema_version":"1.9.0","id":"OESA-2026-3663","published":"2026-09-05T15:03:40Z","modified":"2026-09-05T15:16:35.493092780Z","upstream":["CVE-2026-19685"],"summary":"NetworkManager security update","details":"NetworkManager attempts to keep an active network connection available at all times.  The point of NetworkManager is to make networking configuration and setup as painless and automatic as possible. If using DHCP, NetworkManager is intended to replace default routes, obtain IP addresses from a DHCP server, and change name servers whenever it sees fit.\r\n\r\nSecurity Fix(es):\n\nNetworkManager did not apply the private_user restriction to the 802-1x.ca-path and phase2-ca-path directory-valued connection properties. This incomplete fix for CVE-2025-9615 allows an unprivileged local user to point a private WPA-Enterprise (802.1X) connection profile&apos;s CA path at an attacker-controlled directory, bypassing server certificate validation and enabling credential theft via a rogue access point.(CVE-2026-19685)","affected":[{"package":{"name":"NetworkManager","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/NetworkManager&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.44.2-9.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["NetworkManager-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-bluetooth-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-cloud-setup-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-debuginfo-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-debugsource-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-libnm-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-libnm-devel-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-ppp-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-team-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-wifi-1.44.2-9.oe2403sp3.aarch64.rpm","NetworkManager-wwan-1.44.2-9.oe2403sp3.aarch64.rpm"],"noarch":["NetworkManager-config-server-1.44.2-9.oe2403sp3.noarch.rpm","NetworkManager-help-1.44.2-9.oe2403sp3.noarch.rpm"],"src":["NetworkManager-1.44.2-9.oe2403sp3.src.rpm"],"x86_64":["NetworkManager-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-bluetooth-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-cloud-setup-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-debuginfo-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-debugsource-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-libnm-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-libnm-devel-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-ppp-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-team-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-wifi-1.44.2-9.oe2403sp3.x86_64.rpm","NetworkManager-wwan-1.44.2-9.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3663.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3663"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-19685"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N"}]}