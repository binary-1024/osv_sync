{"schema_version":"1.9.0","id":"OESA-2024-1431","published":"2024-04-12T11:06:52Z","modified":"2026-08-18T01:18:21.151182086Z","upstream":["CVE-2023-0666"],"summary":"wireshark security update","details":"Wireshark is an open source tool for profiling network traffic and analyzing packets. Such a tool is often referred to as a network analyzer, network protocol analyzer or sniffer.\r\n\r\nSecurity Fix(es):\r\n\r\nDue to failure in validating the length provided by an attacker-crafted RTPS packet, Wireshark version 4.0.5 and prior, by default, is susceptible to a heap-based buffer overflow, and possibly code execution in the context of the process running Wireshark.(CVE-2023-0666)","affected":[{"package":{"name":"wireshark","ecosystem":"openEuler:20.03-LTS-SP1","purl":"pkg:rpm/openEuler/wireshark&distro=openEuler-20.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.6.14-7.oe1"}]}],"ecosystem_specific":{"aarch64":["wireshark-debuginfo-3.6.14-7.oe1.aarch64.rpm","wireshark-help-3.6.14-7.oe1.aarch64.rpm","wireshark-devel-3.6.14-7.oe1.aarch64.rpm","wireshark-3.6.14-7.oe1.aarch64.rpm","wireshark-debugsource-3.6.14-7.oe1.aarch64.rpm"],"src":["wireshark-3.6.14-7.oe1.src.rpm"],"x86_64":["wireshark-help-3.6.14-7.oe1.x86_64.rpm","wireshark-devel-3.6.14-7.oe1.x86_64.rpm","wireshark-debuginfo-3.6.14-7.oe1.x86_64.rpm","wireshark-debugsource-3.6.14-7.oe1.x86_64.rpm","wireshark-3.6.14-7.oe1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2024-1431.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/en/security/safety-bulletin/detail.html?id=openEuler-SA-2024-1431"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2023-0666"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H"}]}