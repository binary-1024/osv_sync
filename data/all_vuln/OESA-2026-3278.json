{"schema_version":"1.8.0","id":"OESA-2026-3278","published":"2026-08-07T02:43:18Z","modified":"2026-08-07T03:00:57.959020195Z","upstream":["CVE-2026-59881"],"summary":"python-aiohttp security update","details":"Async http client/server framework (asyncio).\r\n\r\nSecurity Fix(es):\n\nAIOHTTP is an asynchronous HTTP client/server framework for asyncio and Python. Prior to 3.14.2, the WebSocket client accepts and decompresses frames with the RSV1 bit set even when the permessage-deflate extension was not negotiated, allowing a malicious server to cause unexpected CPU and memory consumption. This issue is fixed in version 3.14.2.(CVE-2026-59881)","affected":[{"package":{"name":"python-aiohttp","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/python-aiohttp&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.14.3-1.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["python-aiohttp-debuginfo-3.14.3-1.oe2403sp4.aarch64.rpm","python-aiohttp-debugsource-3.14.3-1.oe2403sp4.aarch64.rpm","python-aiohttp-help-3.14.3-1.oe2403sp4.aarch64.rpm","python3-aiohttp-3.14.3-1.oe2403sp4.aarch64.rpm"],"src":["python-aiohttp-3.14.3-1.oe2403sp4.src.rpm"],"x86_64":["python-aiohttp-debuginfo-3.14.3-1.oe2403sp4.x86_64.rpm","python-aiohttp-debugsource-3.14.3-1.oe2403sp4.x86_64.rpm","python-aiohttp-help-3.14.3-1.oe2403sp4.x86_64.rpm","python3-aiohttp-3.14.3-1.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3278.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3278"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-59881"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:L"}]}