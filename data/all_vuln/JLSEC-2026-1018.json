{"schema_version":"1.7.5","id":"JLSEC-2026-1018","published":"2026-07-30T16:02:27.435Z","modified":"2026-07-30T18:35:40.060991346Z","upstream":["CVE-2026-46692","EUVD-2026-36174","GHSA-p93h-f2jc-477j"],"summary":"ImageMagick: Heap Buffer Over-Write in distributed pixel cache server","details":"ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 6.9.13-48 and 7.1.2-23, an attacker who can connect to a magick -distribute-cache service can cause a heap buffer over-write in the server process. This issue has been patched in versions 6.9.13-48 and 7.1.2-23.","affected":[{"package":{"name":"ImageMagick_jll","ecosystem":"Julia","purl":"pkg:julia/ImageMagick_jll?uuid=c73af94c-d91f-53ed-93a7-00f77d67a9d7"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"7.1.2028+0"}]}],"database_specific":{"source":"https://github.com/JuliaLang/SecurityAdvisories.jl/tree/generated/osv/2026/JLSEC-2026-1018.json"}}],"references":[{"type":"WEB","url":"https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-p93h-f2jc-477j"},{"type":"WEB","url":"https://github.com/advisories/GHSA-p93h-f2jc-477j"}],"database_specific":{"license":"CC-BY-4.0","sources":[{"database_specific":{"status":"Analyzed"},"html_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-46692","id":"CVE-2026-46692","imported":"2026-07-30T14:08:47.410Z","modified":"2026-07-23T09:10:00.113Z","published":"2026-06-10T23:16:47.450Z","url":"https://services.nvd.nist.gov/rest/json/cves/2.0?cveId=CVE-2026-46692"},{"html_url":"https://github.com/advisories/GHSA-p93h-f2jc-477j","id":"GHSA-p93h-f2jc-477j","imported":"2026-07-30T14:10:42.428Z","modified":"2026-06-01T23:53:09Z","published":"2026-05-22T13:10:55Z","url":"https://api.github.com/advisories/GHSA-p93h-f2jc-477j"},{"html_url":"https://euvd.enisa.europa.eu/vulnerability/EUVD-2026-36174","id":"EUVD-2026-36174","imported":"2026-07-30T14:08:53.473Z","modified":"2026-06-11T14:22:06Z","published":"2026-06-1