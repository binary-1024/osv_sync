{"schema_version":"1.9.0","id":"DRUPAL-CONTRIB-2026-003","published":"2026-01-14T17:55:41Z","modified":"2026-09-10T03:45:07.386803616Z","aliases":["CVE-2026-0946"],"details":"This module integrates the AT Internet SmartTag service.\n\nThe module does not filter administrator-entered text leading to a persistent Cross-site Scripting (XSS) vulnerability.\n\nThis vulnerability is mitigated by the fact that an attacker must have a role with the permission \"administer atsmarttag\".","affected":[{"package":{"name":"drupal/atsmarttag","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/atsmarttag?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.0.1"}],"database_specific":{"constraint":"<1.0.1"}}],"database_specific":{"affected_versions":"<1.0.1","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/atsmarttag/DRUPAL-CONTRIB-2026-003.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-003"}],"credits":[{"name":"Pierre Rudloff (prudloff)","contact":["https://www.drupal.org/u/prudloff"]}]}