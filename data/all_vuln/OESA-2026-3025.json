{"schema_version":"1.7.5","id":"OESA-2026-3025","published":"2026-07-19T03:47:59Z","modified":"2026-07-19T04:00:15.672631588Z","upstream":["CVE-2026-53689"],"summary":"libnfs security update","details":"Package contains a library of functions for accessing NFSv2 and NFSv3 servers from user space. It provides a low-level,asynchronous RPC library for accessing NFS protocols, an asynchronous library with POSIX-like VFS functions,and a synchronous library with POSIX-like VFS functions.\r\n\r\nSecurity Fix(es):\n\nlibnfs through 6.0.2 before 55c18ea does not validate a string size, leading to an integer overflow during a connection to a crafted NFS server. This occurs in libnfs_zdr_string in lib/libnfs-zdr.c.(CVE-2026-53689)","affected":[{"package":{"name":"libnfs","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/libnfs&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.11.0-5.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["libnfs-1.11.0-5.oe2203sp4.aarch64.rpm","libnfs-debuginfo-1.11.0-5.oe2203sp4.aarch64.rpm","libnfs-debugsource-1.11.0-5.oe2203sp4.aarch64.rpm","libnfs-devel-1.11.0-5.oe2203sp4.aarch64.rpm","libnfs-help-1.11.0-5.oe2203sp4.aarch64.rpm","libnfs-utils-1.11.0-5.oe2203sp4.aarch64.rpm"],"src":["libnfs-1.11.0-5.oe2203sp4.src.rpm"],"x86_64":["libnfs-1.11.0-5.oe2203sp4.x86_64.rpm","libnfs-debuginfo-1.11.0-5.oe2203sp4.x86_64.rpm","libnfs-debugsource-1.11.0-5.oe2203sp4.x86_64.rpm","libnfs-devel-1.11.0-5.oe2203sp4.x86_64.rpm","libnfs-help-1.11.0-5.oe2203sp4.x86_64.rpm","libnfs-utils-1.11.0-5.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3025.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3025"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-53689"}],"database_specific":{"severity":"High"}}