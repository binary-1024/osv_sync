{"schema_version":"1.9.0","id":"OESA-2026-2539","published":"2026-05-29T11:11:29Z","modified":"2026-08-18T01:20:02.912171192Z","upstream":["CVE-2026-47783","CVE-2026-47784"],"summary":"memcached security update","details":"memcached is a high-performance, distributed memory object caching system, generic in nature, but intended for use in speeding up dynamic web applications by alleviating database load.\r\n\r\nSecurity Fix(es):\n\nIn memcached before 1.6.42, username data for SASL password database authentication has a timing side channel because a loop exits as soon as a valid username is found by sasl_server_userdb_checkpass.(CVE-2026-47783)\n\nIn memcached before 1.6.42, password data for SASL password database authentication has a timing side channel because memcmp is used by sasl_server_userdb_checkpass.(CVE-2026-47784)","affected":[{"package":{"name":"memcached","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/memcached&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.6.22-5.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["memcached-1.6.22-5.oe2403sp1.aarch64.rpm","memcached-debuginfo-1.6.22-5.oe2403sp1.aarch64.rpm","memcached-debugsource-1.6.22-5.oe2403sp1.aarch64.rpm","memcached-devel-1.6.22-5.oe2403sp1.aarch64.rpm","memcached-selinux-1.6.22-5.oe2403sp1.aarch64.rpm"],"noarch":["memcached-help-1.6.22-5.oe2403sp1.noarch.rpm"],"src":["memcached-1.6.22-5.oe2403sp1.src.rpm"],"x86_64":["memcached-1.6.22-5.oe2403sp1.x86_64.rpm","memcached-debuginfo-1.6.22-5.oe2403sp1.x86_64.rpm","memcached-debugsource-1.6.22-5.oe2403sp1.x86_64.rpm","memcached-devel-1.6.22-5.oe2403sp1.x86_64.rpm","memcached-selinux-1.6.22-5.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2539.json"}},{"package":{"name":"memcached","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/memcached&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","ev