{"schema_version":"1.9.0","id":"DRUPAL-CONTRIB-2026-096","published":"2026-08-12T17:54:13Z","modified":"2026-08-12T19:45:03.106861401Z","aliases":["CVE-2026-73478"],"details":"This module enables you to view the differences between revisions on any entity type.\n\nThe module doesn't sufficiently restrict access to non-node entity revision diffs.\n\nThis vulnerability is mitigated by the fact that an attacker must have a role with the permission to view the entity.","affected":[{"package":{"name":"drupal/diff","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/diff?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.0.1"}],"database_specific":{"constraint":"<2.0.1"}},{"type":"ECOSYSTEM","events":[{"introduced":"2.1.0"},{"fixed":"2.1.1"}],"database_specific":{"constraint":">=2.1.0 <2.1.1"}}],"database_specific":{"affected_versions":"<2.0.1 || >=2.1.0 <2.1.1","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/diff/DRUPAL-CONTRIB-2026-096.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-096"}],"credits":[{"name":"Alexei Rayu (alexrayu)","contact":["https://www.drupal.org/u/alexrayu"]}]}