{"schema_version":"1.7.5","id":"OESA-2026-2691","published":"2026-06-24T13:09:41Z","modified":"2026-06-24T13:30:07.586101034Z","upstream":["CVE-2026-6691"],"summary":"mongo-c-driver security update","details":"mongo-c-driver is a project that includes two libraries: libmongoc, a client library written in C for MongoDB. libbson, a library providing useful routines related to building, parsing, and iterating BSON documents.\r\n\r\nSecurity Fix(es):\n\nThe MongoDB C Driver&apos;s Cyrus SASL integration performs unsafe string copying during username canonicalization, enabling a heap buffer overflow before any authentication or network traffic. This may be triggered by passing untrusted input in the username of a MongoDB URI with authMechanism=GSSAPI.(CVE-2026-6691)","affected":[{"package":{"name":"mongo-c-driver","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/mongo-c-driver&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.30.6-3.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["libbson-1.30.6-3.oe2403sp1.aarch64.rpm","libbson-devel-1.30.6-3.oe2403sp1.aarch64.rpm","mongo-c-driver-1.30.6-3.oe2403sp1.aarch64.rpm","mongo-c-driver-debuginfo-1.30.6-3.oe2403sp1.aarch64.rpm","mongo-c-driver-debugsource-1.30.6-3.oe2403sp1.aarch64.rpm","mongo-c-driver-devel-1.30.6-3.oe2403sp1.aarch64.rpm"],"noarch":["mongo-c-driver-help-1.30.6-3.oe2403sp1.noarch.rpm"],"src":["mongo-c-driver-1.30.6-3.oe2403sp1.src.rpm"],"x86_64":["libbson-1.30.6-3.oe2403sp1.x86_64.rpm","libbson-devel-1.30.6-3.oe2403sp1.x86_64.rpm","mongo-c-driver-1.30.6-3.oe2403sp1.x86_64.rpm","mongo-c-driver-debuginfo-1.30.6-3.oe2403sp1.x86_64.rpm","mongo-c-driver-debugsource-1.30.6-3.oe2403sp1.x86_64.rpm","mongo-c-driver-devel-1.30.6-3.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2691.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2691"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-6691"}],"database_specific":{"severity":"High"}}