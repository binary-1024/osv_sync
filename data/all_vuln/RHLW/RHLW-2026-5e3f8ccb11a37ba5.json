{"schema_version":"1.9.2","id":"RHLW-2026-5e3f8ccb11a37ba5","published":"2026-10-20T11:56:50Z","modified":"2026-10-27T08:45:02.518267606Z","upstream":["CVE-2026-91863","CVE-2026-91865","CVE-2026-91866","CVE-2026-91867"],"summary":"Lightwell Security Advisory: neethi 3.2.2.rhlw-00028","details":"Red Hat Lightwell has released org.apache.neethi:neethi 3.2.2.rhlw-00028 with backported fixes for CVE-2026-91863, CVE-2026-91865, CVE-2026-91866, and CVE-2026-91867.\n\nCVE-2026-91863: Apache Neethi: Uncontrolled recursion while parsing crafted WS-Policy documents allows denial of service\n\nCVE-2026-91865: Apache Neethi: Crafted policy references cause exponential expansion during normalization leading to denial of service\n\nCVE-2026-91866: Apache Neethi: Crafted policies cause unbounded work during intersection leading to denial of service\n\nCVE-2026-91867: Apache Neethi: Remote policy fetch lacks a total timeout, allowing a slow server to hang the request indefinitely\n\nThis patched artifact is a drop-in replacement for org.apache.neethi:neethi 3.2.2 from Maven Central.","affected":[{"package":{"name":"org.apache.neethi:neethi","ecosystem":"Red Hat Lightwell:Maven","purl":"pkg:maven/org.apache.neethi/neethi"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.2.2.rhlw-00028"}]}],"versions":["2.0","2.0.1","2.0.2","2.0.3","2.0.4","2.0.5","3.0.0","3.0.1","3.0.2","3.0.3","3.1.0","3.1.1","3.2.0","3.2.1","3.2.2"],"database_specific":{"lightwell":{"backport_base_version":"3.2.2","remediated_version":"3.2.2.rhlw-00028","repository_url":"https://packages.redhat.com/lightwell/java/remediated/"},"source":"https://github.com/project-lightwell/lightwell-osv/blob/main/advisories/RHLW-2026-5e3f8ccb11a37ba5.json"}}],"references":[{"type":"WEB","url":"https://repo.maven.apache.org/maven2"},{"type":"ADVISORY","url":"https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/91xxx/CVE-2026-91863.json"},{"type":"ADVISORY","url":"https://lists.apache.org/thread/72kxj71