{"schema_version":"1.7.5","id":"USN-8022-2","published":"2026-02-16T07:59:27Z","modified":"2026-04-27T18:38:48.914241Z","related":["UBUNTU-CVE-2026-24515","UBUNTU-CVE-2026-25210"],"upstream":["CVE-2026-24515","CVE-2026-25210","UBUNTU-CVE-2026-24515","UBUNTU-CVE-2026-25210"],"summary":"expat vulnerabilities","details":"USN-8022-1 fixed vulnerabilities in Expat. This update provides the\ncorresponding updates for Ubuntu 24.04 LTS.\n\nOriginal advisory details:\n\n It was discovered that Expat incorrectly handled the initialization of parsers\n for external entities. An attacker could possibly use this issue to cause a\n denial of service. (CVE-2026-24515)\n\n It was discovered that Expat incorrectly handled integer calculations when\n allocating memory for XML tags. An attacker could possibly use this issue to\n cause a denial of service or execute arbitrary code. (CVE-2026-25210)","affected":[{"package":{"name":"expat","ecosystem":"Ubuntu:24.04:LTS","purl":"pkg:deb/ubuntu/expat@2.6.1-2ubuntu0.4?arch=source&distro=noble"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.6.1-2ubuntu0.4"}]}],"versions":["2.5.0-2","2.6.0-1","2.6.1-2","2.6.1-2build1","2.6.1-2ubuntu0.1","2.6.1-2ubuntu0.2","2.6.1-2ubuntu0.3"],"ecosystem_specific":{"availability":"No subscription required","binaries":[{"binary_name":"expat","binary_version":"2.6.1-2ubuntu0.4"},{"binary_name":"libexpat1","binary_version":"2.6.1-2ubuntu0.4"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2026-24515","severity":[{"score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:L","type":"CVSS_V3"},{"score":"CVSS:3.1/AV:L/AC:H/PR:L/UI:N/S:U/C:N/I:N/A:L","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]},{"id":"CVE-2026-25210","severity":[{"score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:L","type":"CVSS_V3"},{"score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:24.04:LTS"},"source":"https://github.com/canonical/ub