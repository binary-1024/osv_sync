{"schema_version":"1.7.5","id":"USN-8226-2","published":"2026-04-30T16:19:47Z","modified":"2026-06-25T13:32:32.090555596Z","upstream":["UBUNTU-CVE-2026-31431"],"summary":"kmod update","details":"USN-8226-1 added a mitigation to kmod to disable loading the algif_aead\nmodule. This update adds the same mitigation to Ubuntu 14.04 LTS,\nUbuntu 16.04 LTS, Ubuntu 18.04 LTS, and Ubuntu 20.04 LTS.\n\nOriginal advisory details:\n\nIt was discovered that the Linux kernel algif_aead module contained a logic\nflaw allowing a local attacker to escalate privileges to root. This update\nto the kmod package disables loading the algif_aead module as a measure to\nmitigate the issue until kernel updates are made available.\n\nSee the following URL for more information\nhttps://ubuntu.com/blog/copy-fail-vulnerability-fixes-available\n","affected":[{"package":{"name":"kmod","ecosystem":"Ubuntu:Pro:14.04:LTS","purl":"pkg:deb/ubuntu/kmod?arch=source&distro=esm-infra-legacy%2Ftrusty"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"15-0ubuntu7+esm1"}]}],"versions":["9-3ubuntu1","15-0ubuntu2","15-0ubuntu5","15-0ubuntu6","15-0ubuntu7"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro with Legacy support add-on: https://ubuntu.com/pro","binaries":[{"binary_name":"kmod","binary_version":"15-0ubuntu7+esm1"},{"binary_name":"libkmod2","binary_version":"15-0ubuntu7+esm1"},{"binary_name":"module-init-tools","binary_version":"15-0ubuntu7+esm1"}]},"database_specific":{"cves_map":{"cves":[],"ecosystem":"Ubuntu:Pro:14.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-8226-2.json"}},{"package":{"name":"kmod","ecosystem":"Ubuntu:Pro:16.04:LTS","purl":"pkg:deb/ubuntu/kmod?arch=source&distro=esm-infra%2Fxenial"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"22-1ubuntu5.2+esm1"}]}],"versions":["21-1ubuntu1","22-1ubuntu1","22-1ubuntu3","22-1ubuntu4","22-1ubuntu5","22-1ubuntu5.1","22-1ubuntu5.2"],"ecosystem