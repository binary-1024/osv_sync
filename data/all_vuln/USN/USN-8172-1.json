{"schema_version":"1.7.5","id":"USN-8172-1","published":"2026-04-13T18:27:37Z","modified":"2026-06-25T13:32:31.930840306Z","related":["UBUNTU-CVE-2021-45464","UBUNTU-CVE-2023-2861"],"upstream":["UBUNTU-CVE-2021-45464","UBUNTU-CVE-2023-2861"],"summary":"kvmtool vulnerabilities","details":"It was discovered that kvmtool did not properly manage memory under certain\ncircumstances. A malicious guest attacker could use this issue to cause\nkvmtool to crash, leading to a denial of service, or possibly execute\narbitrary code on the host system. (CVE-2021-45464)\n\nIt was discovered that kvmtool incorrectly handled the 9p passthrough file\nsystem. A malicious guest attacker could possibly use this issue to open\nspecial files, escape the exported 9p tree, and execute arbitrary code on\nthe host system. (CVE-2023-2861)","affected":[{"package":{"name":"kvmtool","ecosystem":"Ubuntu:Pro:16.04:LTS","purl":"pkg:deb/ubuntu/kvmtool?arch=source&distro=esm-apps%2Fxenial"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.20151104-1ubuntu0.1~esm1"}]}],"versions":["0.20150908-1","0.20151104-1"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro: https://ubuntu.com/pro","binaries":[{"binary_name":"kvmtool","binary_version":"0.20151104-1ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2021-45464","severity":[{"score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"high","type":"Ubuntu"}]},{"id":"CVE-2023-2861","severity":[{"score":"CVSS:3.1/AV:L/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:N","type":"CVSS_V3"},{"score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N","type":"CVSS_V3"},{"score":"low","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:16.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-8172-1.json"}},{"package":{"name":"kvmtool","ecosystem":"Ubuntu:Pro:18.04:LTS","purl":"pkg:deb/ubuntu/kvmtool?arch