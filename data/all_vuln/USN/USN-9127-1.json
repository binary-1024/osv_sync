{"schema_version":"1.9.2","id":"USN-9127-1","published":"2026-11-17T00:48:57Z","modified":"2026-11-24T14:52:53.270202597Z","related":["UBUNTU-CVE-2018-11319"],"upstream":["CVE-2018-11319","UBUNTU-CVE-2018-11319"],"summary":"vim-syntastic vulnerability","details":"It was discovered that Syntastic searched the current directory and its\nparents for checker configuration files. If a user were tricked into\nchecking a file in a directory controlled by an attacker, the attacker\ncould possibly use this issue to execute arbitrary code. After this update,\nSyntastic only reads checker configuration files that are named in the\n*_config_file options.","affected":[{"package":{"name":"vim-syntastic","ecosystem":"Ubuntu:Pro:18.04:LTS","purl":"pkg:deb/ubuntu/vim-syntastic?arch=source&distro=esm-apps%2Fbionic"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.8.0-1ubuntu0.1~esm1"}]}],"versions":["3.7.0-1","3.8.0-1"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro: https://ubuntu.com/pro","binaries":[{"binary_name":"vim-syntastic","binary_version":"3.8.0-1ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2018-11319","severity":[{"score":"CVSS:3.0/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:H","source":"NVD","type":"CVSS_V3"},{"score":"medium","source":"SELF","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:18.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-9127-1.json"}}],"references":[{"type":"ADVISORY","url":"https://ubuntu.com/security/notices/USN-9127-1"},{"type":"REPORT","url":"https://ubuntu.com/security/CVE-2018-11319"}]}