{"schema_version":"1.9.2","id":"USN-8977-1","published":"2026-11-03T17:33:15Z","modified":"2026-11-04T03:43:12.084576363Z","related":["UBUNTU-CVE-2016-10188","UBUNTU-CVE-2016-10189"],"upstream":["CVE-2016-10188","CVE-2016-10189","UBUNTU-CVE-2016-10188","UBUNTU-CVE-2016-10189"],"summary":"bitlbee vulnerabilities","details":"It was discovered that BitlBee incorrectly handled file transfer\nconnections that expired when built with libpurple. A remote attacker could\npossibly use this issue to cause BitlBee to crash, resulting in a denial of\nservice, or possibly execute arbitrary code. (CVE-2016-10188)\n\nIt was discovered that BitlBee incorrectly handled file transfer requests\nfor contacts that were not in the contact list. A remote attacker could\npossibly use this issue to cause BitlBee to crash, resulting in a denial of\nservice, or possibly execute arbitrary code. (CVE-2016-10189)","affected":[{"package":{"name":"bitlbee","ecosystem":"Ubuntu:Pro:16.04:LTS","purl":"pkg:deb/ubuntu/bitlbee?arch=source&distro=esm-apps-legacy%2Fxenial"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.4.2-0ubuntu1+esm1"}]}],"versions":["3.4.1-1","3.4.1-1build1","3.4.2-0ubuntu1"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro with Legacy support add-on: https://ubuntu.com/pro","binaries":[{"binary_name":"bitlbee","binary_version":"3.4.2-0ubuntu1+esm1"},{"binary_name":"bitlbee-common","binary_version":"3.4.2-0ubuntu1+esm1"},{"binary_name":"bitlbee-libpurple","binary_version":"3.4.2-0ubuntu1+esm1"},{"binary_name":"bitlbee-plugin-otr","binary_version":"3.4.2-0ubuntu1+esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2016-10188","severity":[{"score":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]},{"id":"CVE-2016-10189","severity":[{"score":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:16.04:LTS"},"source":"h