{"schema_version":"1.9.2","id":"USN-8987-1","published":"2026-11-03T17:36:51Z","modified":"2026-11-04T03:43:14.568913089Z","related":["UBUNTU-CVE-2015-3245","UBUNTU-CVE-2015-3246"],"upstream":["CVE-2015-3245","CVE-2015-3246","UBUNTU-CVE-2015-3245","UBUNTU-CVE-2015-3246"],"summary":"libuser vulnerabilities","details":"It was discovered that libuser did not properly validate the GECOS field\nwhen changing user information. A local attacker could possibly use this\nissue to corrupt the passwd file, resulting in a denial of service.\n(CVE-2015-3245)\n\nIt was discovered that libuser modified the passwd file in place when\nupdating user information. A local attacker could possibly use this issue\nto cause an inconsistent file state, resulting in a denial of service, or\npossibly escalate privileges. (CVE-2015-3246)","affected":[{"package":{"name":"libuser","ecosystem":"Ubuntu:Pro:16.04:LTS","purl":"pkg:deb/ubuntu/libuser?arch=source&distro=esm-apps-legacy%2Fxenial"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1:0.60~dfsg-1.2ubuntu0.1~esm1"}]}],"versions":["1:0.60~dfsg-1.2"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro with Legacy support add-on: https://ubuntu.com/pro","binaries":[{"binary_name":"libuser","binary_version":"1:0.60~dfsg-1.2ubuntu0.1~esm1"},{"binary_name":"libuser1","binary_version":"1:0.60~dfsg-1.2ubuntu0.1~esm1"},{"binary_name":"python-libuser","binary_version":"1:0.60~dfsg-1.2ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2015-3245","severity":[{"score":"low","type":"Ubuntu"}]},{"id":"CVE-2015-3246","severity":[{"score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"high","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:16.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-8987-1.json"}}],"references":[{"type":"ADVISORY","url":"https://ubuntu.com/security/notices/USN-8987-1"},{"type":"REPORT","url":"https://ubuntu.com/secu