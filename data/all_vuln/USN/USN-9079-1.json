{"schema_version":"1.9.2","id":"USN-9079-1","published":"2026-11-12T20:53:13Z","modified":"2026-11-13T11:28:24.228468264Z","related":["UBUNTU-CVE-2019-1010057","UBUNTU-CVE-2019-14459"],"upstream":["CVE-2019-1010057","CVE-2019-14459","UBUNTU-CVE-2019-1010057","UBUNTU-CVE-2019-14459"],"summary":"nfdump vulnerabilities","details":"It was discovered that nfdump incorrectly handled certain input files,\nleading to a buffer overflow. If a user or automated system were tricked\ninto processing a specially crafted file, an attacker could possibly use\nthis issue to cause nfdump to crash or execute arbitrary code.\n(CVE-2019-1010057)\n\nIt was discovered that nfdump incorrectly handled certain IPFIX template\nwithdrawal messages, leading to an integer overflow. A remote attacker\ncould possibly use this issue to cause nfdump to crash, resulting in a\ndenial of service. (CVE-2019-14459)","affected":[{"package":{"name":"nfdump","ecosystem":"Ubuntu:Pro:18.04:LTS","purl":"pkg:deb/ubuntu/nfdump?arch=source&distro=esm-apps%2Fbionic"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.6.16-3ubuntu0.1~esm1"}]}],"versions":["1.6.15-3","1.6.16-2","1.6.16-3"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro: https://ubuntu.com/pro","binaries":[{"binary_name":"nfdump","binary_version":"1.6.16-3ubuntu0.1~esm1"},{"binary_name":"nfdump-flow-tools","binary_version":"1.6.16-3ubuntu0.1~esm1"},{"binary_name":"nfdump-sflow","binary_version":"1.6.16-3ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2019-14459","severity":[{"score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]},{"id":"CVE-2019-1010057","severity":[{"score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:18.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-9079-1.json"}}],"references":[{"type":"ADVISORY","url":"https://ubuntu.com/security/notices/USN-9079-1"},{"type":"REPORT","url":"https://ubuntu.com/security/CVE-2019-14459"},{"type":"REPORT","url":"https://ubuntu.com/security/CVE-2019-1010057"}]}