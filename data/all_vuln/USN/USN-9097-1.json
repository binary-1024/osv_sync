{"schema_version":"1.9.2","id":"USN-9097-1","published":"2026-11-17T00:44:04Z","modified":"2026-11-18T00:58:43.950978068Z","related":["UBUNTU-CVE-2022-33980"],"upstream":["CVE-2022-33980","UBUNTU-CVE-2022-33980"],"summary":"commons-configuration2 vulnerability","details":"It was discovered that Apache Commons Configuration enabled the script,\ndns, and url interpolation lookups by default. If an application used the\ndefault interpolation settings with untrusted configuration values, an\nattacker could possibly use this issue to execute arbitrary code or cause\nthe application to contact remote servers. This update removes these\nlookups from the default set.","affected":[{"package":{"name":"commons-configuration2","ecosystem":"Ubuntu:Pro:22.04:LTS","purl":"pkg:deb/ubuntu/commons-configuration2?arch=source&distro=esm-apps%2Fjammy"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.7-2ubuntu0.1~esm1"}]}],"versions":["2.7-2"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro: https://ubuntu.com/pro","binaries":[{"binary_name":"libcommons-configuration2-java","binary_version":"2.7-2ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2022-33980","severity":[{"score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:22.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-9097-1.json"}}],"references":[{"type":"ADVISORY","url":"https://ubuntu.com/security/notices/USN-9097-1"},{"type":"REPORT","url":"https://ubuntu.com/security/CVE-2022-33980"}]}