{"schema_version":"1.9.0","id":"USN-8893-1","published":"2026-10-07T10:05:38Z","modified":"2026-10-08T12:58:05.069798336Z","related":["UBUNTU-CVE-2026-19773"],"upstream":["CVE-2026-19773","UBUNTU-CVE-2026-19773"],"summary":"libwebsockets vulnerabilities","details":"It was discovered that libwebsockets did not properly validate\nuser-supplied data when parsing HTTP/2 HPACK path headers, which could\nresult in a write past the end of an allocated buffer. An attacker could\npossibly use this issue to execute arbitrary code. (CVE-2026-19773)\n\nIt was discovered that libwebsockets did not properly handle CBOR\nrecording in the LECP parser, which could result in a write past the end\nof an allocated buffer. An attacker could possibly use this issue to\ncause a crash or execute arbitrary code. (CVE-2026-78161)","affected":[{"package":{"name":"libwebsockets","ecosystem":"Ubuntu:Pro:16.04:LTS","purl":"pkg:deb/ubuntu/libwebsockets?arch=source&distro=esm-apps-legacy%2Fxenial"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.7.1-1ubuntu0.1~esm1"}]}],"versions":["1.2.2-1","1.6.0-3","1.6.0-4","1.6.0-5","1.6.1-1","1.7.0-1ubuntu1","1.7.0-2","1.7.1-1"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro with Legacy support add-on: https://ubuntu.com/pro","binaries":[{"binary_name":"libwebsockets-test-server","binary_version":"1.7.1-1ubuntu0.1~esm1"},{"binary_name":"libwebsockets-test-server-common","binary_version":"1.7.1-1ubuntu0.1~esm1"},{"binary_name":"libwebsockets7","binary_version":"1.7.1-1ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2026-19773","severity":[{"score":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:16.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-8893-1.json"}},{"package":{"name":"libwebsockets","ecosystem":"Ubuntu:Pro:18.04:LTS","purl":"pkg:deb/ubuntu/libwebsockets?arch=sourc