{"schema_version":"1.7.5","id":"USN-8248-1","published":"2026-05-07T13:00:13Z","modified":"2026-05-11T10:46:46.739843Z","related":["UBUNTU-CVE-2021-33450","UBUNTU-CVE-2021-33452","UBUNTU-CVE-2023-31722"],"upstream":["CVE-2021-33450","CVE-2021-33452","CVE-2023-31722","UBUNTU-CVE-2021-33450","UBUNTU-CVE-2021-33452","UBUNTU-CVE-2023-31722"],"summary":"nasm vulnerabilities","details":"Daisy Chen discovered that NASM was vulnerable to a heap buffer overflow\nwhen handling certain input. An attacker could possibly use this issue\nto cause NASM to crash, resulting in a denial of service, or\npossibly execute arbitrary code. (CVE-2023-31722)\n\nIt was discovered that NASM incorrectly handled memory allocation.\nAn attacker could possibly use this issue to cause NASM to use\nexcessive resources, leading to a denial of service. This issue\nonly affected Ubuntu 24.04 LTS. (CVE-2021-33452, CVE-2021-33450)","affected":[{"package":{"name":"nasm","ecosystem":"Ubuntu:Pro:22.04:LTS","purl":"pkg:deb/ubuntu/nasm@2.15.05-1ubuntu0.1~esm1?arch=source&distro=esm-apps/jammy"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.15.05-1ubuntu0.1~esm1"}]}],"versions":["2.15.05-1"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro: https://ubuntu.com/pro","binaries":[{"binary_name":"nasm","binary_version":"2.15.05-1ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2023-31722","severity":[{"score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","type":"CVSS_V3"},{"score":"medium","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:22.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-8248-1.json"}},{"package":{"name":"nasm","ecosystem":"Ubuntu:Pro:24.04:LTS","purl":"pkg:deb/ubuntu/nasm@2.16.01-1ubuntu0.1~esm1?arch=source&distro=esm-apps/noble"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.16.01-1ubuntu0.1~esm1