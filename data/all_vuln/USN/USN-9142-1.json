{"schema_version":"1.9.2","id":"USN-9142-1","published":"2026-11-17T17:10:33Z","modified":"2026-11-24T14:53:17.200793638Z","related":["UBUNTU-CVE-2021-40690"],"upstream":["CVE-2021-40690","UBUNTU-CVE-2021-40690"],"summary":"libxml-security-java vulnerability","details":"It was discovered that Apache XML Security for Java incorrectly passed a\nconfiguration property when creating specific key elements. An attacker\ncould possibly use this issue to abuse an XPath Transform and extract\nsensitive information. After this update, file: and http: URIs are only\ndereferenced when the org.apache.xml.security.allowUnsafeResourceResolving\nproperty is set.","affected":[{"package":{"name":"libxml-security-java","ecosystem":"Ubuntu:Pro:16.04:LTS","purl":"pkg:deb/ubuntu/libxml-security-java?arch=source&distro=esm-apps-legacy%2Fxenial"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.5.6-1ubuntu0.1~esm1"}]}],"versions":["1.5.6-1"],"ecosystem_specific":{"availability":"Available with Ubuntu Pro with Legacy support add-on: https://ubuntu.com/pro","binaries":[{"binary_name":"libxml-security-java","binary_version":"1.5.6-1ubuntu0.1~esm1"}]},"database_specific":{"cves_map":{"cves":[{"id":"CVE-2021-40690","severity":[{"score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","source":"NVD","type":"CVSS_V3"},{"score":"medium","source":"SELF","type":"Ubuntu"}]}],"ecosystem":"Ubuntu:Pro:16.04:LTS"},"source":"https://github.com/canonical/ubuntu-security-notices/blob/main/osv/usn/USN-9142-1.json"}}],"references":[{"type":"ADVISORY","url":"https://ubuntu.com/security/notices/USN-9142-1"},{"type":"REPORT","url":"https://ubuntu.com/security/CVE-2021-40690"}]}