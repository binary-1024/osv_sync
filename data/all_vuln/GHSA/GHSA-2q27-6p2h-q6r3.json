{"schema_version":"1.9.0","id":"GHSA-2q27-6p2h-q6r3","published":"2026-06-24T15:31:48Z","modified":"2026-09-25T20:00:39.698462552Z","aliases":["CVE-2026-57303"],"summary":"Jenkins Assembla Plugin has an XXE vulnerability","details":"Jenkins Assembla Plugin 1.4 and earlier does not configure its XML parser to prevent XML external entity (XXE) attacks when parsing responses from the configured Assembla server.\n\nThis allows attackers able to control the responses of the configured Assembla server to extract secrets from the Jenkins controller or perform server-side request forgery.\n\nAs of publication of this advisory, there is no fix.","affected":[{"package":{"name":"org.jenkins-ci.plugins:assembla","ecosystem":"Maven","purl":"pkg:maven/org.jenkins-ci.plugins/assembla"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"last_affected":"1.4"}]}],"versions":["1.2","1.3","1.4"],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/06/GHSA-2q27-6p2h-q6r3/GHSA-2q27-6p2h-q6r3.json"}}],"references":[{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-57303"},{"type":"PACKAGE","url":"https://github.com/lucamilanesio/assembla-jenkins-plugin"},{"type":"WEB","url":"https://www.jenkins.io/security/advisory/2026-06-24/#SECURITY-3692%20(1)"}],"database_specific":{"cwe_ids":["CWE-918"],"github_reviewed":true,"github_reviewed_at":"2026-09-25T19:47:08Z","nvd_published_at":"2026-06-24T14:17:36Z","severity":"HIGH"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:L/A:N"}]}