{"schema_version":"1.9.0","id":"OESA-2025-2761","published":"2025-11-28T11:09:52Z","modified":"2026-08-18T01:19:21.020672544Z","upstream":["CVE-2025-60753"],"summary":"libarchive security update","details":"is an open-source BSD-licensed C programming library that  provides streaming access to a variety of different archive formats, including tar, cpio, pax, zip, and ISO9660 images. The distribution  also includes bsdtar and bsdcpio, full-featured implementations of  tar and cpio that use .\r\n\r\nSecurity Fix(es):\n\nAn issue was discovered in libarchive bsdtar before version 3.8.1 in function apply_substitution in file tar/subst.c when processing crafted -s substitution rules. This can cause unbounded memory allocation and lead to denial of service (Out-of-Memory crash).(CVE-2025-60753)","affected":[{"package":{"name":"libarchive","ecosystem":"openEuler:24.03-LTS","purl":"pkg:rpm/openEuler/libarchive&distro=openEuler-24.03-LTS"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.7.1-8.oe2403"}]}],"ecosystem_specific":{"aarch64":["bsdcat-3.7.1-8.oe2403.aarch64.rpm","bsdcpio-3.7.1-8.oe2403.aarch64.rpm","bsdtar-3.7.1-8.oe2403.aarch64.rpm","bsdunzip-3.7.1-8.oe2403.aarch64.rpm","libarchive-3.7.1-8.oe2403.aarch64.rpm","libarchive-debuginfo-3.7.1-8.oe2403.aarch64.rpm","libarchive-debugsource-3.7.1-8.oe2403.aarch64.rpm","libarchive-devel-3.7.1-8.oe2403.aarch64.rpm"],"noarch":["libarchive-help-3.7.1-8.oe2403.noarch.rpm"],"src":["libarchive-3.7.1-8.oe2403.src.rpm"],"x86_64":["bsdcat-3.7.1-8.oe2403.x86_64.rpm","bsdcpio-3.7.1-8.oe2403.x86_64.rpm","bsdtar-3.7.1-8.oe2403.x86_64.rpm","bsdunzip-3.7.1-8.oe2403.x86_64.rpm","libarchive-3.7.1-8.oe2403.x86_64.rpm","libarchive-debuginfo-3.7.1-8.oe2403.x86_64.rpm","libarchive-debugsource-3.7.1-8.oe2403.x86_64.rpm","libarchive-devel-3.7.1-8.oe2403.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2025-2761.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2025-2761"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2025-60753"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H"}]}