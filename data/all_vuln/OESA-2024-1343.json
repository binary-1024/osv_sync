{"schema_version":"1.9.0","id":"OESA-2024-1343","published":"2024-03-29T11:06:47Z","modified":"2026-08-18T01:18:20.127347663Z","upstream":["CVE-2024-2002"],"summary":"libdwarf security update","details":"Libdwarf is a library of functions to provide read/write DWARF debugging records.\r\n\r\nSecurity Fix(es):\r\n\r\nA double-free vulnerability was found in libdwarf. In a multiply-corrupted DWARF object, libdwarf may try to dealloc(free) an allocation twice, potentially causing unpredictable and various results.(CVE-2024-2002)","affected":[{"package":{"name":"libdwarf","ecosystem":"openEuler:22.03-LTS-SP3","purl":"pkg:rpm/openEuler/libdwarf&distro=openEuler-22.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.9.1-1.oe2203sp3"}]}],"ecosystem_specific":{"aarch64":["libdwarf-debuginfo-0.9.1-1.oe2203sp3.aarch64.rpm","libdwarf-debugsource-0.9.1-1.oe2203sp3.aarch64.rpm","libdwarf-tools-0.9.1-1.oe2203sp3.aarch64.rpm","libdwarf-0.9.1-1.oe2203sp3.aarch64.rpm","libdwarf-devel-0.9.1-1.oe2203sp3.aarch64.rpm"],"noarch":["libdwarf-help-0.9.1-1.oe2203sp3.noarch.rpm"],"src":["libdwarf-0.9.1-1.oe2203sp3.src.rpm"],"x86_64":["libdwarf-debugsource-0.9.1-1.oe2203sp3.x86_64.rpm","libdwarf-0.9.1-1.oe2203sp3.x86_64.rpm","libdwarf-tools-0.9.1-1.oe2203sp3.x86_64.rpm","libdwarf-debuginfo-0.9.1-1.oe2203sp3.x86_64.rpm","libdwarf-devel-0.9.1-1.oe2203sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2024-1343.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/en/security/safety-bulletin/detail.html?id=openEuler-SA-2024-1343"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2024-2002"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"}]}