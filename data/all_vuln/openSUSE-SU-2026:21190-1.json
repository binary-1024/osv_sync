5-10998,\n    CVE-2025-10999, CVE-2025-11000,\n    CVE-2026-2704 (boo#1258501), CVE-2026-2705 (boo#1258507) and\n    CVE-2026-3408 (boo#1259041)\n","affected":[{"package":{"name":"openbabel","ecosystem":"openSUSE:Leap 16.0","purl":"pkg:rpm/opensuse/openbabel&distro=openSUSE%20Leap%2016.0"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.2.0-bp160.1.1"}]}],"ecosystem_specific":{"binaries":[{"libopenbabel8":"3.2.0-bp160.1.1","openbabel":"3.2.0-bp160.1.1","openbabel-devel":"3.2.0-bp160.1.1","openbabel-gui":"3.2.0-bp160.1.1","python3-openbabel":"3.2.0-bp160.1.1"}]},"database_specific":{"source":"https://ftp.suse.com/pub/projects/security/osv/openSUSE-SU-2026:21190-1.json"}}],"references":[{"type":"ADVISORY"},{"type":"REPORT","url":"https://bugzilla.suse.com/1217676"},{"type":"REPORT","url":"https://bugzilla.suse.com/1258501"},{"type":"REPORT","url":"https://bugzilla.suse.com/1258507"},{"type":"REPORT","url":"https://bugzilla.suse.com/1259041"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-37331"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-41793"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-42885"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-43467"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-43607"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-44451"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-46280"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-46289"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-46290"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-46291"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-46292"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-46294"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2022-46295"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2025-10994"},{"type":"WEB","