{"schema_version":"1.7.5","id":"openSUSE-SU-2026:20138-1","published":"2026-01-30T09:59:14Z","modified":"2026-03-23T04:54:45.700164Z","related":["CVE-2025-8835","CVE-2025-8836","CVE-2025-8837"],"upstream":["CVE-2025-8835","CVE-2025-8836","CVE-2025-8837"],"summary":"Security update for jasper","details":"This update for jasper fixes the following issues:\n\nUpdate to 4.2.8:\n\n- CVE-2025-8837: Fixed a bug in the JPC decoder that could cause bad memory accesses if the debug level is set sufficiently high (bsc#1247901).\n- CVE-2025-8836: Added some missing range checking on several coding parameters in the JPC encoder (bsc#1247902).\n- CVE-2025-8835: Added a check for a missing color component in the jas_image_chclrspc function (bsc#1247904).\n","affected":[{"package":{"name":"jasper","ecosystem":"openSUSE:Leap 16.0","purl":"pkg:rpm/opensuse/jasper&distro=openSUSE%20Leap%2016.0"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.2.8-160000.1.1"}]}],"ecosystem_specific":{"binaries":[{"jasper":"4.2.8-160000.1.1","libjasper-devel":"4.2.8-160000.1.1","libjasper7":"4.2.8-160000.1.1"}]},"database_specific":{"source":"https://ftp.suse.com/pub/projects/security/osv/openSUSE-SU-2026:20138-1.json"}}],"references":[{"type":"ADVISORY"},{"type":"REPORT","url":"https://bugzilla.suse.com/1247901"},{"type":"REPORT","url":"https://bugzilla.suse.com/1247902"},{"type":"REPORT","url":"https://bugzilla.suse.com/1247904"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2025-8835"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2025-8836"},{"type":"WEB","url":"https://www.suse.com/security/cve/CVE-2025-8837"}]}