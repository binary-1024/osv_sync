{"schema_version":"1.9.0","id":"GHSA-26m2-9g2q-v45q","published":"2026-06-15T21:30:39Z","modified":"2026-08-26T15:15:13.187771162Z","aliases":["CVE-2026-41708"],"summary":"Spring Cloud Sleuth instrumentation of Spring TX DoS vulnerability","details":"In Spring Cloud Sleuth, it is possible for a user to provide specially crafted calls that may cause a denial-of-service (DoS) condition. The application is vulnerable when it uses a vulnerable version of org.springframework.cloud:spring-cloud-sleuth-instrumentation and Spring TX instrumentation is not disabled.\n\nAffected versions:\nSpring Cloud Sleuth 3.1.0 through 3.1.13.","affected":[{"package":{"name":"org.springframework.cloud:spring-cloud-sleuth-instrumentation","ecosystem":"Maven","purl":"pkg:maven/org.springframework.cloud/spring-cloud-sleuth-instrumentation"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"3.1.0"},{"last_affected":"3.1.11"}]}],"versions":["3.1.0","3.1.1","3.1.10","3.1.11","3.1.2","3.1.3","3.1.4","3.1.5","3.1.6","3.1.7","3.1.8","3.1.9"],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/06/GHSA-26m2-9g2q-v45q/GHSA-26m2-9g2q-v45q.json"}}],"references":[{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-41708"},{"type":"PACKAGE","url":"https://github.com/spring-attic/spring-cloud-sleuth"},{"type":"WEB","url":"https://spring.io/security/cve-2026-41708"}],"database_specific":{"cwe_ids":["CWE-400"],"github_reviewed":true,"github_reviewed_at":"2026-08-26T14:59:15Z","nvd_published_at":"2026-06-15T20:16:27Z","severity":"HIGH"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"}]}