{"schema_version":"1.7.3","id":"BIT-prestashop-2026-25597","published":"2026-02-10T10:02:58.336Z","modified":"2026-07-16T09:11:45.299157944Z","withdrawn":"2026-07-16T09:00:06.524409154Z","summary":"PrestaShop has a time based enumeration in FO login form","details":"PrestaShop is an open source e-commerce web application. Prior to 8.2.4 and 9.0.3, there is a time-based user enumeration vulnerability in the user authentication functionality of PrestaShop. This vulnerability allows an attacker to determine whether a customer account exists in the system by measuring response times. This vulnerability is fixed in 8.2.4 and 9.0.3.","affected":[{"package":{"name":"prestashop","ecosystem":"Bitnami","purl":"pkg:bitnami/prestashop"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"8.2.4"},{"introduced":"9.0.0"},{"fixed":"9.0.3"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/prestashop/BIT-prestashop-2026-25597.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N"}]}],"references":[{"type":"WEB","url":"https://github.com/PrestaShop/PrestaShop/releases/tag/8.2.4"},{"type":"WEB","url":"https://github.com/PrestaShop/PrestaShop/releases/tag/9.0.3"},{"type":"WEB","url":"https://github.com/PrestaShop/PrestaShop/security/advisories/GHSA-67v7-3g49-mxh2"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-25597"}],"database_specific":{"cpes":["cpe:2.3:a:prestashop:prestashop:*:*:*:*:*:php:*:*"],"severity":"Medium"}}