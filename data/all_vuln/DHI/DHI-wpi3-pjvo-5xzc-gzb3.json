{"schema_version":"1.9.2","id":"DHI-wpi3-pjvo-5xzc-gzb3","published":"2026-11-11T15:41:32Z","modified":"2026-11-16T02:36:21.993391539Z","upstream":["CVE-2026-107928"],"summary":"When curl is built with GnuTLS, a malicious WebSocket server can make curl","details":"When curl is built with GnuTLS, a malicious WebSocket server can make curl\nsend memory past its send buffer. This is due to an out of bounds read\nfollowing when `gnutls_record_send()` returns a number of bytes sent **greater\nthan the number of bytes it was given to send**. GnuTLS does that after a\nblocked send.","affected":[{"package":{"name":"curl","ecosystem":"Docker Hardened Images:Alpine:3.23","purl":"pkg:apk/dhi/curl"},"versions":["8.17.0-r1","8.18.0-r0","8.19.0-r0","8.20.0-r0","8.20.0-r1","8.21.0-r0","8.22.0-r0","8.23.0-r0","8.23.0-r1"],"database_specific":{"owner_kind":"HSP","source":"https://github.com/docker-hardened-images/advisories/blob/main/dhi/osv/2026/DHI-wpi3-pjvo-5xzc-gzb3.json"}},{"package":{"name":"curl","ecosystem":"Docker Hardened Images:Alpine:3.24","purl":"pkg:apk/dhi/curl"},"versions":["8.20.0-r1","8.21.0-r0","8.22.0-r0","8.22.0-r1","8.23.0-r0"],"database_specific":{"owner_kind":"HSP","source":"https://github.com/docker-hardened-images/advisories/blob/main/dhi/osv/2026/DHI-wpi3-pjvo-5xzc-gzb3.json"}}],"references":[{"type":"ADVISORY","url":"https://scout.docker.com/v/DHI-wpi3-pjvo-5xzc-gzb3"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-107928"},{"type":"ADVISORY","url":"https://security.alpinelinux.org/vuln/CVE-2026-107928"},{"type":"ADVISORY","url":"https://security-tracker.debian.org/tracker/CVE-2026-107928"},{"type":"ADVISORY","url":"https://ubuntu.com/security/CVE-2026-107928"},{"type":"ADVISORY","url":"http://people.ubuntu.com/~ubuntu-security/cve/CVE-2026-107928"}],"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H"}]}