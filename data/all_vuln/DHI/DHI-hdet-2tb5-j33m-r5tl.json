{"schema_version":"1.9.2","id":"DHI-hdet-2tb5-j33m-r5tl","published":"2026-11-10T08:29:13Z","modified":"2026-11-16T02:35:27.162576162Z","upstream":["CVE-2026-114038"],"summary":"A flaw was found in device-mapper-multipath. A local user can trigger an out-of-bounds read by sending a command with a…","details":"A flaw was found in device-mapper-multipath. A local user can trigger an out-of-bounds read by sending a command with a format string ending in a trailing percent character to the multipath daemon. This issue can allow the user to expose unintended daemon memory, leading to information disclosure, or cause the daemon to crash, resulting in a Denial of Service (DoS).","affected":[{"package":{"name":"multipath-tools","ecosystem":"Docker Hardened Images:Debian:13","purl":"pkg:deb/dhi/multipath-tools"},"versions":["0.11.1-2+dhi0","0.11.1-2+dhi1","0.11.1-2+dhi2"],"database_specific":{"owner_kind":"HSP","source":"https://github.com/docker-hardened-images/advisories/blob/main/dhi/osv/2026/DHI-hdet-2tb5-j33m-r5tl.json"}}],"references":[{"type":"ADVISORY","url":"https://scout.docker.com/v/DHI-hdet-2tb5-j33m-r5tl"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-114038"},{"type":"ADVISORY","url":"https://security-tracker.debian.org/tracker/CVE-2026-114038"},{"type":"ADVISORY","url":"https://access.redhat.com/security/cve/CVE-2026-114038"},{"type":"ADVISORY","url":"https://ubuntu.com/security/CVE-2026-114038"},{"type":"ADVISORY","url":"http://people.ubuntu.com/~ubuntu-security/cve/CVE-2026-114038"},{"type":"FIX","url":"https://github.com/opensvc/multipath-tools/commit/d75d74f1d344cab8a98258773b85dbffa6895902"}],"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:L"}]}