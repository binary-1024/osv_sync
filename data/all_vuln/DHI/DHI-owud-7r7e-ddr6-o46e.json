{"schema_version":"1.9.2","id":"DHI-owud-7r7e-ddr6-o46e","published":"2026-11-19T20:54:10Z","modified":"2026-11-23T20:45:17.353060351Z","upstream":["CVE-2026-85977"],"summary":"A flaw was found in libtirpc. A remote attacker can exploit this vulnerability by sending specially crafted…","details":"A flaw was found in libtirpc. A remote attacker can exploit this vulnerability by sending specially crafted PMAPPROC_DUMP replies to a client application that uses the pmap_getmaps() function against an attacker-controlled host. This unbounded decoding can lead to excessive memory and CPU allocation, causing the client process to experience a Denial of Service (DoS) due to resource exhaustion.","affected":[{"package":{"name":"libtirpc","ecosystem":"Docker Hardened Images:Debian:13","purl":"pkg:deb/dhi/libtirpc"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.3.6+ds-1+deb13u0+dhi2"}]}],"versions":["1.3.6+ds-1+deb13u0+dhi1"],"database_specific":{"owner_kind":"HSP","source":"https://github.com/docker-hardened-images/advisories/blob/main/dhi/osv/2026/DHI-owud-7r7e-ddr6-o46e.json"}}],"references":[{"type":"ADVISORY","url":"https://scout.docker.com/v/DHI-owud-7r7e-ddr6-o46e"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-85977"},{"type":"ADVISORY","url":"https://security-tracker.debian.org/tracker/CVE-2026-85977"},{"type":"ADVISORY","url":"https://access.redhat.com/security/cve/CVE-2026-85977"},{"type":"ADVISORY","url":"https://ubuntu.com/security/CVE-2026-85977"},{"type":"ADVISORY","url":"http://people.ubuntu.com/~ubuntu-security/cve/CVE-2026-85977"}],"database_specific":{"coverage":"partial","coverage_exclusions":["legacy_package_image_owner"]},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:N/I:N/A:H"}]}