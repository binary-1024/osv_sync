{"schema_version":"1.9.0","id":"GHSA-v3jc-474w-2wm6","published":"2026-07-01T18:31:56Z","modified":"2026-08-13T18:30:12.441883592Z","aliases":["CVE-2026-54428"],"summary":"Apache HttpComponents Core: HPackDecoder Unlimited Header List Size Before SETTINGS ACK","details":"Allocation of resources without limits or throttling in the HTTP/2 HPACK decoder in Apache HttpComponents Core (5.4.2 and earlier, 5.5-beta1 and earlier) allows an remote attacker to cause a denial of service through memory exhaustion by sending oversized compressed header blocks before the HTTP/2 SETTINGS acknowledgement causes the configured header list size limit to be applied.","affected":[{"package":{"name":"org.apache.httpcomponents.core5:httpcore5-h2","ecosystem":"Maven","purl":"pkg:maven/org.apache.httpcomponents.core5/httpcore5-h2"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.4.3"}]}],"versions":["5.0","5.0-alpha2","5.0-alpha3","5.0-alpha4","5.0-beta1","5.0-beta10","5.0-beta11","5.0-beta2","5.0-beta3","5.0-beta4","5.0-beta5","5.0-beta6","5.0-beta7","5.0-beta8","5.0-beta9","5.0.1","5.0.2","5.0.3","5.0.4","5.1","5.1-beta1","5.1-beta2","5.1-beta3","5.1.1","5.1.2","5.1.3","5.1.4","5.1.5","5.2","5.2-alpha1","5.2-alpha2","5.2-beta1","5.2-beta2","5.2.1","5.2.2","5.2.3","5.2.4","5.2.5","5.3","5.3-alpha1","5.3-alpha2","5.3-beta1","5.3.1","5.3.2","5.3.3","5.3.4","5.3.5","5.3.6","5.4","5.4-alpha1","5.4.1","5.4.2"],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/07/GHSA-v3jc-474w-2wm6/GHSA-v3jc-474w-2wm6.json"}},{"package":{"name":"org.apache.httpcomponents.core5:httpcore5-h2","ecosystem":"Maven","purl":"pkg:maven/org.apache.httpcomponents.core5/httpcore5-h2"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"5.5-alpha1"},{"fixed":"5.5-beta2"}]}],"versions":["5.5-alpha1","5.5-beta1"],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/07/G