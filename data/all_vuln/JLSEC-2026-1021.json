{"schema_version":"1.7.5","id":"JLSEC-2026-1021","published":"2026-07-30T16:02:27.435Z","modified":"2026-07-30T18:35:29.841596494Z","upstream":["CVE-2026-47166","EUVD-2026-36178","GHSA-6gxq-f64p-5w6f"],"summary":"ImageMagick: Heap Buffer Over-Read in distributed pixel cache server","details":"ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 6.9.13-48 and 7.1.2-23, an attacker who can connect to a magick -distribute-cache service can cause a heap buffer over-read in the server process. This issue has been patched in versions 6.9.13-48 and 7.1.2-23.","affected":[{"package":{"name":"ImageMagick_jll","ecosystem":"Julia","purl":"pkg:julia/ImageMagick_jll?uuid=c73af94c-d91f-53ed-93a7-00f77d67a9d7"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"7.1.2028+0"}]}],"database_specific":{"source":"https://github.com/JuliaLang/SecurityAdvisories.jl/tree/generated/osv/2026/JLSEC-2026-1021.json"}}],"references":[{"type":"WEB","url":"https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-6gxq-f64p-5w6f"},{"type":"WEB","url":"https://github.com/advisories/GHSA-6gxq-f64p-5w6f"}],"database_specific":{"license":"CC-BY-4.0","sources":[{"database_specific":{"status":"Analyzed"},"html_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-47166","id":"CVE-2026-47166","imported":"2026-07-30T14:08:47.539Z","modified":"2026-07-23T09:10:00.113Z","published":"2026-06-10T23:16:48.180Z","url":"https://services.nvd.nist.gov/rest/json/cves/2.0?cveId=CVE-2026-47166"},{"html_url":"https://github.com/advisories/GHSA-6gxq-f64p-5w6f","id":"GHSA-6gxq-f64p-5w6f","imported":"2026-07-30T14:10:15.235Z","modified":"2026-05-22T13:14:39Z","published":"2026-05-22T13:14:38Z","url":"https://api.github.com/advisories/GHSA-6gxq-f64p-5w6f"},{"html_url":"https://euvd.enisa.europa.eu/vulnerability/EUVD-2026-36178","id":"EUVD-2026-36178","imported":"2026-07-30T14:08:53.439Z","modified":"2026-06-11T14:34:58Z","published":"2026-06-10T