{"schema_version":"1.7.5","id":"OESA-2026-3197","published":"2026-08-01T16:42:28Z","modified":"2026-07-31T16:45:10.019185259Z","upstream":["CVE-2026-44172"],"summary":"mariadb-connector-c security update","details":"This package is used for connecting C/C++ programs to MariaDB and MySQL database.\r\n\r\nSecurity Fix(es):\n\nMariaDB server is a community developed fork of MySQL server. In versions 3.3.18 and 3.4.8, an application that was taking non-validated user input, escaping it with mysql_real_escape_string() and sending it to the database using text protocol and big5 character set was vulnerable to SQL injections, even though mysql_real_escape_string() was supposed to prevent them. This issue has been patched in versions 3.3.19 and 3.4.9.(CVE-2026-44172)","affected":[{"package":{"name":"mariadb-connector-c","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/mariadb-connector-c&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.1.13-5.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["mariadb-connector-c-3.1.13-5.oe2203sp4.aarch64.rpm","mariadb-connector-c-debuginfo-3.1.13-5.oe2203sp4.aarch64.rpm","mariadb-connector-c-debugsource-3.1.13-5.oe2203sp4.aarch64.rpm","mariadb-connector-c-devel-3.1.13-5.oe2203sp4.aarch64.rpm"],"src":["mariadb-connector-c-3.1.13-5.oe2203sp4.src.rpm"],"x86_64":["mariadb-connector-c-3.1.13-5.oe2203sp4.x86_64.rpm","mariadb-connector-c-debuginfo-3.1.13-5.oe2203sp4.x86_64.rpm","mariadb-connector-c-debugsource-3.1.13-5.oe2203sp4.x86_64.rpm","mariadb-connector-c-devel-3.1.13-5.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3197.json"}},{"package":{"name":"mariadb-connector-c","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/mariadb-connector-c&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.3.19-1.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["mar