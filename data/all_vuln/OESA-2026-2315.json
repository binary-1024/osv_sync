{"schema_version":"1.9.0","id":"OESA-2026-2315","published":"2026-05-15T11:11:17Z","modified":"2026-08-18T01:19:53.710014195Z","upstream":["CVE-2026-30997"],"summary":"ffmpeg security update","details":"FFmpeg is a complete and free Internet live audio and video broadcasting solution for Linux/Unix. It also includes a digital VCR. It can encode in real time in many formats including MPEG1 audio and video, MPEG4, h263, ac3, asf, avi, real, mjpeg, and flash.\r\n\r\nSecurity Fix(es):\n\nAn out-of-bounds read in the read_global_param() function (libavcodec/av1dec.c) of FFmpeg v8.0.1 allows attackers to cause a Denial of Service (DoS) via a crafted input.(CVE-2026-30997)","affected":[{"package":{"name":"ffmpeg","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/ffmpeg&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"6.1.1-27.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["ffmpeg-6.1.1-27.oe2403sp3.aarch64.rpm","ffmpeg-debuginfo-6.1.1-27.oe2403sp3.aarch64.rpm","ffmpeg-debugsource-6.1.1-27.oe2403sp3.aarch64.rpm","ffmpeg-devel-6.1.1-27.oe2403sp3.aarch64.rpm","ffmpeg-libs-6.1.1-27.oe2403sp3.aarch64.rpm","libavdevice-6.1.1-27.oe2403sp3.aarch64.rpm"],"src":["ffmpeg-6.1.1-27.oe2403sp3.src.rpm"],"x86_64":["ffmpeg-6.1.1-27.oe2403sp3.x86_64.rpm","ffmpeg-debuginfo-6.1.1-27.oe2403sp3.x86_64.rpm","ffmpeg-debugsource-6.1.1-27.oe2403sp3.x86_64.rpm","ffmpeg-devel-6.1.1-27.oe2403sp3.x86_64.rpm","ffmpeg-libs-6.1.1-27.oe2403sp3.x86_64.rpm","libavdevice-6.1.1-27.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2315.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2315"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-30997"}],"database_specific":{"severity":"High"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"}]}