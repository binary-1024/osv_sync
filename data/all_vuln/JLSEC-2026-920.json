{"schema_version":"1.7.5","id":"JLSEC-2026-920","published":"2026-07-30T16:02:27.435Z","modified":"2026-07-30T18:23:59.394041250Z","upstream":["CVE-2025-55005","EUVD-2025-28577"],"details":"ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to version 7.1.2-1, when preparing to transform from Log to sRGB colorspaces, the logmap construction fails to handle cases where the reference-black or reference-white value is larger than 1024. This leads to corrupting memory beyond the end of the allocated logmap buffer. This issue has been patched in version 7.1.2-1.","affected":[{"package":{"name":"ImageMagick_jll","ecosystem":"Julia","purl":"pkg:julia/ImageMagick_jll?uuid=c73af94c-d91f-53ed-93a7-00f77d67a9d7"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"7.1.2001+0"}]}],"database_specific":{"source":"https://github.com/JuliaLang/SecurityAdvisories.jl/tree/generated/osv/2026/JLSEC-2026-920.json"}}],"references":[{"type":"WEB","url":"https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-v393-38qx-v8fp"},{"type":"WEB","url":"https://goo.gle/bigsleep"}],"database_specific":{"license":"CC-BY-4.0","sources":[{"database_specific":{"status":"Analyzed"},"html_url":"https://nvd.nist.gov/vuln/detail/CVE-2025-55005","id":"CVE-2025-55005","imported":"2026-07-30T14:08:44.168Z","modified":"2026-06-17T09:41:05.990Z","published":"2025-08-13T14:15:32.883Z","url":"https://services.nvd.nist.gov/rest/json/cves/2.0?cveId=CVE-2025-55005"},{"html_url":"https://euvd.enisa.europa.eu/vulnerability/EUVD-2025-28577","id":"EUVD-2025-28577","imported":"2026-07-30T14:08:56.003Z","modified":"2025-08-13T14:34:24Z","published":"2025-08-13T13:59:50Z","url":"https://euvdservices.enisa.europa.eu/api/enisaid?id=EUVD-2025-28577"}]},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:N/I:N/A:H"}]}