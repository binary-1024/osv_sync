{"schema_version":"1.7.5","id":"OESA-2026-2933","published":"2026-07-09T12:53:17Z","modified":"2026-07-14T08:15:09.567710806Z","upstream":["CVE-2026-57053"],"summary":"libidn security update","details":"GNU Libidn is a fully documented implementation of the Stringprep, Punycode and IDNA 2003 specifications. Libidn&amp;apos;s purpose is to encode and decode internationalized domain names.\r\n\r\nSecurity Fix(es):\n\nGNU libidn before 1.44 is prone to out-of-bounds reads of uninitialized memory in the ToUnicode APIs because of mishandling in idna_to_unicode_internal. The affected code is not present in libidn2.(CVE-2026-57053)","affected":[{"package":{"name":"libidn","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/libidn&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.41-2.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["libidn-1.41-2.oe2403sp3.aarch64.rpm","libidn-debuginfo-1.41-2.oe2403sp3.aarch64.rpm","libidn-debugsource-1.41-2.oe2403sp3.aarch64.rpm","libidn-devel-1.41-2.oe2403sp3.aarch64.rpm"],"noarch":["libidn-help-1.41-2.oe2403sp3.noarch.rpm"],"src":["libidn-1.41-2.oe2403sp3.src.rpm"],"x86_64":["libidn-1.41-2.oe2403sp3.x86_64.rpm","libidn-debuginfo-1.41-2.oe2403sp3.x86_64.rpm","libidn-debugsource-1.41-2.oe2403sp3.x86_64.rpm","libidn-devel-1.41-2.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2933.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2933"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-57053"}],"database_specific":{"severity":"Medium"}}