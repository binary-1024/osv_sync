{"schema_version":"1.9.0","id":"OESA-2026-3549","published":"2026-08-30T04:16:25Z","modified":"2026-08-30T04:31:43.389007791Z","upstream":["CVE-2025-2312"],"summary":"cifs-utils security update","details":"The in-kernel CIFS filesystem is generally the preferred method for mounting SMB/CIFS shares on Linux.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in cifs-utils. When trying to obtain Kerberos credentials, the cifs.upcall program from the cifs-utils package makes an upcall to the wrong namespace in containerized environments. This issue may lead to disclosing sensitive data from the host&apos;s Kerberos credentials cache.(CVE-2025-2312)","affected":[{"package":{"name":"cifs-utils","ecosystem":"openEuler:24.03-LTS-SP4","purl":"pkg:rpm/openEuler/cifs-utils&distro=openEuler-24.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"7.0-7.oe2403sp4"}]}],"ecosystem_specific":{"aarch64":["cifs-utils-7.0-7.oe2403sp4.aarch64.rpm","cifs-utils-debuginfo-7.0-7.oe2403sp4.aarch64.rpm","cifs-utils-debugsource-7.0-7.oe2403sp4.aarch64.rpm","cifs-utils-devel-7.0-7.oe2403sp4.aarch64.rpm","cifs-utils-help-7.0-7.oe2403sp4.aarch64.rpm"],"src":["cifs-utils-7.0-7.oe2403sp4.src.rpm"],"x86_64":["cifs-utils-7.0-7.oe2403sp4.x86_64.rpm","cifs-utils-debuginfo-7.0-7.oe2403sp4.x86_64.rpm","cifs-utils-debugsource-7.0-7.oe2403sp4.x86_64.rpm","cifs-utils-devel-7.0-7.oe2403sp4.x86_64.rpm","cifs-utils-help-7.0-7.oe2403sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-3549.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-3549"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2025-2312"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:C/C:H/I:N/A:N"}]}