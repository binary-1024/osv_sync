{"schema_version":"1.7.5","id":"JLSEC-2026-1027","published":"2026-07-30T16:02:27.435Z","modified":"2026-07-30T18:35:41.443860921Z","upstream":["CVE-2026-49219","EUVD-2026-36185","GHSA-xcjm-wqff-m669"],"summary":"ImageMagick: Policy Bypass can read disallowed files via symlink","details":"ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 6.9.13-48 and 7.1.2-24, an incorrect parsing of the filename can result in a policy bypass and read files disallowed by a security policy using a symlink. This issue has been patched in versions 6.9.13-48 and 7.1.2-24.","affected":[{"package":{"name":"ImageMagick_jll","ecosystem":"Julia","purl":"pkg:julia/ImageMagick_jll?uuid=c73af94c-d91f-53ed-93a7-00f77d67a9d7"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"7.1.2028+0"}]}],"database_specific":{"source":"https://github.com/JuliaLang/SecurityAdvisories.jl/tree/generated/osv/2026/JLSEC-2026-1027.json"}}],"references":[{"type":"WEB","url":"https://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-xcjm-wqff-m669"},{"type":"WEB","url":"https://github.com/advisories/GHSA-xcjm-wqff-m669"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-49219"}],"database_specific":{"license":"CC-BY-4.0","sources":[{"database_specific":{"status":"Analyzed"},"html_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-49219","id":"CVE-2026-49219","imported":"2026-07-30T14:08:47.763Z","modified":"2026-07-23T09:10:00.113Z","published":"2026-06-10T23:16:49.637Z","url":"https://services.nvd.nist.gov/rest/json/cves/2.0?cveId=CVE-2026-49219"},{"html_url":"https://github.com/advisories/GHSA-xcjm-wqff-m669","id":"GHSA-xcjm-wqff-m669","imported":"2026-07-30T14:09:51.923Z","modified":"2026-06-25T21:53:30Z","published":"2026-06-25T21:53:29Z","url":"https://api.github.com/advisories/GHSA-xcjm-wqff-m669"},{"html_url":"https://euvd.enisa.europa.eu/vulnerability/EUVD-2026-36185","id":"EUVD-2026-36185","imported":"2026-07-3