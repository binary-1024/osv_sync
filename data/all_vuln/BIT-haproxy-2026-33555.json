{"schema_version":"1.9.0","id":"BIT-haproxy-2026-33555","published":"2026-06-30T23:39:33.320Z","modified":"2026-09-10T16:01:39.461941125Z","aliases":["CVE-2026-33555"],"details":"An issue was discovered in HAProxy before 3.3.6. The HTTP/3 parser does not check that the received body length matches a previously announced content-length when the stream is closed via a frame with an empty payload. This can cause desynchronization issues with the backend server and could be used for request smuggling. The earliest affected version is 2.6.","affected":[{"package":{"name":"haproxy","ecosystem":"Bitnami","purl":"pkg:bitnami/haproxy"},"ranges":[{"type":"SEMVER","events":[{"introduced":"2.6.0"},{"fixed":"3.3.6"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/haproxy/BIT-haproxy-2026-33555.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:C/C:N/I:L/A:N"}]}],"references":[{"type":"FIX","url":"https://github.com/haproxy/haproxy/commit/05a295441c621089ffa4318daf0dbca2dd756a84"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-33555"},{"type":"ADVISORY","url":"https://r3verii.github.io/cve/2026/04/14/haproxy-h3-standalone-fin-smuggling.html"},{"type":"ARTICLE","url":"https://www.haproxy.com/documentation/haproxy-aloha/changelog/"},{"type":"WEB","url":"https://www.haproxy.org"},{"type":"ARTICLE","url":"https://www.mail-archive.com/haproxy@formilux.org/msg46752.html"}],"database_specific":{"cpes":["cpe:2.3:a:haproxy:haproxy:*:*:*:*:*:*:*:*"],"severity":"Medium"}}