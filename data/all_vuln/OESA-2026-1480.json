{"schema_version":"1.9.0","id":"OESA-2026-1480","published":"2026-02-28T11:10:29Z","modified":"2026-08-18T01:19:35.272427348Z","upstream":["CVE-2026-25990"],"summary":"python-pillow security update","details":"Pillow is the friendly PIL fork by Alex Clark and Contributors. PIL is the Python Imaging \\ Library by Fredrik Lundh and Contributors. As of 2019, Pillow development is supported by Tidelift.   %package -n python3-pillow Summary:        Python 3 image processing library  Provides:       python3-imaging = -\r\n\r\nSecurity Fix(es):\n\nPillow is a Python imaging library. From 10.3.0 to before 12.1.1, n out-of-bounds write may be triggered when loading a specially crafted PSD image. This vulnerability is fixed in 12.1.1.(CVE-2026-25990)","affected":[{"package":{"name":"python-pillow","ecosystem":"openEuler:24.03-LTS-SP3","purl":"pkg:rpm/openEuler/python-pillow&distro=openEuler-24.03-LTS-SP3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"10.3.0-2.oe2403sp3"}]}],"ecosystem_specific":{"aarch64":["python-pillow-debuginfo-10.3.0-2.oe2403sp3.aarch64.rpm","python-pillow-debugsource-10.3.0-2.oe2403sp3.aarch64.rpm","python3-pillow-10.3.0-2.oe2403sp3.aarch64.rpm","python3-pillow-devel-10.3.0-2.oe2403sp3.aarch64.rpm","python3-pillow-qt-10.3.0-2.oe2403sp3.aarch64.rpm","python3-pillow-tk-10.3.0-2.oe2403sp3.aarch64.rpm"],"noarch":["python3-pillow-help-10.3.0-2.oe2403sp3.noarch.rpm"],"src":["python-pillow-10.3.0-2.oe2403sp3.src.rpm"],"x86_64":["python-pillow-debuginfo-10.3.0-2.oe2403sp3.x86_64.rpm","python-pillow-debugsource-10.3.0-2.oe2403sp3.x86_64.rpm","python3-pillow-10.3.0-2.oe2403sp3.x86_64.rpm","python3-pillow-devel-10.3.0-2.oe2403sp3.x86_64.rpm","python3-pillow-qt-10.3.0-2.oe2403sp3.x86_64.rpm","python3-pillow-tk-10.3.0-2.oe2403sp3.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1480.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail