{"schema_version":"1.9.0","id":"DRUPAL-CONTRIB-2026-114","published":"2026-08-26T17:42:20Z","modified":"2026-08-26T22:30:05.532756639Z","aliases":["CVE-2026-81164"],"details":"The Entity PDF module can create a PDF from any entity based on any View mode.\n\nThis module does not check entity view access when fetching a PDF route. This could result in a user accessing a PDF of an entity that they should not be able to view.","affected":[{"package":{"name":"drupal/entity_pdf","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/entity_pdf?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.1.5"}],"database_specific":{"constraint":"<2.1.5"}}],"database_specific":{"affected_versions":"<2.1.5","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/entity_pdf/DRUPAL-CONTRIB-2026-114.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-114"}],"credits":[{"name":"Marcus Johansson (marcus_johansson)","contact":["https://www.drupal.org/u/marcus_johansson"]}]}