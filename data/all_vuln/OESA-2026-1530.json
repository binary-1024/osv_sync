{"schema_version":"1.9.0","id":"OESA-2026-1530","published":"2026-03-06T11:10:32Z","modified":"2026-08-18T01:19:36.897037560Z","upstream":["CVE-2025-55753"],"summary":"httpd security update","details":"Apache HTTP Server is a powerful and flexible HTTP/1.1 compliant web server.\r\n\r\nSecurity Fix(es):\n\nAn integer overflow vulnerability was found in Apache HTTP Server versions 2.4.30 to 2.4.66. In case of failed ACME certificate renewal, after a number of failures (~30 days in default configurations), the backoff timer becomes 0. Certificate renewal attempts are then repeated without delays until successful. This issue affects confidentiality, integrity, and availability.(CVE-2025-55753)","affected":[{"package":{"name":"httpd","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/httpd&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.4.51-27.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["httpd-2.4.51-27.oe2203sp4.aarch64.rpm","httpd-debuginfo-2.4.51-27.oe2203sp4.aarch64.rpm","httpd-debugsource-2.4.51-27.oe2203sp4.aarch64.rpm","httpd-devel-2.4.51-27.oe2203sp4.aarch64.rpm","httpd-tools-2.4.51-27.oe2203sp4.aarch64.rpm","mod_ldap-2.4.51-27.oe2203sp4.aarch64.rpm","mod_md-2.4.51-27.oe2203sp4.aarch64.rpm","mod_proxy_html-2.4.51-27.oe2203sp4.aarch64.rpm","mod_session-2.4.51-27.oe2203sp4.aarch64.rpm","mod_ssl-2.4.51-27.oe2203sp4.aarch64.rpm"],"noarch":["httpd-filesystem-2.4.51-27.oe2203sp4.noarch.rpm","httpd-help-2.4.51-27.oe2203sp4.noarch.rpm"],"src":["httpd-2.4.51-27.oe2203sp4.src.rpm"],"x86_64":["httpd-2.4.51-27.oe2203sp4.x86_64.rpm","httpd-debuginfo-2.4.51-27.oe2203sp4.x86_64.rpm","httpd-debugsource-2.4.51-27.oe2203sp4.x86_64.rpm","httpd-devel-2.4.51-27.oe2203sp4.x86_64.rpm","httpd-tools-2.4.51-27.oe2203sp4.x86_64.rpm","mod_ldap-2.4.51-27.oe2203sp4.x86_64.rpm","mod_md-2.4.51-27.oe2203sp4.x86_64.rpm","mod_proxy_html-2.4.51-27.oe2203sp4.x86_64.rpm","mod_session-2.4.51-27.oe2203sp4.x86_64.rpm","mod_ssl-2.4