{"schema_version":"1.7.5","id":"OESA-2026-2937","published":"2026-07-09T12:53:27Z","modified":"2026-07-14T08:15:09.666836464Z","upstream":["CVE-2026-10649"],"summary":"pacemaker security update","details":"Pacemaker is an advanced, scalable High-Availability cluster resource manager.\r\n\r\nSecurity Fix(es):\n\nA flaw was found in Pacemaker. An unauthenticated remote attacker can exploit an integer overflow vulnerability in the remote message decompression process. By sending a specially crafted compressed remote message before authentication, an attacker can cause memory corruption, leading to a denial of service (DoS) in the CIB remote listener. This can result in the affected service crashing.(CVE-2026-10649)","affected":[{"package":{"name":"pacemaker","ecosystem":"openEuler:24.03-LTS-SP1","purl":"pkg:rpm/openEuler/pacemaker&distro=openEuler-24.03-LTS-SP1"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.1.7-12.oe2403sp1"}]}],"ecosystem_specific":{"aarch64":["pacemaker-2.1.7-12.oe2403sp1.aarch64.rpm","pacemaker-cli-2.1.7-12.oe2403sp1.aarch64.rpm","pacemaker-cluster-libs-2.1.7-12.oe2403sp1.aarch64.rpm","pacemaker-debuginfo-2.1.7-12.oe2403sp1.aarch64.rpm","pacemaker-debugsource-2.1.7-12.oe2403sp1.aarch64.rpm","pacemaker-libs-2.1.7-12.oe2403sp1.aarch64.rpm","pacemaker-libs-devel-2.1.7-12.oe2403sp1.aarch64.rpm","pacemaker-remote-2.1.7-12.oe2403sp1.aarch64.rpm"],"noarch":["pacemaker-cts-2.1.7-12.oe2403sp1.noarch.rpm","pacemaker-doc-2.1.7-12.oe2403sp1.noarch.rpm","pacemaker-nagios-plugins-metadata-2.1.7-12.oe2403sp1.noarch.rpm","pacemaker-schemas-2.1.7-12.oe2403sp1.noarch.rpm","python3-pacemaker-2.1.7-12.oe2403sp1.noarch.rpm"],"src":["pacemaker-2.1.7-12.oe2403sp1.src.rpm"],"x86_64":["pacemaker-2.1.7-12.oe2403sp1.x86_64.rpm","pacemaker-cli-2.1.7-12.oe2403sp1.x86_64.rpm","pacemaker-cluster-libs-2.1.7-12.oe2403sp1.x86_64.rpm","pacemaker-debuginfo-2.1.7-12.oe2403sp1.x86_64.rpm","pacemaker-debugsource-2.1.7-12.oe2403sp1.x86_64.rpm","pacemaker-libs-2.1.7-12.oe2403sp1.x86_64.rpm","pacemaker-libs-devel-2.1.7-12.oe2403sp1.x86_64.rpm","pacemaker-remote-2.1.7-12.oe2403sp1.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2937.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2937"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-10649"}],"database_specific":{"severity":"High"}}