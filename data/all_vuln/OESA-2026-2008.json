{"schema_version":"1.7.5","id":"OESA-2026-2008","published":"2026-04-25T05:48:02Z","modified":"2026-04-25T06:03:21.171346Z","upstream":["CVE-2026-41066"],"summary":"python-lxml security update","details":"\\\r\n\r\nSecurity Fix(es):\n\nlxml is a library for processing XML and HTML in the Python language. Prior to 6.1.0, using either of the two parsers in the default configuration (with resolve_entities=True) allows untrusted XML input to read local files. Setting the resolve_entities option explicitly to resolve_entities=&apos;internal&apos; or resolve_entities=False disables the local file access. This vulnerability is fixed in 6.1.0.(CVE-2026-41066)","affected":[{"package":{"name":"python-lxml","ecosystem":"openEuler:24.03-LTS","purl":"pkg:rpm/openEuler/python-lxml&distro=openEuler-24.03-LTS"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.1.0-4.oe2403"}]}],"ecosystem_specific":{"aarch64":["python-lxml-debuginfo-5.1.0-4.oe2403.aarch64.rpm","python-lxml-debugsource-5.1.0-4.oe2403.aarch64.rpm","python-lxml-help-5.1.0-4.oe2403.aarch64.rpm","python3-lxml-5.1.0-4.oe2403.aarch64.rpm"],"src":["python-lxml-5.1.0-4.oe2403.src.rpm"],"x86_64":["python-lxml-debuginfo-5.1.0-4.oe2403.x86_64.rpm","python-lxml-debugsource-5.1.0-4.oe2403.x86_64.rpm","python-lxml-help-5.1.0-4.oe2403.x86_64.rpm","python3-lxml-5.1.0-4.oe2403.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-2008.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-2008"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-41066"}],"database_specific":{"severity":"High"}}