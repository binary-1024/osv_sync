{"schema_version":"1.9.0","id":"OESA-2026-1379","published":"2026-02-13T11:10:24Z","modified":"2026-08-18T01:19:33.392910995Z","upstream":["CVE-2026-24515","CVE-2026-25210"],"summary":"expat security update","details":"expat is a stream-oriented XML parser library written in C. expat excels with files too large to fit RAM, and where performance and flexibility are crucial.\r\n\r\nSecurity Fix(es):\n\nIn libexpat before 2.7.4, XML_ExternalEntityParserCreate does not copy unknown encoding handler user data.(CVE-2026-24515)\n\nIn libexpat before 2.7.4, the doContent function does not properly determine the buffer size bufSize because there is no integer overflow check for tag buffer reallocation.(CVE-2026-25210)","affected":[{"package":{"name":"expat","ecosystem":"openEuler:22.03-LTS-SP4","purl":"pkg:rpm/openEuler/expat&distro=openEuler-22.03-LTS-SP4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.4.1-21.oe2203sp4"}]}],"ecosystem_specific":{"aarch64":["expat-2.4.1-21.oe2203sp4.aarch64.rpm","expat-debuginfo-2.4.1-21.oe2203sp4.aarch64.rpm","expat-debugsource-2.4.1-21.oe2203sp4.aarch64.rpm","expat-devel-2.4.1-21.oe2203sp4.aarch64.rpm"],"noarch":["expat-help-2.4.1-21.oe2203sp4.noarch.rpm"],"src":["expat-2.4.1-21.oe2203sp4.src.rpm"],"x86_64":["expat-2.4.1-21.oe2203sp4.x86_64.rpm","expat-debuginfo-2.4.1-21.oe2203sp4.x86_64.rpm","expat-debugsource-2.4.1-21.oe2203sp4.x86_64.rpm","expat-devel-2.4.1-21.oe2203sp4.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1379.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1379"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-24515"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-25210"}],"database_specific":{"severity":"Medium"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:L"}]}