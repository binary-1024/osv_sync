{"schema_version":"1.7.5","id":"MGASA-2015-0278","published":"2015-07-24T16:36:06Z","modified":"2026-04-16T06:22:28.597347970Z","upstream":["CVE-2015-3245","CVE-2015-3246"],"summary":"Updated libuser package fixes security vulnerabilities","details":"Two flaws were found in the way the libuser library handled the\n/etc/passwd file. A local attacker could use an application compiled\nagainst libuser (for example, userhelper) to manipulate the /etc/passwd\nfile, which could result in a denial of service or possibly allow the\nattacker to escalate their privileges to root (CVE-2015-3245,\nCVE-2015-3246).\n","affected":[{"package":{"name":"libuser","ecosystem":"Mageia:4","purl":"pkg:rpm/mageia/libuser?arch=source&distro=mageia-4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.60-2.1.mga4"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2015-0278.json"}},{"package":{"name":"libuser","ecosystem":"Mageia:5","purl":"pkg:rpm/mageia/libuser?arch=source&distro=mageia-5"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.60-5.1.mga5"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2015-0278.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2015-0278.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=16459"},{"type":"WEB","url":"https://securityblog.redhat.com/2015/07/23/libuser-vulnerabilities/"},{"type":"WEB","url":"https://access.redhat.com/articles/1537873"},{"type":"WEB","url":"http://openwall.com/lists/oss-security/2015/07/23/16"},{"type":"WEB","url":"https://rhn.redhat.com/errata/RHSA-2015-1483.html"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}