{"schema_version":"1.9.2","id":"MGASA-2026-0585","published":"2026-11-09T16:32:57Z","modified":"2026-11-09T16:45:57.396926968Z","upstream":["CVE-2026-82531"],"summary":"Updated php-smarty package fixes a security vulnerability","details":"Smarty before 4.5.8 and 5.x before 5.8.5 contains a code injection\nvulnerability where the top-level nocache_hash is never restored during\nextends:/multi-component template inheritance, leaving it null.\nAttackers can supply assigned data containing a forged SmartyNocache\nmarker that is copied verbatim into the regenerated PHP cache file,\nexecuting arbitrary PHP on include for remote code execution.\n","affected":[{"package":{"name":"php-smarty","ecosystem":"Mageia:10","purl":"pkg:rpm/mageia/php-smarty?arch=source&distro=mageia-10"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.8.5-1.mga10"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2026-0585.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2026-0585.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=36622"},{"type":"WEB","url":"https://github.com/smarty-php/smarty/releases#release-v5.8.5"},{"type":"WEB","url":"https://github.com/smarty-php/smarty/releases#release-v5.8.4"},{"type":"WEB","url":"https://github.com/smarty-php/smarty/releases#release-v5.8.3"},{"type":"WEB","url":"https://github.com/smarty-php/smarty/releases#release-v5.8.2"},{"type":"WEB","url":"https://github.com/smarty-php/smarty/releases#release-v5.8.1"},{"type":"WEB","url":"https://github.com/smarty-php/smarty/releases#release-v5.8.0"},{"type":"ADVISORY","url":"https://github.com/smarty-php/smarty/security/advisories/GHSA-3w63-v7pm-cq9x"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}