{"schema_version":"1.7.5","id":"MGASA-2021-0118","published":"2021-03-12T01:25:47Z","modified":"2026-04-16T04:42:18.926878178Z","upstream":["CVE-2020-14145"],"summary":"Updated openssh packages fix a security vulnerability","details":"The client side in OpenSSH 5.7 through 8.3 has an Observable Discrepancy\nleading to an information leak in the algorithm negotiation. This allows\nman-in-the-middle attackers to target initial connection attempts (where no\nhost key for the server has been cached by the client) (CVE-2020-14145).\n","affected":[{"package":{"name":"openssh","ecosystem":"Mageia:7","purl":"pkg:rpm/mageia/openssh?arch=source&distro=mageia-7"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"8.0p1-1.1.mga7"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2021-0118.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2021-0118.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=27706"},{"type":"WEB","url":"https://lists.opensuse.org/archives/list/security-announce@lists.opensuse.org/thread/OTSUNUWKKFI2BZV3IR5RLHAQFXINNKM7/"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}