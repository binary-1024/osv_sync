{"schema_version":"1.7.5","id":"MGASA-2014-0355","published":"2014-08-26T23:04:56Z","modified":"2026-04-16T06:24:42.857481124Z","upstream":["CVE-2014-4607"],"summary":"Updated harbour package fixes security vulnerability","details":"An integer overflow in liblzo before 2.07 allows attackers to cause a\ndenial of service or possibly code execution in applications using\nperforming LZO decompression on a compressed payload from the attacker\n(CVE-2014-4607).\n\nThe harbour is built with a bundled copy of minilzo, which is a part of\nliblzo containing the vulnerable code. This update is patched to update\nthe bundled minilzo to version 2.8.\n","affected":[{"package":{"name":"harbour","ecosystem":"Mageia:3","purl":"pkg:rpm/mageia/harbour?arch=source&distro=mageia-3"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.2.0-0.18748_111.3.mga3"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2014-0355.json"}},{"package":{"name":"harbour","ecosystem":"Mageia:4","purl":"pkg:rpm/mageia/harbour?arch=source&distro=mageia-4"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"3.2.0-1.18925.255.3.mga4"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2014-0355.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2014-0355.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=13934"},{"type":"WEB","url":"http://www.oberhumer.com/opensource/lzo/#news"},{"type":"ADVISORY","url":"http://advisories.mageia.org/MGASA-2014-0290.html"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}