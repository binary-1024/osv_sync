{"schema_version":"1.9.0","id":"MGASA-2026-0474","published":"2026-10-09T17:00:24Z","modified":"2026-10-09T17:15:03.305201403Z","upstream":["CVE-2026-32239","CVE-2026-32240"],"summary":"Updated capnproto package fixes security vulnerabilities","details":"A negative Content-Length value was converted to unsigned, treating it\nas an impossibly large length instead (CVE-2026-32239).\nWhen using Transfer-Encoding: chunked, if a chunk's size parsed to a\nvalue of 2^64 or larger, it would be truncated to a 64-bit integer\n(CVE-2026-32240).\n","affected":[{"package":{"name":"capnproto","ecosystem":"Mageia:10","purl":"pkg:rpm/mageia/capnproto?arch=source&distro=mageia-10"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.5.0-1.mga10"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2026-0474.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2026-0474.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=36190"},{"type":"ADVISORY","url":"https://ubuntu.com/security/notices/USN-8650-1"},{"type":"ADVISORY","url":"https://github.com/capnproto/capnproto/security/advisories/GHSA-qjx3-pp3m-9jpm"},{"type":"ADVISORY","url":"https://github.com/capnproto/capnproto/security/advisories/GHSA-vpcq-mx5v-32wm"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}