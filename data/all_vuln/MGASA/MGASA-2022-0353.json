{"schema_version":"1.7.5","id":"MGASA-2022-0353","published":"2022-10-01T17:48:24Z","modified":"2026-04-16T04:41:18.267309822Z","upstream":["CVE-2021-46822"],"summary":"Updated libjpeg packages fix security vulnerability","details":"The PPM reader in libjpeg-turbo through 2.0.90 mishandles use of\ntjLoadImage for loading a 16-bit binary PPM file into a grayscale buffer\nand loading a 16-bit binary PGM file into an RGB buffer. This is related\nto a heap-based buffer overflow in the get_word_rgb_row function in\nrdppm.c. (CVE-2021-46822)\n","affected":[{"package":{"name":"libjpeg","ecosystem":"Mageia:8","purl":"pkg:rpm/mageia/libjpeg?arch=source&distro=mageia-8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.0.8-1.mga8"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2022-0353.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2022-0353.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=30886"},{"type":"ADVISORY","url":"https://ubuntu.com/security/notices/USN-5631-1"},{"type":"WEB","url":"https://github.com/libjpeg-turbo/libjpeg-turbo/blob/2.0.8-esr/ChangeLog.md"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}