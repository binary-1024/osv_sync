{"schema_version":"1.7.5","id":"MGASA-2026-0146","published":"2026-05-16T23:54:18Z","modified":"2026-05-17T00:00:07.266443Z","upstream":["CVE-2026-33555"],"summary":"Updated haproxy packages fix security vulnerability","details":"The HTTP/3 parser does not check that the received body length matches a\npreviously announced content-length when the stream is closed via a\nframe with an empty payload. This can cause desynchronization issues\nwith the backend server and could be used for request smuggling.\n(CVE-2026-33555)\n","affected":[{"package":{"name":"haproxy","ecosystem":"Mageia:9","purl":"pkg:rpm/mageia/haproxy?arch=source&distro=mageia-9"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.8.18-1.1.mga9"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2026-0146.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2026-0146.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=35416"},{"type":"WEB","url":"https://lists.opensuse.org/archives/list/security-announce@lists.opensuse.org/message/B3PXHUYDTDFG5IIQSPNJLLIEQV4Z5WK6/"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}