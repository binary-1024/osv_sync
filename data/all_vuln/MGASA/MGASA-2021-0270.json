{"schema_version":"1.7.5","id":"MGASA-2021-0270","published":"2021-06-23T17:11:28Z","modified":"2026-04-16T04:41:55.876758932Z","upstream":["CVE-2018-21035"],"summary":"Updated qtwebsockets5 packages fix a security vulnerability","details":"In Qt through 5.14.1, the WebSocket implementation accepts up to 2GB for \nframes and 2GB for messages. Smaller limits cannot be configured. This makes \nit easier for attackers to cause a denial of service (memory consumption)\n(CVE-2018-21035).\n","affected":[{"package":{"name":"qtwebsockets5","ecosystem":"Mageia:7","purl":"pkg:rpm/mageia/qtwebsockets5?arch=source&distro=mageia-7"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.12.6-1.1.mga7"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2021-0270.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2021-0270.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=27560"},{"type":"WEB","url":"https://access.redhat.com/errata/RHSA-2020:4690"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}