{"schema_version":"1.7.5","id":"MGASA-2016-0430","published":"2016-12-29T23:39:37Z","modified":"2026-04-16T06:24:08.466460536Z","upstream":["CVE-2016-9920"],"summary":"Updated roundcubemail packages fix security vulnerability","details":"Users can execute commands on the server by writing e-mails, due to\ninsufficient sanitation of the from field when calling PHP's mail()\nfunction (CVE-2016-9920).\n\nNote that only roundcubemail installations that don't have an SMTP\nserver configured for mail delivery are affected.\n","affected":[{"package":{"name":"roundcubemail","ecosystem":"Mageia:5","purl":"pkg:rpm/mageia/roundcubemail?arch=source&distro=mageia-5"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.0.9-1.1.mga5"}]}],"ecosystem_specific":{"section":"core"},"database_specific":{"source":"https://advisories.mageia.org/MGASA-2016-0430.json"}}],"references":[{"type":"ADVISORY","url":"https://advisories.mageia.org/MGASA-2016-0430.html"},{"type":"REPORT","url":"https://bugs.mageia.org/show_bug.cgi?id=19920"},{"type":"WEB","url":"https://blog.ripstech.com/2016/roundcube-command-execution-via-email/"},{"type":"WEB","url":"http://openwall.com/lists/oss-security/2016/12/08/17"}],"credits":[{"name":"Mageia","contact":["https://wiki.mageia.org/en/Packages_Security_Team"],"type":"COORDINATOR"}]}