{"schema_version":"1.9.0","id":"GHSA-2q7c-5gjm-7q23","published":"2026-06-10T00:31:51Z","modified":"2026-08-12T17:15:07.299046356Z","aliases":["CVE-2026-40993"],"summary":"Spring Security SAML2 Service Provider is vulnerable to Deserialization of Untrusted Data via JdbcAssertingPartyMetadataRepository","details":"An attacker with write permissions to the database table managed by JdbcAssertingPartyMetadataRepository (saml2_asserting_party_metadata) may be able to store malicious serialized payloads in the columns containing the collection of verification or encryption credentials (verification_credentials and encryption_credentials, respectively).\n\nAffected versions:\nSpring Security 7.0.0 through 7.0.5.","affected":[{"package":{"name":"org.springframework.security:spring-security-saml2-service-provider","ecosystem":"Maven","purl":"pkg:maven/org.springframework.security/spring-security-saml2-service-provider"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"7.0.0"},{"fixed":"7.0.6"}]}],"versions":["7.0.0","7.0.1","7.0.2","7.0.3","7.0.4","7.0.5"],"database_specific":{"last_known_affected_version_range":"<= 7.0.5","source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/06/GHSA-2q7c-5gjm-7q23/GHSA-2q7c-5gjm-7q23.json"}}],"references":[{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-40993"},{"type":"PACKAGE","url":"https://github.com/spring-projects/spring-security"},{"type":"WEB","url":"https://github.com/spring-projects/spring-security/releases/tag/7.0.6"},{"type":"WEB","url":"https://spring.io/security/cve-2026-40993"}],"database_specific":{"cwe_ids":["CWE-502"],"github_reviewed":true,"github_reviewed_at":"2026-08-12T17:04:26Z","nvd_published_at":"2026-06-10T00:16:50Z","severity":"HIGH"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:A/AC:H/PR:H/UI:N/S:C/C:N/I:H/A:H"}]}