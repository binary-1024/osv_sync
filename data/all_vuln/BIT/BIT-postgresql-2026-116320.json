{"schema_version":"1.9.2","id":"BIT-postgresql-2026-116320","published":"2026-11-27T05:52:15.726Z","modified":"2026-11-27T06:45:43.148433537Z","aliases":["CVE-2026-116320"],"summary":"PostgreSQL plperl array and hash conversion use-after-free executes arbitrary code","details":"Use after free in PostgreSQL plperl allows an object creator to execute arbitrary code as the operating system user running the database, via dropping the final reference to a Perl array or hash while PostgreSQL is converting that object.  Versions before PostgreSQL 18.7, 17.12, 16.16, 15.20, and 14.25 are affected.","affected":[{"package":{"name":"postgresql","ecosystem":"Bitnami","purl":"pkg:bitnami/postgresql"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"14.25.0"},{"introduced":"15.0.0"},{"fixed":"15.20.0"},{"introduced":"16.0.0"},{"fixed":"16.16.0"},{"introduced":"17.0.0"},{"fixed":"17.12.0"},{"introduced":"18.0.0"},{"fixed":"18.7.0"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/postgresql/BIT-postgresql-2026-116320.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H"}]}],"references":[{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-116320"},{"type":"WEB","url":"https://www.postgresql.org/support/security/CVE-2026-116320/"}],"database_specific":{"cpes":["cpe:2.3:a:postgresql:postgresql:*:*:*:*:*:*:*:*"],"severity":"High"}}