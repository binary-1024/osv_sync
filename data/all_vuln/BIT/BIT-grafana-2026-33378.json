{"schema_version":"1.9.0","id":"BIT-grafana-2026-33378","published":"2026-05-15T08:42:47.427Z","modified":"2026-09-08T08:47:51.487010043Z","aliases":["CVE-2026-33378"],"summary":"Grafana Data Source Plugin: DoS (OOM) via Negative Interval Injection in $__timeGroup Macro","details":"Using the $__timeGroup macro, one can achieve an OOM by overloading the server. This requires a SQL datasource. If the server is set up to auto-restart, the impact is minimal or non-existent, as the attack can take upwards of half an hour to crash the server.","affected":[{"package":{"name":"grafana","ecosystem":"Bitnami","purl":"pkg:bitnami/grafana"},"ranges":[{"type":"SEMVER","events":[{"introduced":"8.0.0"},{"fixed":"11.6.14"},{"introduced":"12.0.0"},{"fixed":"12.2.8"},{"introduced":"12.3.0"},{"fixed":"12.3.6"},{"introduced":"12.4.0"},{"fixed":"12.4.3"},{"introduced":"13.0.0"},{"fixed":"13.0.1"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/grafana/BIT-grafana-2026-33378.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H"}]}],"references":[{"type":"ADVISORY","url":"https://grafana.com/security/security-advisories/cve-2026-33378"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-33378"}],"database_specific":{"cpes":["cpe:2.3:a:grafana:grafana:*:*:*:*:*:go:*:*"],"severity":"Medium"}}