{"schema_version":"1.9.0","id":"BIT-ghost-2026-105652","published":"2026-10-13T06:50:23.382Z","modified":"2026-10-13T08:25:43.802827486Z","aliases":["BIT-ghost-2026-104415","CVE-2026-104415","CVE-2026-105652","GHSA-53vv-xm9f-mm82"],"summary":"Ghost: Password Hash Ordering Disclosure in Ghost Admin API","details":"Ghost is a Node.js content management system. From 0.7.2 until 6.64.0, any staff-level user was able to determine the relative ordering of other staff users' hashed passwords. This does not directly disclose password hashes, and does not provide a practical path to recovering a password. This issue is fixed in version 6.64.0.","affected":[{"package":{"name":"ghost","ecosystem":"Bitnami","purl":"pkg:bitnami/ghost"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0.7.2"},{"fixed":"6.64.0"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/ghost/BIT-ghost-2026-105652.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:L/I:N/A:N"}]}],"references":[{"type":"WEB","url":"https://github.com/TryGhost/Ghost/commit/4fb587e4d49667f929b87f7d6a873ae5e9cc087f"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/pull/30760"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/releases/tag/v6.64.0"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/security/advisories/GHSA-53vv-xm9f-mm82"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-105652"}],"database_specific":{"cpes":["cpe:2.3:a:ghost:ghost:*:*:*:*:*:node.js:*:*"],"severity":"Low"}}