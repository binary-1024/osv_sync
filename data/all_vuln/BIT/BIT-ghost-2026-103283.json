{"schema_version":"1.9.0","id":"BIT-ghost-2026-103283","published":"2026-10-09T10:45:02.001Z","modified":"2026-10-09T12:10:28.365908665Z","aliases":["CVE-2026-103283","GHSA-q55r-w7fh-rmh6"],"summary":"Ghost 6.20.0 before 6.57.1 Authentication Bypass via Session Handling","details":"Ghost versions 6.20.0 before 6.57.1 contain a session handling vulnerability that allows authenticated staff users to log in as any other staff user with only the password, bypassing two-factor authentication. Attackers with valid staff credentials can exploit improper session management to impersonate other staff members and gain unauthorized access to administrative functions.","affected":[{"package":{"name":"ghost","ecosystem":"Bitnami","purl":"pkg:bitnami/ghost"},"ranges":[{"type":"SEMVER","events":[{"introduced":"6.20.0"},{"fixed":"6.57.1"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/ghost/BIT-ghost-2026-103283.json"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X"}]}],"references":[{"type":"WEB","url":"https://github.com/TryGhost/Ghost/security/advisories/GHSA-q55r-w7fh-rmh6"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-103283"},{"type":"WEB","url":"https://www.vulncheck.com/advisories/ghost-6.20.0-before-6.57.1-authentication-bypass-via-session-handling"}],"database_specific":{"cpes":["cpe:2.3:a:ghost:ghost:*:*:*:*:*:node.js:*:*"],"severity":"High"}}