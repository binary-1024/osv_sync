{"schema_version":"1.9.2","id":"BIT-parse-2026-116801","published":"2026-11-17T11:55:46.459Z","modified":"2026-11-17T13:40:55.509858767Z","aliases":["CVE-2026-116801","GHSA-58m4-cqvw-4vgh"],"summary":"Parse Server 9.0.0 before 9.10.5 ACL Bypass via $relatedTo Query","details":"Parse Server before 8.6.105 and 9.0.0 before 9.10.5 does not validate the owning object reference in $relatedTo relation queries, so supplying a query operator instead of an object ID bypasses the owning-object ACL check. A client with read access to at least one object of the owning class can disclose which readable objects are linked to owning objects it cannot read.","affected":[{"package":{"name":"parse","ecosystem":"Bitnami","purl":"pkg:bitnami/parse"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"8.6.105"},{"introduced":"9.0.0"},{"fixed":"9.10.5"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/parse/BIT-parse-2026-116801.json"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X"}]}],"references":[{"type":"WEB","url":"https://github.com/parse-community/parse-server/security/advisories/GHSA-58m4-cqvw-4vgh"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-116801"},{"type":"WEB","url":"https://www.vulncheck.com/advisories/parse-server-9.0.0-before-9.10.5-alpha.6-acl-bypass-via-relatedto-query"}],"database_specific":{"cpes":["cpe:2.3:a:parseplatform:parse-server:*:*:*:*:*:node.js:*:*"],"severity":"Medium"}}