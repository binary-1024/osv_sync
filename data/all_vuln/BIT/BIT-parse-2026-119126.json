{"schema_version":"1.9.2","id":"BIT-parse-2026-119126","published":"2026-11-17T11:55:49.263Z","modified":"2026-11-17T13:40:45.961623251Z","aliases":["CVE-2026-119126","GHSA-969q-274f-mc7w"],"summary":"Parse Server before 8.6.106 and 9.0.0 before 9.10.5 afterSave Trigger and LiveQuery Bypass via Dot Notation Keys","details":"Parse Server before 8.6.106 and 9.0.0 before 9.10.5 mishandles dot notation keys with null or undefined values when building the saved object, so a write is stored but returns an error and skips afterSave triggers and LiveQuery events. A client with write access can exploit this to evade audit logging, notifications, and derived data updates.","affected":[{"package":{"name":"parse","ecosystem":"Bitnami","purl":"pkg:bitnami/parse"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"8.6.106"},{"introduced":"9.0.0"},{"fixed":"9.10.5"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/parse/BIT-parse-2026-119126.json"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X"}]}],"references":[{"type":"WEB","url":"https://github.com/parse-community/parse-server/security/advisories/GHSA-969q-274f-mc7w"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-119126"},{"type":"WEB","url":"https://www.vulncheck.com/advisories/parse-server-before-8.6.106-and-9.0.0-before-9.10.5-alpha.7-aftersave-trigger-and-livequery-bypass-via-dot-notation-keys"}],"database_specific":{"cpes":["cpe:2.3:a:parseplatform:parse-server:*:*:*:*:*:node.js:*:*"],"severity":"Low"}}