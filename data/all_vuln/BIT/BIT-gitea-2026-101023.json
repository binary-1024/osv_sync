{"schema_version":"1.9.0","id":"BIT-gitea-2026-101023","published":"2026-10-14T08:42:36.604Z","modified":"2026-10-14T11:11:10.730826820Z","aliases":["CVE-2026-101023","GHSA-469m-x4mw-38r3"],"summary":"Gitea OAuth2 refresh token grant accepts access tokens","details":"Gitea's OAuth2 token endpoint verified the signature and grant of a token submitted with the `refresh_token` grant type, but not that the token was a refresh token. An unexpired access token for the same OAuth2 application and grant could be exchanged for a new access token and refresh token. Whoever holds such an access token could keep access beyond the token's original lifetime.","affected":[{"package":{"name":"gitea","ecosystem":"Bitnami","purl":"pkg:bitnami/gitea"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"28.1.0"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/gitea/BIT-gitea-2026-101023.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N"}]}],"references":[{"type":"ARTICLE","url":"https://blog.gitea.com/release-of-28.1.0/"},{"type":"FIX","url":"https://github.com/go-gitea/gitea/pull/39501"},{"type":"FIX","url":"https://github.com/go-gitea/gitea/pull/39507"},{"type":"ARTICLE","url":"https://github.com/go-gitea/gitea/releases/tag/v28.1.0"},{"type":"ADVISORY","url":"https://github.com/go-gitea/gitea/security/advisories/GHSA-469m-x4mw-38r3"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-101023"}],"database_specific":{"cpes":["cpe:2.3:a:gitea:gitea:*:*:*:*:*:*:*:*"],"severity":"Critical"}}