{"schema_version":"1.9.0","id":"BIT-ghost-2026-105649","published":"2026-10-13T06:50:18.787Z","modified":"2026-10-13T08:25:41.799156137Z","aliases":["CVE-2026-105649","GHSA-8575-cr6v-7jh4"],"summary":"Ghost: Stored XSS via SVG Uploads Bypassing Sanitization","details":"Ghost is a Node.js content management system. From 4.22.0 until 6.65.0, SVG media thumbnails and SVG images uploaded with a non-SVG file extension were stored without sanitization. This allowed any staff user, including Contributors, to host scripts on the site's domain, possibly resulting in compromise of other staff users' admin sessions. This issue is fixed in version 6.65.0.","affected":[{"package":{"name":"ghost","ecosystem":"Bitnami","purl":"pkg:bitnami/ghost"},"ranges":[{"type":"SEMVER","events":[{"introduced":"4.22.0"},{"fixed":"6.65.0"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/ghost/BIT-ghost-2026-105649.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:H/I:H/A:N"}]}],"references":[{"type":"WEB","url":"https://github.com/TryGhost/Ghost/commit/80686226d23df56749f6b7ebb484850a8eba8072"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/issues/30919"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/releases/tag/v6.65.0"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/security/advisories/GHSA-8575-cr6v-7jh4"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-105649"}],"database_specific":{"cpes":["cpe:2.3:a:ghost:ghost:*:*:*:*:*:node.js:*:*"],"severity":"High"}}