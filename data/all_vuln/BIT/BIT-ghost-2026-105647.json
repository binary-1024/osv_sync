{"schema_version":"1.9.0","id":"BIT-ghost-2026-105647","published":"2026-10-13T06:50:15.731Z","modified":"2026-10-13T08:26:12.801076344Z","aliases":["CVE-2026-105647","GHSA-322m-ff4g-9vx9"],"summary":"Ghost: Server-Side Request Forgery in Bookmark Fetching","details":"Ghost is a Node.js content management system. From 6.54.1 until 6.65.0, a validation issue allowed some functionality, such as Webmentions, to be abused by an unauthenticated user to make limited HTTP requests to hosts in the Ghost server's internal network. A successful attack would not result in any response data being returned. This issue is fixed in version 6.65.0.","affected":[{"package":{"name":"ghost","ecosystem":"Bitnami","purl":"pkg:bitnami/ghost"},"ranges":[{"type":"SEMVER","events":[{"introduced":"6.54.1"},{"fixed":"6.65.0"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/ghost/BIT-ghost-2026-105647.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:C/C:L/I:N/A:N"}]}],"references":[{"type":"WEB","url":"https://github.com/TryGhost/Ghost/commit/3f8594eb53de883ac017545c358f59039cb152de"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/pull/30918"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/releases/tag/v6.65.0"},{"type":"WEB","url":"https://github.com/TryGhost/Ghost/security/advisories/GHSA-322m-ff4g-9vx9"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-105647"}],"database_specific":{"cpes":["cpe:2.3:a:ghost:ghost:*:*:*:*:*:node.js:*:*"],"severity":"Medium"}}