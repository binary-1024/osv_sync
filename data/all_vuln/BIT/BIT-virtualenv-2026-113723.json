{"schema_version":"1.9.2","id":"BIT-virtualenv-2026-113723","published":"2026-10-29T09:00:39.883Z","modified":"2026-10-29T10:55:32.039209236Z","aliases":["CVE-2026-113723","GHSA-6w3r-xr62-4xcp"],"summary":"virtualenv: Bash prompt values can change meaning under older compatibility modes","details":"virtualenv is a tool for creating isolated virtual python environments. Prior to 21.14.9, caller-supplied prompt text can become executable syntax in the bash activation prompt. An attacker must influence the value passed to virtualenv, and a user must subsequently activate the environment and draw the prompt. This vulnerability is fixed in 21.14.9.","affected":[{"package":{"name":"virtualenv","ecosystem":"Bitnami","purl":"pkg:bitnami/virtualenv"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"21.14.9"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/virtualenv/BIT-virtualenv-2026-113723.json"},"severity":[{"type":"CVSS_V4","score":"CVSS:4.0/AV:L/AC:H/AT:P/PR:N/UI:A/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X"}]}],"references":[{"type":"WEB","url":"https://github.com/pypa/virtualenv/commit/5f48d711731311428aebfae61d46957762155b22"},{"type":"WEB","url":"https://github.com/pypa/virtualenv/pull/3418"},{"type":"WEB","url":"https://github.com/pypa/virtualenv/releases/tag/21.14.9"},{"type":"WEB","url":"https://github.com/pypa/virtualenv/security/advisories/GHSA-6w3r-xr62-4xcp"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-113723"}],"database_specific":{"cpes":["cpe:2.3:a:virtualenv:virtualenv:*:*:*:*:*:*:*:*"],"severity":"High"}}