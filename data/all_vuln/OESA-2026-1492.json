{"schema_version":"1.7.3","id":"OESA-2026-1492","published":"2026-03-06T12:41:13Z","modified":"2026-03-06T13:15:10.085770Z","upstream":["CVE-2026-0964","CVE-2026-0967"],"summary":"libssh security update","details":"The ssh library was designed to be used by programmers needing a working SSH implementation by the mean of a library. The complete control of the client is made by the programmer. With libssh, you can remotely execute programs, transfer files, use a secure and transparent tunnel for your remote programs. With its Secure FTP implementation, you can play with remote files easily, without third-party programs others than libcrypto (from openssl).\r\n\r\nSecurity Fix(es):\n\n(CVE-2026-0964)\n\n(CVE-2026-0967)","affected":[{"package":{"name":"libssh","ecosystem":"openEuler:24.03-LTS","purl":"pkg:rpm/openEuler/libssh&distro=openEuler-24.03-LTS"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"0.10.5-9.oe2403"}]}],"ecosystem_specific":{"aarch64":["libssh-0.10.5-9.oe2403.aarch64.rpm","libssh-debuginfo-0.10.5-9.oe2403.aarch64.rpm","libssh-debugsource-0.10.5-9.oe2403.aarch64.rpm","libssh-devel-0.10.5-9.oe2403.aarch64.rpm"],"noarch":["libssh-help-0.10.5-9.oe2403.noarch.rpm"],"src":["libssh-0.10.5-9.oe2403.src.rpm"],"x86_64":["libssh-0.10.5-9.oe2403.x86_64.rpm","libssh-debuginfo-0.10.5-9.oe2403.x86_64.rpm","libssh-debugsource-0.10.5-9.oe2403.x86_64.rpm","libssh-devel-0.10.5-9.oe2403.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1492.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1492"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-0964"},{"type":"ADVISORY","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-0967"}],"database_specific":{"severity":"Medium"}}