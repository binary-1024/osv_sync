{"schema_version":"1.9.0","id":"OESA-2026-1152","published":"2026-01-16T11:10:11Z","modified":"2026-08-18T01:19:28.087085466Z","upstream":["CVE-2025-68615"],"summary":"net-snmp security update","details":"Net-SNMP is a suite of applications used to implement SNMP v1, SNMP v2c and SNMP v3 using both IPv4 and IPv6. The suite includes:\r\n\r\nSecurity Fix(es):\n\nnet-snmp is a SNMP application library, tools and daemon. Prior to versions 5.9.5 and 5.10.pre2, a specially crafted packet to an net-snmp snmptrapd daemon can cause a buffer overflow and the daemon to crash. This issue has been patched in versions 5.9.5 and 5.10.pre2.(CVE-2025-68615)","affected":[{"package":{"name":"net-snmp","ecosystem":"openEuler:24.03-LTS","purl":"pkg:rpm/openEuler/net-snmp&distro=openEuler-24.03-LTS"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.9.3-5.oe2403"}]}],"ecosystem_specific":{"aarch64":["net-snmp-5.9.3-5.oe2403.aarch64.rpm","net-snmp-debuginfo-5.9.3-5.oe2403.aarch64.rpm","net-snmp-debugsource-5.9.3-5.oe2403.aarch64.rpm","net-snmp-devel-5.9.3-5.oe2403.aarch64.rpm","net-snmp-gui-5.9.3-5.oe2403.aarch64.rpm","net-snmp-libs-5.9.3-5.oe2403.aarch64.rpm","net-snmp-perl-5.9.3-5.oe2403.aarch64.rpm","python3-net-snmp-5.9.3-5.oe2403.aarch64.rpm"],"noarch":["net-snmp-help-5.9.3-5.oe2403.noarch.rpm"],"src":["net-snmp-5.9.3-5.oe2403.src.rpm"],"x86_64":["net-snmp-5.9.3-5.oe2403.x86_64.rpm","net-snmp-debuginfo-5.9.3-5.oe2403.x86_64.rpm","net-snmp-debugsource-5.9.3-5.oe2403.x86_64.rpm","net-snmp-devel-5.9.3-5.oe2403.x86_64.rpm","net-snmp-gui-5.9.3-5.oe2403.x86_64.rpm","net-snmp-libs-5.9.3-5.oe2403.x86_64.rpm","net-snmp-perl-5.9.3-5.oe2403.x86_64.rpm","python3-net-snmp-5.9.3-5.oe2403.x86_64.rpm"]},"database_specific":{"source":"https://repo.openeuler.org/security/data/osv/OESA-2026-1152.json"}}],"references":[{"type":"ADVISORY","url":"https://www.openeuler.org/zh/security/security-bulletins/detail/?id=openEuler-SA-2026-1152"},{"type":"ADVISORY","url":"https://nvd.nist.gov/