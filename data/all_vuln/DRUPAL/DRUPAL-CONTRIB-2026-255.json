{"schema_version":"1.9.2","id":"DRUPAL-CONTRIB-2026-255","published":"2026-10-28T16:55:26Z","modified":"2026-10-28T18:15:02.388090824Z","aliases":["CVE-2026-118540"],"details":"This module enables you to sell goods and services to customers through a shopping cart and checkout form.\n\nWhen Drupal Commerce is used with the JSON:API module, it is possible for unpublished product variations to be accessible to users without permission.\n\nThis vulnerability is mitigated by only affecting sites with published products and unpublished product variations.","affected":[{"package":{"name":"drupal/commerce","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/commerce?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.41.0"}],"database_specific":{"constraint":"<2.41"}},{"type":"ECOSYSTEM","events":[{"introduced":"3.0.0"},{"fixed":"3.2.0"}],"database_specific":{"constraint":">=3.0.0 <3.2.0"}}],"database_specific":{"affected_versions":"<2.41 || >=3.0.0 <3.2.0","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/commerce/DRUPAL-CONTRIB-2026-255.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-255"}],"credits":[{"name":"Matt Glaman (mglaman)","contact":["https://www.drupal.org/u/mglaman"]}]}