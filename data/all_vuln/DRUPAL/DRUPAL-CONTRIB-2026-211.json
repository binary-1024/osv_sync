{"schema_version":"1.9.0","id":"DRUPAL-CONTRIB-2026-211","published":"2026-10-07T16:36:17Z","modified":"2026-10-07T20:15:06.632630385Z","aliases":["CVE-2026-107308"],"details":"The module Country provides a dedicated field type for Drupal core's official country list.\n\nThe module does not sufficiently escape user input in its autocomplete widget, which can lead to a cross site scripting vulnerability.\n\nThis vulnerability is mitigated by the fact that it can not occur out of the box with the Country module, additional module(s) or custom code is required.","affected":[{"package":{"name":"drupal/country","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/country?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.1.3"}],"database_specific":{"constraint":"<2.1.3"}},{"type":"ECOSYSTEM","events":[{"introduced":"2.2.0"},{"fixed":"2.2.1"}],"database_specific":{"constraint":">=2.2.0 <2.2.1"}}],"database_specific":{"affected_versions":"<2.1.3 || >=2.2.0 <2.2.1","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/country/DRUPAL-CONTRIB-2026-211.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-211"}],"credits":[{"name":"Conrad Lara (cmlara)","contact":["https://www.drupal.org/u/cmlara"]}]}