{"schema_version":"1.9.2","id":"DRUPAL-CONTRIB-2026-262","published":"2026-10-28T16:56:34Z","modified":"2026-10-28T18:15:04.726922409Z","aliases":["CVE-2026-118557"],"details":"This module enables you to sell tangible products via Drupal Commerce that are organized into shipments for fulfillment.\n\nThe module doesn't sufficiently check access on the form to resend receipts. Under certain configurations, this allows some users to gain access to receipts and customer information for orders they should not be able to access.","affected":[{"package":{"name":"drupal/commerce_shipping","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/commerce_shipping?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"2.16.0"}],"database_specific":{"constraint":"<2.16.0"}},{"type":"ECOSYSTEM","events":[{"introduced":"3.0.0"},{"fixed":"3.0.6"}],"database_specific":{"constraint":">=3.0.0 <3.0.6"}}],"database_specific":{"affected_versions":"<2.16.0 || >=3.0.0 <3.0.6","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/commerce_shipping/DRUPAL-CONTRIB-2026-262.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-262"}],"credits":[{"name":"Jakub Piasecki (zaporylie)","contact":["https://www.drupal.org/u/zaporylie"]}]}