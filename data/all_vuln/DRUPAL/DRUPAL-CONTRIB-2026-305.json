{"schema_version":"1.9.2","id":"DRUPAL-CONTRIB-2026-305","published":"2026-11-04T17:34:48Z","modified":"2026-11-04T20:30:03.886552417Z","aliases":["CVE-2026-122074"],"details":"This module enables you to reset passwords via one time passcode to email or SMS rather than reset password links.\n\nThe module doesn't sufficiently validate resetting passwords for blocked users.\n\nThis vulnerability is mitigated by the fact that someone with appropriate permissions must unblock the affected user for the attacker to use the new password.","affected":[{"package":{"name":"drupal/reset_password_email_otp","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/reset_password_email_otp?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"1.0.5"}],"database_specific":{"constraint":"<1.0.5"}}],"database_specific":{"affected_versions":"<1.0.5","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/reset_password_email_otp/DRUPAL-CONTRIB-2026-305.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-305"}],"credits":[{"name":"Scott Euser (scott_euser)","contact":["https://www.drupal.org/u/scott_euser"]}]}