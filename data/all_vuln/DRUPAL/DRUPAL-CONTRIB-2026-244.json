{"schema_version":"1.9.0","id":"DRUPAL-CONTRIB-2026-244","published":"2026-10-21T18:01:26Z","modified":"2026-10-21T18:45:02.707999254Z","aliases":["CVE-2026-114545"],"details":"This module provides a View plugin that integrates a calendar view format powered by FullCalendar JavaScript library.\n\nThis module has an access bypass vulnerability which allows to update entity fields without checking field-level access.\n\nThe vulnerability is mitigated by the fact that an attacker must have access to update the entity itself.","affected":[{"package":{"name":"drupal/fullcalendar_view","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/fullcalendar_view?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"5.2.6"}],"database_specific":{"constraint":"<5.2.6"}}],"database_specific":{"affected_versions":"<5.2.6","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/fullcalendar_view/DRUPAL-CONTRIB-2026-244.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-244"}],"credits":[{"name":"Maksim Hayder (tr_jan)","contact":["https://www.drupal.org/u/tr_jan"]}]}