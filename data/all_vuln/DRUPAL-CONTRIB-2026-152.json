{"schema_version":"1.9.0","id":"DRUPAL-CONTRIB-2026-152","published":"2026-09-09T17:24:26Z","modified":"2026-09-09T19:15:02.980507467Z","aliases":["CVE-2026-87954"],"details":"This module adds automatic highlighting of taxonomy terms in content.\n\nThe module doesn't sufficiently check access on taxonomy terms. As a result, anonymous users can view any of the site's taxonomy terms at the module's JSON endpoint, including taxonomy terms that are unpublished or otherwise restricted.","affected":[{"package":{"name":"drupal/term_glossary","ecosystem":"Packagist:https://packages.drupal.org/8","purl":"pkg:composer/drupal/term_glossary?repository_url=https:%2F%2Fpackages.drupal.org%2F8"},"ranges":[{"type":"ECOSYSTEM","events":[{"introduced":"0"},{"fixed":"4.6.0"}],"database_specific":{"constraint":"<4.6.0"}}],"database_specific":{"affected_versions":"<4.6.0","source":"https://github.com/DrupalSecurityTeam/drupal-advisory-database/blob/main/advisories/term_glossary/DRUPAL-CONTRIB-2026-152.json"}}],"references":[{"type":"WEB","url":"https://www.drupal.org/sa-contrib-2026-152"}],"credits":[{"name":"Hemant Gupta (guptahemant)","contact":["https://www.drupal.org/u/guptahemant"]},{"name":"Marcus Johansson (marcus_johansson)","contact":["https://www.drupal.org/u/marcus_johansson"]},{"name":"Serhii Checheniev (serhii-che)","contact":["https://www.drupal.org/u/serhii-che"]}]}