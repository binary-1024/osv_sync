{"schema_version":"1.7.5","id":"BIT-cilium-2026-49445","published":"2026-07-19T23:37:48.426Z","modified":"2026-07-20T08:41:18.912957805Z","aliases":["BIT-cilium-operator-2026-49445","BIT-hubble-relay-2026-49445","CVE-2026-49445","GHSA-3fcv-jvfp-m4q9","GO-2026-5905"],"summary":"Cilium: Sensitive information disclosure and cluster disruption via local Envoy admin socket access","details":"Cilium is a networking, observability, and security solution. Prior to 1.17.14, 1.18.8, and 1.19.2, when Cilium L7 functionality is enabled, the embedded or standalone Envoy instance creates a world-accessible admin.sock on cluster nodes, allowing a local attacker to access Envoy admin endpoints, expose TLS secrets, disrupt cluster traffic, or terminate Envoy. This issue is fixed in versions 1.17.14, 1.18.8, and 1.19.2.","affected":[{"package":{"name":"cilium","ecosystem":"Bitnami","purl":"pkg:bitnami/cilium"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"1.17.14"},{"introduced":"1.18.0"},{"fixed":"1.18.8"},{"introduced":"1.19.0"},{"fixed":"1.19.2"}]}],"database_specific":{"source":"https://github.com/bitnami/vulndb/tree/main/data/cilium/BIT-cilium-2026-49445.json"},"severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H"}]}],"references":[{"type":"WEB","url":"https://github.com/cilium/cilium/commit/7bfbdd5c1be83d6c9ba3e089b4c804b6603505b6"},{"type":"WEB","url":"https://github.com/cilium/cilium/pull/44512"},{"type":"WEB","url":"https://github.com/cilium/cilium/releases/tag/v1.17.14"},{"type":"WEB","url":"https://github.com/cilium/cilium/releases/tag/v1.18.8"},{"type":"WEB","url":"https://github.com/cilium/cilium/releases/tag/v1.19.2"},{"type":"WEB","url":"https://github.com/cilium/cilium/security/advisories/GHSA-3fcv-jvfp-m4q9"},{"type":"WEB","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-49445"}],"database_specific":{"cpes":["cpe:2.3:a:cilium:cilium:*:*:*:*:*:*:*:*"],"severity":"High"}}